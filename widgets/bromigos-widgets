def client(argv):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.sendto(" ".join(argv).encode(), SOCK)
    except OSError:
        if argv[0] not in ("show", "notes", "edit", "add") or not start_daemon():
            sys.exit("bromigos-widgets is not running")
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.sendto(" ".join(argv).encode(), SOCK)


def start_daemon(wait=10.0):
    """Start the panels (as login does) for a verb that opens something (show, notes: the
    app launcher's entries), and wait for their socket. False when they didn't come up."""
    import subprocess
    subprocess.Popen([sys.executable, os.path.realpath(__file__)], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    end = time.monotonic() + wait
    while time.monotonic() < end:
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        try:
            probe.sendto(b"", SOCK)          # an empty datagram: the daemon ignores it
            return True
        except OSError:
            time.sleep(0.2)
        finally:
            probe.close()
    return False


