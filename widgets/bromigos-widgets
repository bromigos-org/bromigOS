# ------------------------------------------------------------------ Hyprland: which monitor, is it covered?
def _live_sig():
    """The Hyprland instance that answers. $HYPRLAND_INSTANCE_SIGNATURE goes stale when the
    widgets outlive a Hyprland restart (or start from a shell that did); then fall back to
    the newest instance whose socket accepts a connection, and remember it."""
    base = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr")

    def alive(sig):
        if not sig:
            return False
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(0.5)
        try:
            s.connect(os.path.join(base, sig, ".socket.sock"))
            return True
        except OSError:
            return False
        finally:
            s.close()
    cur = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if alive(cur):
        return cur
    try:
        for d in sorted(os.listdir(base), key=lambda n: os.path.getmtime(os.path.join(base, n)), reverse=True):
            if alive(d):
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = d
                return d
    except OSError:
        pass
    return None


def hypr_request(cmd):
    sig = _live_sig()
    if not sig:
        return None
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr", sig, ".socket.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1)
            s.connect(path)
            s.sendall(cmd.encode())
            buf = b""
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        return json.loads(buf or b"null")
    except (OSError, ValueError):
        return None


class Coverage(threading.Thread):
    """Listens to Hyprland's event socket and tracks whether the desktop on our
    monitor is covered by tiled/fullscreen windows."""

    def __init__(self, monitor, on_change):
        super().__init__(daemon=True)
        self.monitor = monitor
        self.on_change = on_change
        self.covered = False
        self.check()

    def check(self):
        mons = hypr_request("j/monitors") or []
        mon = next((m for m in mons if m["name"] == self.monitor), {})
        shown = {mon.get("activeWorkspace", {}).get("id"), (mon.get("specialWorkspace") or {}).get("id") or None}
        shown.discard(None)
        clients = hypr_request("j/clients") or []
        cov = any(c["workspace"]["id"] in shown and (not c["floating"] or c.get("fullscreen"))
                  and c.get("mapped", True) and not c.get("hidden") for c in clients)
        if cov != self.covered:
            self.covered = cov
            GLib.idle_add(self.on_change)

    def run(self):
        sig = _live_sig()
        if not sig:
            return
        path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr", sig, ".socket2.sock")
        watch = (b"workspace", b"openwindow", b"closewindow", b"movewindow", b"changefloatingmode",
                 b"fullscreen", b"focusedmon", b"activespecial")
        while True:
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                    s.connect(path)
                    f = s.makefile("rb")
                    for line in f:
                        if line.split(b">>")[0] in watch:
                            self.check()
            except OSError:
                time.sleep(5)


def resolve_monitor(name):
    """The output the panels go on: lib/bromigos_monitors.primary (the layout's "monitor"
    when that output is there, else setup's primary, the focused, the first)."""
    mons = hypr_request("j/monitors") or []
    try:
        import bromigos_monitors
        return bromigos_monitors.primary(mons, name)
    except ImportError:                        # an older bromigos-core: the first output
        if name and any(m.get("name") == name for m in mons):
            return name
        return (min(mons, key=lambda m: m.get("id", 0)).get("name") if mons else None) or name


def gdk_monitor(name):
    """Map a Hyprland output name to the Gdk.Monitor with the same geometry."""
    mons = hypr_request("j/monitors") or []
    m = next((m for m in mons if m["name"] == name), None)
    disp = Gdk.Display.get_default()
    if m:
        for i in range(disp.get_n_monitors()):
            g = disp.get_monitor(i).get_geometry()
            if g.x == m["x"] and g.y == m["y"]:
                return disp.get_monitor(i)
    return disp.get_primary_monitor() or disp.get_monitor(0)


