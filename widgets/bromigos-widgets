def layer_window(monitor, x, y, w, h, keyboard=False):
    win = Gtk.Window()
    win.get_style_context().add_class("bromigos")
    win.set_app_paintable(True)
    vis = win.get_screen().get_rgba_visual()
    if vis:
        win.set_visual(vis)
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_namespace(win, "bromigos-widgets")
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.BOTTOM)
    GtkLayerShell.set_monitor(win, monitor)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.TOP, True)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.LEFT, True)
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.TOP, y)
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.LEFT, x)
    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.ON_DEMAND if keyboard
                                    else GtkLayerShell.KeyboardMode.NONE)
    win.set_size_request(w, h)
    return win


class Surface:
    """What edit mode needs of a panel's window: where it is, moving and sizing it, the
    layer it's on. monitor: the output it shows on; pin: its own monitor (layout.json's
    "output"), None for one that goes on the primary; fell: (output, x, y) while it shows
    on another output because its own isn't connected, home: its saved (x, y) then; was:
    for one that goes on the primary, the identity of the primary it stood on then (a
    monitor switched off), so it goes back to `home` when that's the primary again."""
    x = y = 0
    monitor = ""
    pin = fell = home = was = None

    def rect(self):
        w, h = self.size_now()
        return (self.x, self.y, w, h)

    def rect_state(self):
        x, y, w, h = self.rect()
        return {"x": x, "y": y, "width": w, "height": h}

    def place(self, x, y):
        self.x, self.y = int(x), int(y)
        self.pos = (self.x, self.y)
        GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.LEFT, self.x)
        GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.TOP, self.y)

    def limits(self):
        cs = self.classes()
        return ((min(c[1][0] for c in cs), min(c[1][1] for c in cs)),
                (max(c[2][0] for c in cs), max(c[2][1] for c in cs)))

    def size_class(self):
        return A.fit_class(self.classes(), *self.size_now())[2]

    def set_size_class(self, name):
        """To a size class (the gallery's size picker, Add to desktop): its start width, and
        the height its content needs there when it fits its content (else its start height)."""
        start = next((c[3] for c in self.classes() if c[0] == name), None)
        if start:
            panel = getattr(self, "panel", None)
            h = P.fit_height(panel, start[0], name) if panel is not None else None
            self.resize(start[0], h or start[1])

    def set_layer(self, top):
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.TOP if top else GtkLayerShell.Layer.BOTTOM)


class PanelWindow(Surface):
    def __init__(self, app, panel, monitor, x, y, name=None, fit=None):
        self.app, self.panel = app, panel
        self.name = name or getattr(panel, "name", "panel")
        self.x, self.y = int(x), int(y)
        # the room it was given (layout.json's size: what edit mode moves and the layouts
        # place), and whether its frame follows its content inside it (fit_content)
        self.box = (int(panel.width), int(panel.height))
        self.fit = fit if fit in ("content", "fixed") else getattr(getattr(panel, "inner", panel), "fit", None)
        self.fitted_at = 0.0
        self.win = layer_window(monitor, x, y, panel.width, panel.height)
        self.area = Gtk.DrawingArea()
        self.area.set_size_request(panel.width, panel.height)
        self.area.set_has_tooltip(True)
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK
                             | Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.area.connect("scroll-event", self.on_scroll)
        self.area.connect("draw", self.on_draw)
        self.area.connect("query-tooltip", self.on_tip)
        self.area.connect("button-press-event", self.on_click)
        self.area.connect("button-release-event", self.on_release)
        self.area.connect("motion-notify-event", self.on_motion)
        self.win.add(self.area)
        self._hand = None
        self.last_tick = 0

    def on_draw(self, _w, cr):
        self.draws = getattr(self, "draws", 0) + 1
        self.panel.render(cr, self.box[0], self.shown_height())
        return True

    def on_tip(self, _w, x, y, _kb, tooltip):
        r = self.panel.hit(x, y)
        if not r:
            return False
        tooltip.set_text(r[4] + ("" if r[5] or "Click" in r[4] else ""))
        return True

    def size_now(self):
        return self.box

    def classes(self):
        return G.classes_of(self.panel)

    def resize(self, w, h):
        """Its room: the frame takes all of it (fit_content may shrink it again later)."""
        self.box = (int(w), int(h))
        self.fitted_at = 0.0
        self.show_height(int(h))

    def show_height(self, h):
        """The frame's height on the desktop, inside its room (the top left stays put)."""
        w, h = self.box[0], min(int(h), self.box[1])
        inner = getattr(self.panel, "inner", self.panel)       # a plugin's SafePanel
        inner.width, inner.height = w, h
        self.area.set_size_request(w, h)
        self.win.set_size_request(w, h)
        self.win.resize(w, h)
        self.redraw()

    def shown_height(self):
        return int(getattr(self.panel, "inner", self.panel).height)

    def content_target(self):
        """The frame height its content needs now, inside its room and its size class's
        heights; None when it doesn't fit its content."""
        if self.fit != "content":
            return None
        w, h = self.box
        name = A.fit_class(self.classes(), w, h)[2]
        c = next((c for c in self.classes() if c[0] == name), None)
        if c is None:
            return None
        try:
            nat = getattr(self.panel, "inner", self.panel).natural_height(w, name)
        except Exception:                      # noqa: BLE001  a plugin's sum failing: its whole room
            nat = None
        if not nat:
            return h
        target = int(max(c[1][1], min(h, nat)))
        inner = getattr(self.panel, "inner", self.panel)
        if hasattr(inner, "frame_height"):
            target = int(max(c[1][1], inner.frame_height(w, name, target)))
        return target

    def on_click(self, _w, ev):
        if ev.button == 3:                     # a right-click: edit mode, this panel picked
            self.app.edit("on", self.name)
            return True
        if getattr(self.panel,"pointer_press",lambda *_: False)(ev.x,ev.y,ev.button):
            return True
        r = self.panel.hit(ev.x, ev.y)
        if r and r[5]:
            r[5]()
        return True

    def on_scroll(self, _w, ev):
        if not hasattr(self.panel, "scroll"):
            return False
        ok, dx, dy = ev.get_scroll_deltas()
        if not ok:
            dy = {Gdk.ScrollDirection.UP: -1, Gdk.ScrollDirection.DOWN: 1}.get(ev.direction, 0)
        if dy:
            handled = getattr(self.panel,"scroll_at",lambda *_: False)(ev.x,ev.y,dy)
            if not handled: self.panel.scroll(dy)
            self.redraw()
        return True

    def on_release(self, _w, ev):
        if getattr(self.panel,"pointer_release",lambda: False)():
            self.redraw(); return True
        return False

    def on_motion(self, _w, ev):
        if getattr(self.panel,"pointer_motion",lambda *_: False)(ev.x,ev.y):
            self.redraw(); return True
        r = self.panel.hit(ev.x, ev.y)
        want = bool(r and r[5])
        if want != self._hand:
            self._hand = want
            disp = self.win.get_display()
            self.win.get_window().set_cursor(Gdk.Cursor.new_from_name(disp, "pointer") if want else None)
        return False

    def visible(self):
        return self.win.get_visible()

    def redraw(self):
        self.area.queue_draw()


class NotesWindow(Surface):
    """FIELD NOTES: a plain-text pad that autosaves to ~/.local/share/bromigos/notes.md."""
    name = "notes"

    def __init__(self, app, monitor, x, y, w, h):
        self.app = app
        self.w, self.h = w, h
        self.x, self.y = int(x), int(y)
        self.win = layer_window(monitor, x, y, w, h, keyboard=True)
        overlay = Gtk.Overlay()
        self.header = Gtk.DrawingArea()
        self.header.set_size_request(w, h)
        self.header.connect("draw", self.on_draw)
        self.header.set_has_tooltip(True)
        self.header.connect("query-tooltip", self.on_tip)
        self.header.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.header.connect("button-press-event", self.on_click)
        overlay.add(self.header)
        self.view = Gtk.TextView()
        self.view.get_style_context().add_class("notes")
        self.view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.view.set_left_margin(4)
        self.view.set_right_margin(4)
        sc = Gtk.ScrolledWindow()
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.add(self.view)
        sc.set_margin_top(44)
        sc.set_margin_bottom(16)
        sc.set_margin_start(14)
        sc.set_margin_end(14)
        overlay.add_overlay(sc)
        self.win.add(overlay)
        self.buf = self.view.get_buffer()
        self.saved_at = None
        self._save_id = None
        self._mtime = 0
        self.load()
        self.buf.connect("changed", self.on_changed)
        self.view.connect("key-press-event", self.on_key)
        self.view.connect("focus-out-event", lambda *a: self.release())
        GLib.timeout_add_seconds(5, self.watch_file)

    fit = None

    def size_now(self):
        return (int(self.w), int(self.h))

    def classes(self):
        return G.classes_of(None)

    def content_target(self):
        return None

    def resize(self, w, h):
        self.w, self.h = int(w), int(h)
        self.header.set_size_request(self.w, self.h)
        self.win.set_size_request(self.w, self.h)
        self.win.resize(self.w, self.h)
        self.header.queue_draw()

    def lines(self, limit=12):
        s, e = self.buf.get_bounds()
        return self.buf.get_text(s, e, True).splitlines()[-limit:]

    def on_click(self, _w, ev):
        if ev.button == 3:                     # a right-click on its frame: edit mode
            self.app.edit("on", self.name)
            return True
        return False

    def load(self):
        try:
            with open(NOTES) as f:
                txt = f.read()
            self._mtime = os.path.getmtime(NOTES)
        except OSError:
            txt = ""
        self._loading = True
        self.buf.set_text(txt)
        self._loading = False

    def watch_file(self):
        """Pick up appends from the rofi quick-note prompt."""
        try:
            m = os.path.getmtime(NOTES)
        except OSError:
            return True
        if m > self._mtime + 0.01 and self._save_id is None and not self.view.has_focus():
            self.load()
            self.saved_at = time.time()
            self.header.queue_draw()
        return True

    def on_changed(self, _b):
        if getattr(self, "_loading", False):
            return
        if self._save_id:
            GLib.source_remove(self._save_id)
        self._save_id = GLib.timeout_add(800, self.save)
        self.header.queue_draw()

    def save(self):
        self._save_id = None
        os.makedirs(os.path.dirname(NOTES), exist_ok=True)
        s, e = self.buf.get_bounds()
        tmp = NOTES + ".tmp"
        with open(tmp, "w") as f:
            f.write(self.buf.get_text(s, e, True))
        os.replace(tmp, NOTES)
        self._mtime = os.path.getmtime(NOTES)
        self.saved_at = time.time()
        self.header.queue_draw()
        return False

    def focus(self):
        self.win.show_all()
        GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        self.win.present()
        self.view.grab_focus()
        self.buf.place_cursor(self.buf.get_end_iter())
        self.view.scroll_to_mark(self.buf.get_insert(), 0, False, 0, 0)

    def release(self):
        GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.ON_DEMAND)
        return False

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            if self._save_id:
                GLib.source_remove(self._save_id)
                self.save()
            GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.NONE)
            GLib.timeout_add(150, self.release)
            return True
        return False

    def on_tip(self, _w, x, y, _kb, tooltip):
        if y > 34:
            return False
        tooltip.set_text(f"Field notes: plain text saved to {NOTES} as you type. "
                         "Alt+N focuses it, Esc hands focus back; Alt+Shift+N appends a quick note from anywhere. "
                         "Right-click here to arrange the panels (edit mode).")
        return True

    def on_draw(self, _w, cr):
        import cairo
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if self._save_id:
            right, col = "EDITING", "amber"
        elif self.saved_at:
            right, col = "SAVED " + time.strftime("%H:%M", time.localtime(self.saved_at)), "static"
        else:
            s, e = self.buf.get_bounds()
            n = len(self.buf.get_text(s, e, True).splitlines())
            right, col = f"{n} LINES", "static"
        D.frame(cr, self.w, self.h, "FIELD NOTES", right, col)
        return False

    def visible(self):
        return self.win.get_visible()

    def redraw(self):
        self.header.queue_draw()


# ------------------------------------------------------------------ app
class App:
    def __init__(self):
        self.known = {}              # every output seen: name -> identity (for one that's gone)
        self.lost_primary = None     # the identity of a primary that went away (switched off)
        self.refresh()
        self.cfg = self.read_layout()
        self.monitor_setting = self.cfg.get("monitor", "")       # the layout's, as written
        self.primary = resolve_monitor(self.monitor_setting, self.mons)
        self.css = Gtk.CssProvider()
        self.css.load_from_data(theme_css())
        self.theme_seen = D.T.version()
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.editor = None
        self.windows = {}
        self.lost = set()
        core = P.CORE
        for spec in self.cfg["panels"]:
            name = spec["name"]
            conn = self.target(spec.get("output"))
            mon = gdk_monitor(conn, self.mons)
            if name == "notes":
                win = NotesWindow(self, mon, spec["x"], spec["y"], spec.get("width", 470), spec.get("height", 420))
            elif name not in core:
                continue        # a plugin's (LAB comes with bromigos-homelab): scan_plugins places it here
            else:
                panel = core[name](spec)
                panel.width = spec.get("width", panel.width)
                panel.height = spec.get("height", panel.height)
                win = PanelWindow(self, panel, mon, spec["x"], spec["y"], name, spec.get("fit"))
            win.monitor, win.pin = conn, spec.get("output") or None
            self.windows[name] = win
            if spec.get("visible", True):
                win.win.show_all()
        self.plugins = {}            # name -> (path, mtime)
        self.started = time.time()
        self.coverage = Coverage(self.on_coverage, self.reattach_soon)
        self.scan_plugins()
        self.fall_back()
        GLib.timeout_add_seconds(2, self.scan_plugins)
        GLib.timeout_add_seconds(2, self.write_health)
        self.naturals, self.naturals_at = {}, 0.0
        GLib.timeout_add_seconds(5, self.fit_content)
        self.coverage.start()
        # Hotplug: when an output goes away (monitor powered off, unplugged), gtk-layer-shell
        # turns the compositor's 'closed' into a window close. Keep the windows, remember
        # which were shown, and map them again: on the primary while their own monitor is
        # gone, and back on it when it returns.
        for name, w in self.windows.items():
            w.win.connect("delete-event", self.on_surface_closed, name)
        disp = Gdk.Display.get_default()
        disp.connect("monitor-added", lambda *_: self.reattach_soon())
        disp.connect("monitor-removed", lambda *_: (self.lost.update(n for n, w in self.windows.items()
                                                                      if w.visible()), self.reattach_soon()))
        GLib.timeout_add_seconds(30, self.check_surfaces)
        self.listen()
        GLib.timeout_add(int(os.environ.get("BROMIGOS_TICK_MS", "100")), self.loop)
        GLib.idle_add(self.first_run)

    def first_run(self):
        """Which scene the layout is arranged for, written down the first time (a theme switch
        remembers it for that scene); and, with no layout of the user's yet, the layouts
        offered once (Customize › Widgets has them)."""
        try:
            import layouts as L
            if not L.record().get("scene"):
                L.set_record(scene=L.scene_info()["scene"])
            flag = os.path.join(os.path.dirname(L.record_path()), "layouts-offered")
            if not os.path.exists(A.user_path()) and not os.path.exists(flag) and not os.environ.get("BROMIGOS_WIDGETS_DEMO"):
                open(flag, "w").close()
                self.say("Pick a layout for your widgets: Customize › Widgets › Layouts, or bromigos panels layouts. "
                         "Minimal, Developer, Homelab and more, fitted to your screen and your theme.")
        except Exception as e:                    # noqa: BLE001  never in the way of the panels
            print(f"bromigos-widgets: layouts: {e}", file=sys.stderr, flush=True)
        return False

    # ------------------------------------------------------------------ monitors
    def refresh(self):
        """Hyprland's outputs again, each one's identity remembered for when it's gone."""
        self.mons = monitors()
        for m in self.mons:
            self.known[m["name"]] = A.identity(m)
        return self.mons

    @property
    def monitor_name(self):
        """The panels' primary output (the health file's "monitor")."""
        return self.primary

    def target(self, pin):
        """The output a panel goes on: its own monitor when that's connected, else the
        primary."""
        return (A.find_output(self.mons, pin) if pin else None) or self.primary

    def gdk(self, conn):
        """The Gdk.Monitor of an output, or None while GTK hasn't heard of it."""
        return gdk_monitor(conn, self.mons, strict=True)

    def monitor(self, name):
        """Hyprland's entry for an output, or None."""
        return next((m for m in self.mons if m["name"] == name), None)

    def on(self, conn):
        """The panels' windows on an output."""
        return {n: w for n, w in self.windows.items() if w.monitor == conn}

    def shown(self, name):
        w = self.windows.get(name)
        saved = getattr(self, "game_visible", None)
        if saved is not None and name in saved:
            return saved[name]
        return bool(w and (w.visible() or name in self.lost))

    def put(self, w, conn, x=None, y=None):
        """A panel's window onto another output (mapped again there when it was shown).
        False when GTK doesn't know that output yet."""
        mon = gdk_monitor(conn, self.mons, strict=True)
        if mon is None:
            return False
        shown = self.shown(w.name)
        if x is not None:
            w.place(x, y)
        if conn != w.monitor or w.name in self.lost:
            w.win.hide()
            GtkLayerShell.set_monitor(w.win, mon)
            w.monitor = conn
            if shown:
                w.win.show_all()
                w.redraw()
        self.lost.discard(w.name)
        return True

    def pick_primary(self):
        """The primary again, after a hotplug (arrange.next_primary): another when it went
        away, and the same monitor again when that comes back (or the one the layout or
        `bromigos setup monitors` asks for, when that's there). Returns whether it changed."""
        best = resolve_monitor(self.monitor_setting, self.mons)
        old = self.primary
        self.primary, self.lost_primary = A.next_primary(
            self.mons, old, self.lost_primary, (self.monitor_setting, setup_primary()), best, self.known.get(old))
        if self.primary != old:
            print(f"bromigos-widgets: primary {old} -> {self.primary}", file=sys.stderr, flush=True)
            return True
        return False

    def fall_back(self):
        """Each panel onto its own monitor when that's connected, else onto the primary:
        at its own place when that's free there, else in a free spot; its saved place is
        kept (arrange.kept_place) for when its monitor comes back. A panel that goes on
        the primary follows it; when the primary went away (switched off) it keeps its
        place there too, and goes back to it when that monitor is the primary again
        (arrange.on_new_primary). Returns the names moved."""
        moved = set()
        for n, w in self.windows.items():
            own = A.find_output(self.mons, w.pin) if w.pin else None
            if w.fell and (w.monitor, w.x, w.y) != tuple(w.fell):
                # moved by hand while it stood in: it lives there now (on the primary still,
                # or pinned to the monitor it was moved on)
                w.fell = w.home = w.was = None
                if w.pin:
                    w.pin = own = self.identity(w.monitor)
            if own:
                if w.fell:                        # its monitor is back: its own place again
                    hx, hy = w.home
                    if self.put(w, own, hx, hy):
                        w.fell = w.home = None
                        moved.add(n)
                elif own != w.monitor and self.put(w, own):
                    moved.add(n)
                continue
            if w.pin and not w.fell:              # its monitor just went
                area = self.area(self.primary)
                taken = [x.rect() for k, x in self.on(self.primary).items() if k != n and self.shown(k)]
                spot = A.fallback_spot(w.rect(), taken, area, self.avoid(area))
                home = (w.x, w.y)
                if self.put(w, self.primary, *spot):
                    w.fell, w.home = (self.primary, w.x, w.y), home
                    moved.add(n)
            elif w.monitor != self.primary:       # the primary changed
                home, was = w.home, w.was
                if w.pin is None and not w.fell and self.monitor(w.monitor) is None:
                    # the primary it was on went away: its place there is kept for its return
                    home, was = (w.x, w.y), self.known.get(w.monitor) or {"name": w.monitor}
                back = bool(was) and A.find_output(self.mons, was) == self.primary
                spot = A.on_new_primary(w.rect(), self.area(self.primary), home if w.pin is None else None, back)
                if self.put(w, self.primary, *spot):
                    if back:
                        w.fell = w.home = w.was = None
                    elif w.fell or was:
                        w.fell, w.home, w.was = (self.primary, w.x, w.y), home, was
                    moved.add(n)
        if moved:
            print(f"bromigos-widgets: placed {', '.join(sorted(moved))} by their monitors", file=sys.stderr, flush=True)
            if self.editor:
                self.editor.monitors_changed()
        return moved

    def identity(self, conn):
        m = self.monitor(conn)
        return A.identity(m) if m else {"name": conn}

    # ------------------------------------------------------------------ plugins
    PLACES = os.path.expanduser("~/.local/state/bromigos/widgets-plugin-places.json")

    def _place(self, name, spec, conn):
        """Position for a plugin: layout.json "plugins" > its LAYOUT > a remembered spot > free space
        (on `conn`, the output it goes on). Free space is clear of the panels shown there (a
        hidden one takes no room) and of the scene's focal points. A hidden plugin without a
        place gets one when it's switched on. None: no room anywhere; it stays off rather than
        go on top of another (it used to fall back to the top left, and remember that, which
        stacked every new widget on SYSTEM)."""
        if "x" in spec and "y" in spec:
            return spec["x"], spec["y"]
        if not spec.get("visible", True):
            return MARGIN_SPOT                    # off: placed when it's switched on
        try:
            with open(self.PLACES) as f:
                places = json.load(f)
        except (OSError, ValueError):
            places = {}
        w, h = spec.get("width", 470), spec.get("height", 200)
        taken = self.shown_rects(conn, name)
        area = self.area(conn)
        avoid, soft = self.keep_clear(conn, area)
        old = places.get(name)
        if old and A.fits((old[0], old[1], w, h), taken, area, A.GAP) and \
                not any(A.overlaps((old[0], old[1], w, h), r) for r in avoid):
            return old[0], old[1]
        spot = A.place(w, h, taken, area, avoid, soft, strict=True, hard=self.hard_areas(conn))
        if spot is None:
            return None
        places[name] = list(spot)
        os.makedirs(os.path.dirname(self.PLACES), exist_ok=True)
        with open(self.PLACES, "w") as f:
            json.dump(places, f)
        return spot

    def shown_rects(self, conn, but=None):
        """The rects of the panels shown on an output, and of those layout.json shows there that
        aren't loaded yet (a plugin later in the scan)."""
        out = [w.rect() for n, w in self.windows.items() if n != but and w.monitor == conn and self.shown(n)]
        for p in list(self.cfg.get("panels") or []) + [dict(v, name=k) for k, v in (self.cfg.get("plugins") or {}).items()
                                                     if isinstance(v, dict)]:
            n = p.get("name")
            if n and n != but and n not in self.windows and p.get("visible", True) and "x" in p and "y" in p \
                    and self.target(p.get("output")) == conn:
                out.append((p["x"], p["y"], p.get("width", 470), p.get("height", 300)))
        return out

    def keep_clear(self, conn, area=None):
        """Where a panel being added shouldn't go on an output: VECTOR's console, the
        notifications and the scene's focal points (layouts.scene_avoid); and the scene's soft
        areas, kept clear while there's room elsewhere."""
        area = area or self.area(conn)
        hard, soft = [], []
        m = self.monitor(conn)
        if m:
            try:
                import layouts as L
                hard, soft = L.scene_avoid(L.Screen.of(m))
            except Exception as e:                # noqa: BLE001  never in the way of adding one
                print(f"bromigos-widgets: the scene's keep-clear areas: {e}", file=sys.stderr, flush=True)
        return self.avoid(area) + hard, soft

    def hard_areas(self, conn, area=None):
        """The scene's hard keep-clear areas on an output: never a place for a panel."""
        m = self.monitor(conn)
        if not m:
            return []
        try:
            import layouts as L
            return L.scene_avoid(L.Screen.of(m))[0]
        except Exception:                        # noqa: BLE001
            return []

    def say(self, text):
        """A message the user sees (a notification), and the log."""
        print(f"bromigos-widgets: {text}", file=sys.stderr, flush=True)
        self.launch(["notify-send", "-a", "Desktop panels", "-i", "preferences-desktop", "Desktop panels", text])

    def _close_plugin(self, name):
        w = self.windows.pop(name, None)
        self.plugins.pop(name, None)
        if w:
            w.win.destroy()

    def scan_plugins(self):
        """(Re)load new or changed plugins, close removed ones; never raises."""
        import plugins as PL
        loaded = False
        try:
            found = PL.files()
            for name in list(self.plugins):
                if name not in found:
                    PL.log(name, "removed; closing")
                    self._close_plugin(name)
                    if self.editor:
                        self.editor.changed(rebuild=True)
            for name, (path, mtime) in found.items():
                if name in self.windows and name not in self.plugins:
                    continue                          # a core panel's name: never shadowed
                if self.plugins.get(name) == (path, mtime):
                    continue
                self._close_plugin(name)
                self.plugins[name] = (path, mtime)     # remembered even when it fails, so it isn't retried every 2 s
                try:
                    cls, layout = PL.load(path)
                    spec = dict(layout)
                    # placed by layout.json: its "plugins" map, or a "panels" entry of that name
                    spec.update(next((p for p in self.cfg["panels"] if p.get("name") == name), {}))
                    spec.update((self.cfg.get("plugins") or {}).get(name, {}))
                    spec["name"] = name
                    panel = PL.make(cls, spec, self.wake)
                    panel.width = int(spec.get("width", panel.width))
                    panel.height = int(spec.get("height", panel.height))
                    spec.setdefault("width", panel.width)
                    spec.setdefault("height", panel.height)
                    conn = self.target(spec.get("output"))
                    spot = self._place(name, spec, conn)
                    roomless = spot is None
                    x, y = spot or MARGIN_SPOT
                    safe = PL.SafePanel(name, panel, path)
                    win = PanelWindow(self, safe, gdk_monitor(conn, self.mons), x, y, name, spec.get("fit"))
                    win.pos = (x, y)
                    win.monitor, win.pin = conn, spec.get("output") or None
                    if self.editor:
                        win.set_layer(True)
                    win.win.connect("delete-event", self.on_surface_closed, name)
                    self.windows[name] = win
                    if roomless:
                        PL.log(name, A.no_room(name) + " (left off)")
                        self.say(A.no_room(G.meta_of(panel, name)["title"]))
                    elif spec.get("visible", True):
                        win.win.show_all()
                    PL.log(name, f"loaded at {x},{y} ({panel.width}x{panel.height})")
                    loaded = True
                    if self.editor:
                        self.editor.changed(rebuild=True)
                except Exception:
                    import traceback
                    PL.log(name, "load failed:\n" + traceback.format_exc())
                    self.load_errors = getattr(self, "load_errors", {})
                    self.load_errors[name] = traceback.format_exc().strip().splitlines()[-1][:200]
                else:
                    getattr(self, "load_errors", {}).pop(name, None)
            if loaded and hasattr(self, "coverage"):   # one whose monitor isn't connected: on the primary
                self.fall_back()
            for name in list(self.plugins):           # a switched-off plugin hides
                w = self.windows.get(name)
                if w and getattr(w.panel, "disabled", None) and w.visible():
                    w.win.hide()
        except Exception as e:
            print("bromigos-widgets: plugin scan failed:", e, file=sys.stderr, flush=True)
        return True

    # ------------------------------------------------------------------ fitting to content
    FIT_EVERY = 30.0         # s: at most one change of a panel's frame in this long
    NATURALS_EVERY = 60.0    # s: how often the heights the layouts read are measured again

    def fit_content(self):
        """Every 5 s, outside edit mode: a panel that fits its content (fit "content") has
        its frame follow what its content needs, inside the room it was given, its top left
        where it is. Hysteresis: only when that changes by more than a row (panels.ROW), and
        not more than once every FIT_EVERY seconds, so it never jumps with each reading.
        Then the heights each widget's content needs in each class (the health file's
        "natural", for `bromigos panels layout apply` and Tidy up), once a minute."""
        now = time.monotonic()
        if self.editor is None:
            for w in self.windows.values():
                if not hasattr(w, "show_height") or not w.visible() or self.coverage.covers(w.monitor):
                    continue
                target = w.content_target()
                if target is None:
                    if w.shown_height() != w.box[1]:
                        w.show_height(w.box[1])
                    continue
                if abs(target - w.shown_height()) > P.ROW and now - w.fitted_at >= self.FIT_EVERY:
                    w.show_height(target)
                    w.fitted_at = now
        if now - self.naturals_at >= self.NATURALS_EVERY:
            self.naturals_at = now
            got = {}
            for n, w in self.windows.items():
                if getattr(w, "fit", None) == "content" and hasattr(w, "panel"):
                    try:
                        nat = P.naturals(w.panel, width=w.box[0])
                    except Exception as e:            # noqa: BLE001  never in the way of the panels
                        print(f"bromigos-widgets: {n}: measuring its content: {e}", file=sys.stderr, flush=True)
                        continue
                    if nat:
                        got[n] = nat
            self.naturals = got
        return True

    def unfit(self):
        """Edit mode: every panel's frame fills its room again (what's being arranged)."""
        for w in self.windows.values():
            if hasattr(w, "show_height") and w.shown_height() != w.box[1]:
                w.show_height(w.box[1])
            if hasattr(w, "fitted_at"):
                w.fitted_at = 0.0

    def write_health(self):
        try:
            plug = {}
            for name in self.plugins:
                w = self.windows.get(name)
                if w and hasattr(w.panel, "health"):
                    plug[name] = {**w.panel.health(), "visible": w.visible()}
                elif name in getattr(self, "load_errors", {}):
                    plug[name] = {"status": "load_failed", "last_error": self.load_errors[name]}
            d = {"t": time.time(), "pid": os.getpid(), "uptime_s": round(time.time() - self.started),
                 "covered": self.coverage.covers(self.primary), "covered_outputs": sorted(self.coverage.on),
                 "editing": self.editor is not None, "plugins": plug,
                 "monitor": self.primary, "outputs": [m["name"] for m in self.mons], "panels": self.state(),
                 "natural": getattr(self, "naturals", {})}
            import plugins as PL
            tmp = PL.HEALTH + ".tmp"
            with open(tmp, "w") as f:
                json.dump(d, f)
            os.replace(tmp, PL.HEALTH)
        except Exception as e:
            print("bromigos-widgets: health write failed:", e, file=sys.stderr, flush=True)
        return True

    def on_surface_closed(self, win, _ev, name):
        if win.get_visible():
            self.lost.add(name)
        win.hide()
        print(f"bromigos-widgets: {name} surface closed (output gone?)", file=sys.stderr, flush=True)
        self.reattach_soon()
        return True                       # keep the window; it is mapped again later

    def reattach_soon(self):
        GLib.idle_add(lambda: (self.reattach(), False)[1])
        for d in (1500, 4000, 9000):
            GLib.timeout_add(d, lambda: (self.reattach(), False)[1])
        GLib.timeout_add(12000, lambda: (self.check_surfaces(), False)[1])
        return False

    def reattach(self, names=None):
        """After a hotplug: every panel by its monitor (fall_back), and the shown panels
        whose surfaces closed mapped again."""
        self.refresh()
        if not self.mons:
            return False
        self.pick_primary()
        self.fall_back()
        names = set(names or ()) | self.lost
        again = set()
        for n in names:
            w = self.windows.get(n)
            if not w or self.monitor(w.monitor) is None:
                continue
            mon = gdk_monitor(w.monitor, self.mons, strict=True)
            if mon is None:
                continue
            w.win.hide()
            GtkLayerShell.set_monitor(w.win, mon)
            w.win.show_all()
            w.redraw()
            again.add(n)
        if again:
            print(f"bromigos-widgets: re-attached {', '.join(sorted(again))}", file=sys.stderr, flush=True)
        self.lost -= again
        if self.editor:
            self.editor.monitors_changed()
        return False

    def check_surfaces(self):
        """Backstop every 30 s: every shown panel must have a surface on its monitor."""
        self.refresh()
        if not self.mons:
            return True
        data = hypr_request("j/layers") or {}
        short = False
        for m in self.mons:
            levels = (data.get(m["name"]) or {}).get("levels", {})
            have = sum(1 for lv in levels.values() for L in lv if L.get("namespace") == "bromigos-widgets")
            shown = [n for n, w in self.on(m["name"]).items() if w.visible()]
            short = short or have < len(shown)
        strays = any(self.monitor(w.monitor) is None for w in self.windows.values())
        if short or strays or self.lost:
            print("bromigos-widgets: a shown panel has no surface on its monitor; re-attaching",
                  file=sys.stderr, flush=True)
            self.reattach({n for n, w in self.windows.items() if w.visible()} if short else None)
        return True

    def read_layout(self):
        """layout.json (the user's, else bromigOS's). One from before each panel had its own
        monitor is brought up to date (arrange.migrate) and, when it's the user's, written
        back at once (through a symlink, in one step), while that monitor is connected to
        say its make, model and serial."""
        with open(LAYOUT) as f:
            doc = json.load(f)
        new, got = A.migrate(doc, self.mons)
        if got and os.path.realpath(LAYOUT) == os.path.realpath(A.user_path()):
            try:
                A.write(new)
                print("bromigos-widgets: layout.json: each panel's monitor written in", file=sys.stderr, flush=True)
            except OSError as e:
                print(f"bromigos-widgets: layout.json not migrated: {e}", file=sys.stderr, flush=True)
        return new

    def wake(self, panel):
        GLib.idle_add(self.redraw_panel, panel)

    def drawn(self, w):
        """Whether a panel's window is worth drawing now: shown, and its monitor's desktop
        not covered (edit mode: always)."""
        return w.visible() and (self.editor is not None or not self.coverage.covers(w.monitor))

    def redraw_panel(self, panel):
        import plugins as PL
        for w in self.windows.values():
            if PL.same_panel(getattr(w, "panel", None), panel) and self.drawn(w):
                w.redraw()
        return False

    def on_coverage(self):
        for w in self.windows.values():
            if self.drawn(w):
                w.redraw()
        return False

    def loop(self):
        """100 ms heartbeat: sample each panel on its own interval; redraw at
        10 fps only while a panel runs a short animation (the Lab's sync pulse)."""
        game = os.path.exists(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "bromigos-game-on.json"))
        saved = getattr(self, "game_visible", None)
        if game:
            if saved is None:
                self.game_visible = saved = {n: self.shown(n) for n in self.windows}
            for n, w in self.windows.items():
                saved.setdefault(n, self.shown(n))
                w.win.hide()
        elif saved is not None:
            self.game_visible = None
            for n, visible in saved.items():
                if n in self.windows and visible:
                    self.windows[n].win.show_all()
        now = time.monotonic()
        if D.T.version() != self.theme_seen:   # `bromigos theme set`: new colours, redraw
            self.theme_seen = D.T.version()
            self.css.load_from_data(theme_css())
            if self.editor:
                self.editor.restyle()
            for w in self.windows.values():
                if getattr(w, "panel", None) is not None and w.visible():
                    w.redraw()
        for w in self.windows.values():
            p = getattr(w, "panel", None)
            if p is None:
                continue
            if now - w.last_tick >= p.interval - 0.01:
                p.tick()
                w.last_tick = now
                if self.drawn(w):
                    w.redraw()
            elif p.animating and self.drawn(w):
                w.redraw()
        return True

    # --- IPC
    def listen(self):
        try:
            os.unlink(SOCK)
        except OSError:
            pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.sock.bind(SOCK)
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self.on_cmd)

    def on_cmd(self, *_):
        msg = self.sock.recv(1024).decode().split()
        if not msg:
            return True
        if msg[0] == "toggle" and len(msg) > 1:
            names = [msg[1]]
            if msg[1] == "all":
                visible = {n for n, w in self.windows.items() if w.visible()}
                show = not visible
                if visible:
                    self.hidden_set = visible
                names = list(visible or getattr(self, "hidden_set", set()))
                if show:
                    self.hidden_set = set()
            for n in names:
                w = self.windows.get(n)
                if not w:
                    continue
                vis = show if msg[1] == "all" else not w.visible()
                w.win.show_all() if vis else w.win.hide()
        elif msg[0] == "show" and len(msg) > 1:      # never hides (the launcher's entry)
            for n in (list(self.windows) if msg[1] == "all" else [msg[1]]):
                w = self.windows.get(n)
                if w and not w.visible():
                    w.win.show_all()
        elif msg[0] == "notes" and "notes" in self.windows and not self.editor:
            self.windows["notes"].focus()
        elif msg[0] == "edit":
            self.edit(msg[1] if len(msg) > 1 else "toggle", msg[2] if len(msg) > 2 else None)
        elif msg[0] == "add" and len(msg) > 1 and msg[1] in self.windows:
            self.add(msg[1])
        elif msg[0] == "stats":
            print(f"covered={sorted(self.coverage.on)} " + " ".join(
                f"{n}:draws={getattr(w, 'draws', 0)},visible={w.visible()}" for n, w in self.windows.items()),
                file=sys.stderr, flush=True)
        elif msg[0] == "reload":
            if self.editor:                    # a change from Settings or the CLI mid-edit: theirs wins
                self.editor.cancel()
            os.execv(sys.executable, [sys.executable, os.path.realpath(__file__)])
        return True

    # --- edit mode (editmode.py)
    def edit(self, how="toggle", select=None):
        if how in ("on", "toggle") and self.editor is None:
            import editmode
            self.unfit()
            self.editor = editmode.Editor(self, select)
        elif how in ("done", "toggle") and self.editor:
            self.editor.done()
        elif how == "cancel" and self.editor:
            self.editor.cancel()
        elif how == "on" and self.editor and select:
            self.editor.select(select)
        self.write_health()

    def state(self):
        """{name: {x, y, width, height, visible, output, pin}} of every panel, as it is now:
        output, the monitor it shows on; pin, its own monitor (None: the primary's)."""
        return {n: dict(w.rect_state(), visible=self.shown(n), output=w.monitor, pin=w.pin)
                for n, w in self.windows.items()}

    def apply_state(self, state):
        for n, s in state.items():
            w = self.windows.get(n)
            if not w:
                continue
            if (s.get("width"), s.get("height")) != w.size_now() and s.get("width") and s.get("height"):
                w.resize(s["width"], s["height"])
            if "pin" in s:
                w.pin = s["pin"]
            if s.get("output") and s["output"] != w.monitor and self.monitor(s["output"]):
                self.put(w, s["output"])
            if "x" in s and "y" in s:
                w.place(s["x"], s["y"])
            self.set_visible(n, s.get("visible", True))

    def set_visible(self, name, on):
        w = self.windows.get(name)
        if not w or bool(w.visible()) == bool(on):
            return
        if on:
            w.win.show_all()
            if self.editor:
                w.set_layer(True)
        else:
            w.win.hide()

    def raise_panels(self, top):
        """Edit mode: the panels above the windows (the top layer), and back below them."""
        for w in self.windows.values():
            w.set_layer(top)

    def area(self, conn=None):
        """The usable area of an output (logical px, under the bar); the primary's by default."""
        m = self.monitor(conn or self.primary)
        if not m:
            mon = gdk_monitor(conn or self.primary, self.mons)
            g = mon.get_geometry() if mon else None
            return (g.width, g.height - 34) if g else (2560, 1406)
        return A.usable(m)[2:]

    @staticmethod
    def avoid(area):
        """Where a new panel shouldn't go: VECTOR's console (bottom right) and the
        notifications (top right)."""
        W, H = area
        return [(W - 24 - 1180, H - 24 - 640, 1180, 640), (W - 440, 0, 440, 320)]

    def monitors(self):
        """The outputs there are: [(name, a label for it)]."""
        out = []
        for m in self.mons:
            what = " ".join(v for v in (m.get("make"), m.get("model")) if v)
            out.append((m["name"], f"{m['name']} · {what}" if what else m["name"]))
        return out

    def move_panel(self, name, conn):
        """A panel onto another output by the user's hand (edit mode): it's that monitor's
        now, by make, model and serial. Returns whether it moved."""
        w = self.windows.get(name)
        if not w or conn == w.monitor or self.monitor(conn) is None:
            return False
        if not self.put(w, conn):
            return False
        w.pin, w.fell, w.home, w.was = self.identity(conn), None, None, None
        if self.editor:
            w.set_layer(True)
        return True

    def layout_state(self, names):
        """What layout.json keeps for these panels: place, size, on or off, and each one's
        own monitor (arrange.kept_place: a panel standing in on the primary keeps its own)."""
        out = {}
        for n in names:
            w = self.windows[n]
            pin, x, y = A.kept_place((w.monitor, w.x, w.y), w.pin, w.fell, w.home, self.mons)
            out[n] = dict(w.rect_state(), x=x, y=y, visible=self.shown(n), output=pin)
        return out

    def save_layout(self, before=None):
        """layout.json with every panel as it is now (edit mode's Done): the user's file,
        first copied from bromigOS's; through a symlink, kept a symlink (arrange.write)."""
        doc, _path, _mine = A.read()
        doc = A.migrate(doc, self.mons)[0]
        now = self.state()
        known = A.state_of(doc)
        # the panels the layout already lists, and any plugin moved or switched this time
        keep = [n for n, s in now.items() if n in known or n in G.core_classes() or n == "notes"
                or (before or {}).get(n) != s]
        doc = A.apply(doc, self.layout_state(keep))
        A.write(doc)
        for n in keep:                            # what's saved is where they are
            w = self.windows[n]
            if not w.fell:
                w.pin = G.layout_entry(doc, n).get("output") or None
        self.cfg = doc
        return doc

    def add(self, name):
        """A panel on, in a free spot (`bromigos panels add`), saved; or, with no room for it
        anywhere, left off and said so (never on top of another)."""
        w = self.windows[name]
        if self.editor:
            self.editor.show(name, free=True)
            return
        if not w.visible():                    # its default size class, as the gallery's Add does
            w.set_size_class(G.meta_of(getattr(w, "panel", None), name)["default_size"])
        area = self.area(w.monitor)
        taken = self.shown_rects(w.monitor, name)
        avoid, soft = self.keep_clear(w.monitor, area)
        spot = A.place(*w.size_now(), taken, area, avoid, soft, strict=True, hard=self.hard_areas(w.monitor))
        if spot is None:
            panel = getattr(w, "panel", None)
            self.say(A.no_room(G.meta_of(panel, name)["title"] if panel is not None else "FIELD NOTES"))
            return
        w.place(*spot)
        self.set_visible(name, True)
        self.save_layout()

    @staticmethod
    def launch(argv):
        import subprocess
        try:
            subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError as e:
            print(f"bromigos-widgets: {argv[0]}: {e}", file=sys.stderr, flush=True)


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    App()
    Gtk.main()


if __name__ == "__main__":
    main()
