# ------------------------------------------------------------------ Hyprland: which monitor, is it covered?
def _live_sig():
    """The Hyprland instance that answers. $HYPRLAND_INSTANCE_SIGNATURE goes stale when the
    widgets outlive a Hyprland restart (or start from a shell that did); then fall back to
    the newest instance whose socket accepts a connection, and remember it."""
    base = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr")

    def alive(sig):
        if not sig:
            return False
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(0.5)
        try:
            s.connect(os.path.join(base, sig, ".socket.sock"))
            return True
        except OSError:
            return False
        finally:
            s.close()
    cur = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if alive(cur):
        return cur
    try:
        for d in sorted(os.listdir(base), key=lambda n: os.path.getmtime(os.path.join(base, n)), reverse=True):
            if alive(d):
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = d
                return d
    except OSError:
        pass
    return None


def hypr_request(cmd):
    sig = _live_sig()
    if not sig:
        return None
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr", sig, ".socket.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1)
            s.connect(path)
            s.sendall(cmd.encode())
            buf = b""
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        return json.loads(buf or b"null")
    except (OSError, ValueError):
        return None


class Coverage(threading.Thread):
    """Listens to Hyprland's event socket and tracks which monitors' desktops are covered
    by tiled/fullscreen windows (`on`: their names). A monitor coming or going calls
    on_hotplug."""

    def __init__(self, on_change, on_hotplug=None):
        super().__init__(daemon=True)
        self.on_change, self.on_hotplug = on_change, on_hotplug
        self.on = set()
        self.check()

    def covers(self, monitor):
        return monitor in self.on

    def check(self):
        mons = hypr_request("j/monitors") or []
        clients = hypr_request("j/clients") or []
        cov = set()
        for mon in mons:
            shown = {(mon.get("activeWorkspace") or {}).get("id"), (mon.get("specialWorkspace") or {}).get("id") or None}
            shown.discard(None)
            if any(c["workspace"]["id"] in shown and (not c["floating"] or c.get("fullscreen"))
                   and c.get("mapped", True) and not c.get("hidden") for c in clients):
                cov.add(mon.get("name"))
        if cov != self.on:
            self.on = cov
            GLib.idle_add(self.on_change)

    def run(self):
        sig = _live_sig()
        if not sig:
            return
        path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr", sig, ".socket2.sock")
        watch = (b"workspace", b"openwindow", b"closewindow", b"movewindow", b"changefloatingmode",
                 b"fullscreen", b"focusedmon", b"activespecial")
        hotplug = (b"monitoradded", b"monitorremoved", b"monitoraddedv2", b"monitorremovedv2")
        while True:
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                    s.connect(path)
                    f = s.makefile("rb")
                    for line in f:
                        ev = line.split(b">>")[0]
                        if ev in watch or ev in hotplug:
                            self.check()
                        if ev in hotplug and self.on_hotplug:
                            GLib.idle_add(self.on_hotplug)
            except OSError:
                time.sleep(5)


def monitors():
    """Hyprland's monitors (`hyprctl monitors -j`), the disabled left out."""
    return [m for m in (hypr_request("j/monitors") or []) if m.get("name") and not m.get("disabled")]


def setup_primary():
    try:
        import bromigos_monitors
        return bromigos_monitors.setup_primary()
    except (ImportError, AttributeError):
        return ""


def resolve_monitor(name, mons=None):
    """The panels' primary output: lib/bromigos_monitors.primary (the layout's "monitor"
    when that output is there, else setup's primary, the focused, the first)."""
    mons = monitors() if mons is None else mons
    try:
        import bromigos_monitors
        return bromigos_monitors.primary(mons, name)
    except ImportError:                        # an older bromigos-core: the first output
        if name and any(m.get("name") == name for m in mons):
            return name
        return (min(mons, key=lambda m: m.get("id", 0)).get("name") if mons else None) or name


def gdk_monitor(name, mons=None, strict=False):
    """Map a Hyprland output name to the Gdk.Monitor with the same geometry (arrange.gdk_index).
    Not found: None when strict (GTK hasn't heard of it yet: try again later), else GTK's
    primary."""
    mons = monitors() if mons is None else mons
    m = next((m for m in mons if m["name"] == name), None)
    disp = Gdk.Display.get_default()
    if m:
        gs = [disp.get_monitor(i).get_geometry() for i in range(disp.get_n_monitors())]
        i = A.gdk_index([(g.x, g.y, g.width, g.height) for g in gs], m)
        if i is not None:
            return disp.get_monitor(i)
    if strict:
        return None
    return disp.get_primary_monitor() or disp.get_monitor(0)


