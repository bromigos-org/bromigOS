{
  "_comment": "Qwen-Image-2512 (Qwen, Apache-2.0) on a ComfyUI (API format): a still from a prompt, the default for image.generate. Comfy-Org's template: ModelSamplingAuraFlow shift 3.1, euler/simple, 50 steps at true CFG 4; the negative prompt is the one Qwen's model card gives (low resolution, deformed limbs, oversaturation, a waxy AI look, blurry or distorted text). bromigos-art fills the prompt, the seed, the size (the asset's aspect at about _meta.resolution squared, 1328 by default, the model's native size, or extra.resolution) and the filename prefix through _meta.bind. It draws from a prompt alone: no reference images.",
  "_meta": {
    "capabilities": [
      "image.generate"
    ],
    "output": "png",
    "license": "Apache-2.0 (Qwen-Image-2512)",
    "commercial": "yes",
    "fill": "bind",
    "catalog": "qwen-image-2512/fp8",
    "seconds": 130,
    "resolution": 1328,
    "requires": [
      {
        "folder": "diffusion_models",
        "file": "qwen_image_2512_fp8_e4m3fn.safetensors"
      },
      {
        "folder": "text_encoders",
        "file": "qwen_2.5_vl_7b_fp8_scaled.safetensors"
      },
      {
        "folder": "vae",
        "file": "qwen_image_vae.safetensors"
      }
    ],
    "bind": {
      "prompt": [
        "5",
        "text"
      ],
      "seed": [
        "8",
        "seed"
      ],
      "width": [
        "7",
        "width"
      ],
      "height": [
        "7",
        "height"
      ],
      "prefix": [
        "10",
        "filename_prefix"
      ]
    }
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2512_fp8_e4m3fn.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 3.1
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "3",
        0
      ],
      "text": ""
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "3",
        0
      ],
      "text": "低分辨率，低画质，肢体畸形，手指畸形，画面过饱和，蜡像感，人脸无细节，过度光滑，画面具有AI感。构图混乱。文字模糊，扭曲。"
    }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1328,
      "height": 1328,
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "7",
        0
      ],
      "seed": 0,
      "steps": 50,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "filename_prefix": "bromigos-art"
    }
  }
}
