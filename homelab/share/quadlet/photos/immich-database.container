[Unit]
Description=Photos (Immich): database

[Container]
Image={{image:postgres}}
ContainerName=immich-database
Network=bromigos-lab.network
Volume={{data}}/postgres:/var/lib/postgresql/data:Z
ShmSize=128m
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Secret={{secret:db-password}},type=mount,target=/run/secrets/db-password,mode=0400,uid=999
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/db-password

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
