[Unit]
Description=Photos (Immich)
Requires=immich-database.service immich-valkey.service
After=immich-database.service immich-valkey.service

[Container]
Image={{image:server}}
ContainerName=immich-server
Network=bromigos-lab.network
PublishPort=2283:2283
Volume={{data}}/library:/data:Z
Volume=/etc/localtime:/etc/localtime:ro
Environment=DB_HOSTNAME=immich-database
Environment=DB_USERNAME=postgres
Environment=DB_DATABASE_NAME=immich
Environment=REDIS_HOSTNAME=immich-valkey
Environment=IMMICH_MACHINE_LEARNING_URL=http://immich-ml:3003
Secret={{secret:db-password}},type=mount,target=/run/secrets/db-password,mode=0400
Environment=DB_PASSWORD_FILE=/run/secrets/db-password

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
