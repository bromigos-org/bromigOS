[Unit]
Description=Beets

[Container]
Image={{image:beets}}
ContainerName=beets
Network=bromigos-lab.network
PublishPort=8337:8337
Environment=PUID={{puid}}
Environment=PGID={{pgid}}
Environment=TZ={{tz}}
Volume={{data}}/config:/config:Z
Volume={{media}}/music:/music
Volume={{downloads}}:/downloads

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
