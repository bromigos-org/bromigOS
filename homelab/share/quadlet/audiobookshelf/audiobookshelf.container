[Unit]
Description=Audiobookshelf

[Container]
Image={{image:audiobookshelf}}
ContainerName=audiobookshelf
Network=bromigos-lab.network
PublishPort=13378:80
Volume={{data}}/config:/config:Z
Volume={{data}}/metadata:/metadata:Z
Volume={{media}}/books:/audiobooks
Volume={{media}}/podcasts:/podcasts
Environment=TZ={{tz}}

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
