[Unit]
Description=Tautulli

[Container]
Image={{image:tautulli}}
ContainerName=tautulli
Network=bromigos-lab.network
PublishPort=8181:8181
Environment=PUID={{puid}}
Environment=PGID={{pgid}}
Environment=TZ={{tz}}
Volume={{data}}/config:/config:Z

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
