[Unit]
Description=Lidarr (music)

[Container]
Image={{image:lidarr}}
ContainerName=lidarr
Network=bromigos-lab.network
PublishPort=8686:8686
Secret={{secret:api-key}},type=mount,target=/run/secrets/api-key,mode=0400
Environment=FILE__LIDARR__AUTH__APIKEY=/run/secrets/api-key
Environment=PUID={{puid}}
Environment=PGID={{pgid}}
Environment=TZ={{tz}}
Volume={{data}}/config:/config:Z
Volume={{media}}:/media

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
