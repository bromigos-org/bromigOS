[Unit]
Description=Creation studio (ComfyUI)

[Container]
Image={{image:comfyui}}
ContainerName=comfyui
Network=bromigos-lab.network
PublishPort=8188:8188
#ifgpu:nvidia AddDevice=nvidia.com/gpu=all
#ifgpu:amd AddDevice=/dev/kfd
#ifgpu:amd AddDevice=/dev/dri
Volume={{data}}/models:/root/ComfyUI/models:Z
Volume={{data}}/custom_nodes:/root/ComfyUI/custom_nodes:Z
Volume={{data}}/local:/root/.local:Z
Volume={{data}}/user:/root/ComfyUI/user:Z
Volume={{data}}/input:/root/ComfyUI/input:Z
Volume={{data}}/output:/root/ComfyUI/output:Z
ShmSize=8g

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
