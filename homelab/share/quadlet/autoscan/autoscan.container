[Unit]
Description=Autoscan

[Container]
Image={{image:autoscan}}
ContainerName=autoscan
Network=bromigos-lab.network
PublishPort=3030:3030
Volume={{data}}/config:/config:Z
Volume={{media}}:/media:ro
Environment=PUID={{puid}}
Environment=PGID={{pgid}}

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
