# The lab model catalog's weekly check (bromigos-homelab; docs/lab-models.md, "Staying current"):
# fetches the newest signed catalog from bromigOS's package repository, then says once,
# quietly, when a better model fits one of the lab's GPUs (and your goal and licence filter).
# It never installs or changes anything. Quiet with no homelab configured.
[Unit]
Description=bromigOS lab models: the newest catalog, and a nudge when a better model fits
Documentation=file:///usr/share/doc/bromigos-lab-catalog/lab-models.md
After=network-online.target

[Service]
Type=oneshot
Environment=PYTHONPATH=/usr/lib/bromigos/lib
ExecStart=/usr/bin/python3 -m bromigos_homelab.catalog_refresh --weekly
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=300
