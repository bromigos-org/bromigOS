#!/usr/bin/env python3
# bromigos:summary=Your media library in a terminal: TV, films, music, YouTube, downloads, releases, search and den TV channels; request, monitor, change quality, play, cast or delete
# bromigos:args=[tv|movies|music|youtube|downloads|upcoming|search|channels] | search|get|status|upcoming|recent|library|language|monitor|profile|refresh|delete|channel|cast …
# bromigos:examples=bromigos media; bromigos media movies; bromigos media get "Cowboy Bebop"; bromigos media status; bromigos media cast targets
# bromigos:menu=LAUNCH:Media library
"""bromigos media: the media library (docs/lab.md, "Media requests"; the manual's Lab console).

  bromigos media [TAB]              the terminal UI (Textual), on TAB: tv, movies, music, youtube,
                                    downloads, upcoming, search or channels (add is an alias)
  bromigos media VERB …             = bromigos lab media VERB …: search, get, status, upcoming,
                                    recent, library, language, monitor, profile, refresh, delete, channel
  bromigos media cast …             play on a Chromecast, a DLNA TV, AirPlay, a Jellyfin app or the den:
                                    targets, play, control, status, handback (cast --help)
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
for p in reversed((os.path.join(os.path.dirname(HERE), "lib"), "/usr/lib/bromigos/lib")):
    if os.path.isdir(p) and p not in sys.path:
        sys.path.insert(0, p)

TABS = ("tv", "movies", "music", "youtube", "downloads", "upcoming", "add", "channels")


def main(argv):
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip())
        return 0
    if not argv and not (sys.stdout.isatty() and sys.stdin.isatty()):     # no terminal: the Requests card
        import subprocess
        lab = os.path.join(HERE, "bromigos-lab")
        return subprocess.call([lab if os.path.exists(lab) else "/usr/lib/bromigos/bin/bromigos-lab", "media"])
    if not argv or argv[0] in TABS or argv == ["search"]:
        try:
            from bromigos_homelab import mediatui
        except ImportError as e:
            if "textual" in str(e):
                print("The media library needs Textual: sudo pacman -S python-textual.", file=sys.stderr)
                return 2
            raise
        return mediatui.main(argv)
    from bromigos_homelab import mediareq
    return mediareq.main(argv)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
