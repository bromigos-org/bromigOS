# The Lab board (docs/board.md): its user and folders on install. The lab's provisioning starts
# its socket and reader (bromigos lab provision --local, the `board` item); an upgrade restarts
# the API when it's running, so it serves the new code.

post_install() {
  systemd-sysusers /usr/lib/sysusers.d/bromigos-board.conf >/dev/null 2>&1 || true
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/bromigos-board.conf >/dev/null 2>&1 || true
}

# An upgrade never widens what the board's page may do on its own (docs/board.md, "What a session
# can do"): before the new files go in, the old package says what it allowed by default; after,
# a server whose server.toml doesn't say [board] actions gets that list written in. A board from
# before actions allowed nothing. A new install has none of this, and gets the new default.
pre_upgrade() {
  mkdir -p -m 0700 var/lib/bromigos-board-root 2>/dev/null || true
  python3 -I -c 'import json, sys
sys.path.insert(0, "usr/lib/bromigos/lib")
try:
    from bromigos_board import actions
    was = list(actions.DEFAULT_ACTIONS)
except Exception:            # a board with no actions: it allowed nothing
    was = []
print(json.dumps(was))' > var/lib/bromigos-board-root/upgrade-actions 2>/dev/null \
    || rm -f var/lib/bromigos-board-root/upgrade-actions
}

post_upgrade() {
  post_install
  if [ -s var/lib/bromigos-board-root/upgrade-actions ]; then
    usr/lib/bromigos/board/bromigos-board keep-actions var/lib/bromigos-board-root/upgrade-actions || true
  fi
  rm -f var/lib/bromigos-board-root/upgrade-actions
  systemctl try-restart bromigos-board.service >/dev/null 2>&1 || true
  # a server set up before the page could act, or before it showed the lab's jobs: the helper's
  # watch and the lab follower's start with the rest
  if systemctl is-enabled -q bromigos-board.socket 2>/dev/null; then
    systemctl enable --now bromigos-board-act.path bromigos-board-lab.path >/dev/null 2>&1 || true
  fi
}

# Removing it: its units stop, and its site comes out of Caddy first. The site imports a file of
# this package's (/usr/share/bromigos-board/caddy/site.caddy): left behind, Caddy would refuse
# its whole configuration at its next start, and every app's page with it. The sessions end too:
# they'd be good for 30 days if the package came back.
pre_remove() {
  systemctl disable --now bromigos-board.socket bromigos-board.service bromigos-board-snapshot.path \
    bromigos-board-snapshot.service bromigos-board-act.path bromigos-board-act.service \
    bromigos-board-lab.path bromigos-board-lab-start.service bromigos-board-lab.service >/dev/null 2>&1 || true
  rm -rf run/systemd/system/bromigos-board-lab.service.d 2>/dev/null || true
  if [ -e etc/caddy/conf.d/bromigos-board.caddy ]; then
    rm -f etc/caddy/conf.d/bromigos-board.caddy
    systemctl reload caddy.service >/dev/null 2>&1 || true
  fi
  rm -f var/lib/bromigos-board/sessions/*.json var/lib/bromigos-board/codes/*.json \
    var/lib/bromigos-board-root/codes/*.json 2>/dev/null || true
}
