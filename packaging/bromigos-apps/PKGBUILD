# Maintainer: bromigOS <packages@bromigos.org>
#
# The app bundle (docs/apps.md): a curated set of desktop apps with bromigOS's own
# configs, themed where the theme reaches (neovim, tmux, btop through the apps theme-set
# hook; lazygit through the terminal palette; Chromium's frame colour). The configs are
# read-only defaults in /usr/share/bromigos/default/apps/; `bromigos apps setup` seeds a
# user's thin files once (apps/user/), and updates never touch ~/.config. The set and the
# default-plus-override model follow Omarchy's app bundle. Optional in the `bromigos`
# meta-package.

pkgname=bromigos-apps
pkgver=0.0.0
pkgrel=1
pkgdesc='bromigOS app bundle: LazyVim, tmux, lazygit, mise (bromigos-apps-terminal), Chromium, Spotify and Signal, configured and themed'
arch=('any')
url='https://github.com/bromigos-org/bromigOS'
license=('MIT OR Apache-2.0')
# the terminal apps and their configs are bromigos-apps-terminal's (Field Kit and bromigOS
# Server have them without a desktop); this package adds the desktop apps and the clipboard
depends=('bromigos-apps-terminal' 'bromigos-desktop'
         'chromium' 'spotify-launcher' 'signal-desktop' 'wl-clipboard')
optdepends=('1password: the password manager (bromigos install --with 1password)')
makedepends=('git')
options=('!debug')

_root="${startdir%/packaging/*}"
_paths=(apps packaging/bromigos-apps LICENSE-MIT LICENSE-APACHE)

# <workspace version>.r<commits touching the package>.g<last such commit> (as bromigos-core)
# The commits that touched _paths before the history restarted at v0.1.2 (they're in
# bromigos-org/bromigOS-archive): the count goes on from them, so no version sorts below one
# published before the restart (packaging/README.md, Versions).
_archived=2

pkgver() {
  cd "$_root"
  local base
  base=$(sed -n '/^\[workspace\.package\]/,/^\[/ s/^version *= *"\(.*\)"/\1/p' core/Cargo.toml)
  printf '%s.r%s.g%s' "${base//-/_}" \
    "$((_archived + $(git rev-list --count HEAD -- "${_paths[@]}")))" \
    "$(git log -1 --format=%h -- "${_paths[@]}" | grep . || echo 0)"
}

package() {
  cd "$_root/apps"
  install -Dm0644 chromium/chromium-flags.conf "$pkgdir/usr/share/bromigos/default/apps/chromium/chromium-flags.conf"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_root/LICENSE-MIT" "$_root/LICENSE-APACHE"
}
