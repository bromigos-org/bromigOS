# The Secret Service on first use, for a session that hasn't started it yet: oo7-daemon,
# through its systemd user unit (dbus-org.freedesktop.secrets.service is its alias).
# Upstream 0.7 leaves this file to distributions; Arch's 0.6 package shipped the same one.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/bin/false
SystemdService=dbus-org.freedesktop.secrets.service
