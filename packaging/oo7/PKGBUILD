# Maintainer: bromigOS <packages@bromigos.org>
#
# oo7, the Secret Service (the keyring that keeps sign-ins and passwords): oo7-daemon,
# pam_oo7.so, which unlocks it with the login password, oo7-cli and the secret portal.
# Built here from upstream's source at a pinned commit (checked by its checksum), because
# Arch's own `oo7` is 0.6.0, whose login unlock doesn't work after a text console login:
# its PAM module starts the daemon from a path Arch doesn't install it at, and without
# that it races the daemon's start, so the keyring stays locked. Upstream rebuilt the
# unlock for 0.7 (the oo7-daemon-login helper holds the password until the daemon takes
# it), and its 0.7.0 beta still had two faults a console login hits: the daemon could
# miss the helper, and logging out hung (the PAM module left a thread in `login`). The
# commit below fixes both ("server: Wait briefly for the login helper socket", "pam:
# Deliver requests before returning"), and a third: the PAM module started the login
# helper inside the login's session, and a text console login hangs that session up when
# it hands the terminal to your shell, so the helper died before the daemon took the
# password. The helper now leaves that session ("pam: Detach the login helper from the
# login's terminal", upstream PR #624, which began as a patch here). No patches of our
# own. Move to 0.7.0 when it's released.
#
# Adapted from Arch's oo7 PKGBUILD. MIT: upstream's source and licence, linked below.
#
# The version sorts after Arch's 0.6.0 and before 0.7.0, so Arch's package takes over
# again from its 0.7.0. Until then [bromigos], listed after [extra], has the newer one:
# bromigos-desktop asks for oo7>=0.7.0beta, which only this package satisfies, and pacman
# keeps it on later updates (it says "local is newer than extra").
#
# Beside upstream's files: the D-Bus activation file Arch's 0.6 shipped (upstream 0.7
# leaves it to distributions). bromigos-desktop starts the daemon in every user session.
# Left out: the Python bindings, which nothing in bromigOS uses.

pkgname=oo7
_commit=e55a1b10fc16c252811b4c7f7cf3603f743679e0   # main, 2026-10-29
pkgver=0.7.0beta.r20261029.e55a1b1
pkgrel=1
pkgdesc='A Secret Service provider'
arch=('x86_64')
url='https://github.com/linux-credentials/oo7'
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('cargo' 'meson')
provides=('org.freedesktop.secrets')
conflicts=('gnome-keyring')
options=('!debug')
source=("oo7-${_commit}.tar.gz::https://github.com/linux-credentials/oo7/archive/${_commit}.tar.gz"
        'org.freedesktop.secrets.service')
sha256sums=('d32223f24d8494bb2d5d824537cd6717a69c169bc13ea41b17f5e1bd86c7eeb9'
            '8a0efd68a5103eb8dede8e0ba5c6131a41e2ead71668dea63da632915b58e8c5')

prepare() {
  cd "oo7-$_commit"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "oo7-$_commit"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo build --release --frozen
  local d
  for d in server portal pam; do
    meson setup "build-$d" "$d" --prefix=/usr --libexecdir=lib --buildtype=plain
    # each meson project builds with `cargo --target-dir <build>/src`: point that at the
    # workspace's target, so the three share what's built
    rmdir "build-$d/src"
    ln -sr target "build-$d/src"
    CARGO_NET_OFFLINE=true meson compile -C "build-$d"
  done
}

package() {
  cd "oo7-$_commit"
  local d
  for d in server portal pam; do
    # --no-rebuild: build() has built everything; a rebuild here would run cargo again
    # under fakeroot, where git can't read the cargo cache of the git dependency (ashpd)
    meson install -C "build-$d" --destdir="$pkgdir" --no-rebuild
  done
  install -Dm755 -t "$pkgdir/usr/bin/" target/release/oo7-cli target/release/cargo-credential-oo7
  install -Dm644 -t "$pkgdir/usr/share/dbus-1/services/" "$srcdir/org.freedesktop.secrets.service"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
