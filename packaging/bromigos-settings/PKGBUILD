# Maintainer: bromigOS <packages@bromigos.org>
#
# What must exist before a user does (docs/PLAN.md, "What we borrowed from Omarchy"): the login
# screen (the Bromigos SDDM theme and its settings), the GTK theme, icon theme and cursor
# the desktop names (the Wick's, built here from GTK's own Adwaita/Default and Breeze),
# the fonts, and the builders the theme-set hook uses to make another theme's GTK theme.
#
#   /usr/share/sddm/themes/bromigos         the login screen: the den behind the burn-in
#   /usr/lib/sddm/sddm.conf.d/zz-bromigos.conf Current=bromigos, the Wayland greeter
#   /usr/lib/bromigos/sddm/bromigos-greeter  Weston launcher using the core GPU policy
#   /usr/lib/bromigos/sddm/bromigos-sddm-tidy  moves leftover /etc/sddm.conf.d files that only
#                                           repeat zz-bromigos.conf aside (the .install runs it)
#   /usr/share/themes/Bromigos              GTK 3 and 4, the Wick's colours
#   /usr/share/icons/Bromigos[-cursor]      icons (Breeze Dark recoloured) and the cursor
#   /usr/lib/bromigos/gtk/                  build-gtk-theme.py (Bromigos-<theme> into ~/.themes)
#   /usr/share/plymouth/themes/bromigos     boot, shutdown and restart splash (ring and flame)
#
# The boot menu (GRUB's theme and its entries) and the text console are bromigos-boot's, which
# Field Kit and bromigOS Server have too (docs/boot.md, docs/console.md).
#
# A theme from bromigOS's `theme set` changes the user's GTK theme (hook gtk) and the boot
# menu (hook boot, where it's on); the login screen is system-wide and stays the Wick's.

pkgname=bromigos-settings
pkgver=0.0.0
pkgrel=1
pkgdesc='bromigOS system settings: the login screen, the boot splash, the GTK, icon and cursor themes, the fonts'
arch=('any')
url='https://github.com/bromigos-org/bromigOS'
license=('MIT OR Apache-2.0')
depends=('bromigos-boot' 'sddm' 'qt6-declarative' 'weston'
         'ttf-geist-mono' 'ttf-meslo-nerd' 'noto-fonts' 'noto-fonts-emoji' 'terminus-font'
         # Japanese, Chinese and Korean titles (anime, music, YouTube) instead of empty boxes
         'noto-fonts-cjk'
         'breeze-icons' 'adwaita-cursors' 'python'
         # the gtk hook builds another theme's GTK theme from GTK's own (gresource)
         'gtk3' 'gtk4' 'glib2-devel')
makedepends=('git' 'python' 'python-pillow' 'gtk3' 'gtk4' 'glib2-devel' 'breeze-icons' 'librsvg')
checkdepends=('plymouth')
optdepends=('plymouth: the Bromigos boot, shutdown and restart splash')
options=('!debug')
install=$pkgname.install

_root="${startdir%/packaging/*}"
# themes/: the login screen and splash take the Wick's emblem kit
_paths=(settings/sddm settings/gtk settings/plymouth settings/README.md themes desktop/wallpaper packaging/bromigos-settings LICENSE-MIT LICENSE-APACHE)

# <workspace version>.r<commits touching the package>.g<last such commit> (as bromigos-core)
# The commits that touched _paths before the history restarted at v0.1.2 (they're in
# bromigos-org/bromigOS-archive): the count goes on from them, so no version sorts below one
# published before the restart (packaging/README.md, Versions).
_archived=54

pkgver() {
  cd "$_root"
  local base
  base=$(sed -n '/^\[workspace\.package\]/,/^\[/ s/^version *= *"\(.*\)"/\1/p' core/Cargo.toml)
  printf '%s.r%s.g%s' "${base//-/_}" \
    "$((_archived + $(git rev-list --count HEAD -- "${_paths[@]}")))" \
    "$(git log -1 --format=%h -- "${_paths[@]}" | grep . || echo 0)"
}

build() {
  cd "$_root/settings/gtk"
  python build-gtk-theme.py --out "$srcdir/themes/Bromigos"
  python build-icons-cursor.py --out "$srcdir/icons"
}

check() {
  cd "$_root"
  python -m unittest discover -s settings/plymouth/tests
  python -m unittest discover -s settings/sddm/tests
}

package() {
  local sddm="$pkgdir/usr/share/sddm/themes/bromigos" f
  # the login screen
  install -d "$sddm"
  cp -r "$_root/settings/sddm/bromigos/." "$sddm/"
  install -Dm0644 "$_root/themes/wick/emblem/lock/ring.png" "$sddm/assets/ring.png"
  install -Dm0644 "$_root/themes/wick/emblem/lock/flame.png" "$sddm/assets/flame.png"
  install -Dm0644 "$_root/desktop/wallpaper/bromigos-lock-empty-2560x1440.jpg" "$sddm/assets/background.jpg"
  install -d "$sddm/fonts"
  for f in Regular Medium SemiBold Bold; do      # the theme's FontLoaders: ttf-geist-mono's files
    ln -s "/usr/share/fonts/TTF/GeistMono-$f.ttf" "$sddm/fonts/GeistMono-$f.ttf"
  done
  ln -s /usr/share/licenses/ttf-geist-mono/OFL.txt "$sddm/fonts/OFL.txt"
  find "$sddm" -type d -exec chmod 0755 {} + ; find "$sddm" -type f -exec chmod 0644 {} +
  install -Dm0644 "$_root/settings/sddm/conf/zz-bromigos.conf" "$pkgdir/usr/lib/sddm/sddm.conf.d/zz-bromigos.conf"
  install -Dm0755 "$_root/settings/sddm/bromigos-greeter" "$pkgdir/usr/lib/bromigos/sddm/bromigos-greeter"
  install -Dm0755 "$_root/settings/sddm/bromigos-sddm-tidy" "$pkgdir/usr/lib/bromigos/sddm/bromigos-sddm-tidy"
  # boot, shutdown and restart splash (the ring and flame are the lock screen's)
  local ply="$pkgdir/usr/share/plymouth/themes/bromigos"
  install -Dm0644 -t "$ply/" "$_root"/settings/plymouth/bromigos/bromigos.plymouth \
    "$_root"/settings/plymouth/bromigos/bromigos.script "$_root"/settings/plymouth/bromigos/line-*.png
  install -Dm0644 "$_root/themes/wick/emblem/lock/ring.png" "$ply/ring.png"
  install -Dm0644 "$_root/themes/wick/emblem/lock/flame.png" "$ply/flame.png"
  # GTK, icons, cursor
  install -d "$pkgdir/usr/share/themes" "$pkgdir/usr/share/icons"
  cp -r "$srcdir/themes/Bromigos" "$pkgdir/usr/share/themes/"
  cp -a "$srcdir/icons/Bromigos" "$srcdir/icons/Bromigos-cursor" "$pkgdir/usr/share/icons/"
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/gtk/" "$_root/settings/gtk/build-gtk-theme.py" \
    "$_root/settings/gtk/build-icons-cursor.py"
  install -Dm0644 -t "$pkgdir/usr/lib/bromigos/gtk/" "$_root/settings/gtk/overrides.css" \
    "$_root/settings/gtk/libadwaita.css"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_root/LICENSE-MIT" "$_root/LICENSE-APACHE"
}
