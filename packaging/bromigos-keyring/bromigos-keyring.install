# Import and locally sign the bromigOS key into pacman's keyring, as
# archlinux-keyring does. Skipped when pacman's keyring is not set up yet
# (pacman-key --init), e.g. inside a fresh chroot.

post_upgrade() {
  if usr/bin/pacman-key -l >/dev/null 2>&1; then
    usr/bin/pacman-key --populate bromigos
  fi
}

post_install() {
  if [ -x usr/bin/pacman-key ]; then
    post_upgrade
  fi
}
