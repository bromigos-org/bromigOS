# The system checks every 15 minutes (docs/alerts.md). Turn them off with
# sudo systemctl disable --now bromigos-alerts.timer bromigos-alerts-boot.timer.
[Unit]
Description=bromigOS alerts: the system checks, every 15 minutes
Documentation=https://github.com/bromigos-org/bromigOS/blob/main/docs/alerts.md

[Timer]
OnBootSec=15min
OnUnitActiveSec=15min
RandomizedDelaySec=1min

[Install]
WantedBy=timers.target
