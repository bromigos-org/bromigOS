# Maintainer: bromigOS <packages@bromigos.org>
#
# The bromigos CLI and core library: the Rust workspace in core/ (with `bromigos update`'s
# migrations, migrations/, to /usr/share/bromigos/migrations, a pacman hook that says to
# run it after a bare `pacman -Syu`, and the two that hold Hyprland's auto-reload while a
# transaction replaces the desktop's config), plus the
# themes and templates its `theme` command renders (themes/, theme/templates/ to
# /usr/share/bromigos/; the renderer and the templates version together), and the shared
# Python libs the live layer, the widgets and VECTOR read (lib/ to /usr/lib/bromigos/lib), the
# private overlay's login units (bromigos-private.service and .path), and the
# release notes (the manual's What's new, for `bromigos whats-new`). Rust
# package conventions from the Arch wiki (Rust package guidelines): fetch
# with the lockfile, build and test offline (--frozen), stable toolchain.

pkgname=bromigos-core
pkgver=0.1.0.r112.g9709a13
pkgrel=1
pkgdesc='bromigos: one command for the bromigOS desktop'
arch=('x86_64')
url='https://github.com/bromigos-org/bromigOS'
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc' 'openssl' 'git'   # git: bromigos ext (extensions are checkouts)
         'ethtool')                         # Wake-on-LAN on for wired cards (the udev rule; docs/wake-on-lan.md)
makedepends=('cargo' 'git' 'python')
# openssh: the SSH sign-in's tests sign for real; python-qrcode: bromigos login's QR code
checkdepends=('desktop-file-utils' 'rsync' 'npm' 'openssh' 'python-qrcode' 'python-pillow' 'python-numpy'
              'zbar' 'zxing-cpp')
optdepends=('python: bromigos private, secrets, emblem, console, power menu, splash and local storage'
            'qrencode: the pairing QR in the console welcome tour (bromigos welcome-console)'
            'terminus-font: readable text console font sizes'
            'openssh: bromigos login --ssh, and the SSH keys a new lab box gets from your account'
            'libsecret: keep account sign-ins (bromigos login, bromigos account) in your keyring'
            'python-qrcode: a QR code of the sign-in page in the terminal (bromigos login, bromigos account login)'
            'python-pillow: themed QR codes (bromigos qr, lib/bromigos_qr.py), with python-qrcode'
            'zxing-cpp: themed QR codes checked by decoding them before they are shown (bromigos qr)'
            'oo7: the keyring itself, unlocked by your login (bromigos-desktop brings it; bromigos keyring)'
            'plymouth: graphical shutdown and restart (bromigos splash)'
            'grub: save the graphical splash kernel setting'
            'util-linux: local storage inventory and mounts'
            'btrfs-progs: Btrfs drive preparation and reviewed snapshot cleanup'
            'pacman-contrib: retire selected cached package archives'
            'npm: clean selected user npm content'
            'snapper: discover and retire explicitly selected local snapshots'
            'gptfdisk: partition a planned data drive'
            'rsync: stage and verify local data migrations'
            'sops: the private overlay (bromigos private)'
            'age: the private overlay key (bromigos private)'
            'inkscape: emblem text as outlines (bromigos emblem build)'
            'librsvg: emblem PNGs and the banner braille (bromigos emblem build)'
            'python-gobject: emblem PNGs (bromigos emblem build)'
            'python-cairo: emblem PNGs (bromigos emblem build)'
            'python-pillow: the banner braille (bromigos emblem build)'
            'python-numpy: a world loop from a raw clip (bromigos art make video.loop --alpha)'
            'ffmpeg: a world loop from a raw clip (bromigos art make video.loop --alpha)'
            'python-pychromecast: cast to Chromecasts and Google TVs (bromigos media cast)'
            'python-async-upnp-client: cast to DLNA TVs (bromigos media cast; from the AUR)'
            'smartmontools: drive health in bromigos alerts (disk.smart)'
            'nut: the UPS in bromigos alerts (power.ups)'
            'libnotify: bromigos alerts as desktop notifications (notify-send)')
# The release profile already strips (core/Cargo.toml); no -debug package.
options=('!debug')
# Wake-on-LAN on now for the wired cards already there (bromigos wol apply)
install=$pkgname.install

# Built in-tree from the checkout this PKGBUILD lives in; cargo's output
# goes to $srcdir, so the source tree is only read.
_root="${startdir%/packaging/*}"
_paths=(core bin themes theme lib live/tools/make-mehshell.py migrations manual/src/whats-new.md packaging/bromigos-core LICENSE-MIT LICENSE-APACHE)

# <workspace version>.r<commits touching the package>.g<last such commit>,
# e.g. 0.1.0.r12.g1a2b3c4: rises with every change, and with a version bump
# in core/Cargo.toml.
# The commits that touched _paths before the history restarted at v0.1.2 (they're in
# bromigos-org/bromigOS-archive): the count goes on from them, so no version sorts below one
# published before the restart (packaging/README.md, Versions).
_archived=143

pkgver() {
  cd "$_root"
  local base
  base=$(sed -n '/^\[workspace\.package\]/,/^\[/ s/^version *= *"\(.*\)"/\1/p' core/Cargo.toml)
  printf '%s.r%s.g%s' "${base//-/_}" \
    "$((_archived + $(git rev-list --count HEAD -- "${_paths[@]}")))" \
    "$(git log -1 --format=%h -- "${_paths[@]}" | grep . || echo 0)"
}

prepare() {
  cd "$_root/core"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

# cargo's target directory: $srcdir/target, or a persistent one CI names
# (BROMIGOS_CARGO_TARGET_DIR: the runners' node cache, packaging/ci/prepare-container.sh)
# so a rebuild compiles only what changed.
_target() { printf '%s' "${BROMIGOS_CARGO_TARGET_DIR:-$srcdir/target}"; }

build() {
  cd "$_root/core"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$(_target)"
  cargo build --frozen --release --all-features
}

check() {
  cd "$_root/core"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$(_target)"
  cargo test --frozen --all-features
  # the app launcher's entries (core/applications): desktop-file-validate, the keys every
  # entry needs, their icons (tools/launcher/check.py; CI's launcher.yml runs all of it)
  python -m unittest discover -s "$_root/live/tests" -p test_mehshell.py
  python "$_root/tools/launcher/check.py" --static --only core
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/storage"
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/console"
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/splash"
  # bromigos login: the device flow, SSH sign-in and tokens, against a stand-in service on
  # 127.0.0.1, with throwaway keys, its own ssh-agent and a keyring in memory
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/account"
  # bromigos keyring: the keyring check and the login's PAM lines, on copies in a temporary
  # root, with a stand-in session bus
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/keyring"
  # Wake-on-LAN: the shipped NetworkManager default and udev rule, and bromigos wol
  # against a fake /sys with ethtool and nmcli stood in
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/wake-on-lan"
  # lib/bromigos_drift.py: the DRIFTGLASS shapes Field Kit shares with the installer's TUI (the
  # orb, the emblem, the disk map), from a stand-in bromigos and without one
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/drift"
  # bromigos alerts: every check against stand-in commands and a stand-in root, the custom
  # checks' rules and the desktop notification's dedup (fake notify-send; nothing shown)
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/alerts"
  # lib/bromigos_qr.py: themed QR codes in every world and style, each decoded by zbar and ZXing
  PYTHONPATH="$_root/lib" python -m unittest discover -s "$_root/tests/qr"
}

package() {
  install -Dm0755 -t "$pkgdir/usr/bin/" "$(_target)/release/bromigos"
  # Bluetooth in the terminal (bromigos bluetooth tui; core/crates/bromigos-bt) and the
  # command that runs it; it talks to bromigos-desktop's `bromigos bluetooth session`
  install -Dm0755 "$(_target)/release/bromigos-bt" "$pkgdir/usr/lib/bromigos/bromigos-bt"
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-bluetooth-tui
  # DRIFTGLASS for other TUIs: the theme in force as a Textual theme (the lab console matches
  # the Rust screens with it; core/crates/bromigos-tui)
  install -Dm0755 "$(_target)/release/bromigos-tui-theme" "$pkgdir/usr/lib/bromigos/bromigos-tui-theme"
  # themes/<name>/…, theme/templates/*.tpl and theme/icons/*.svg, as read-only defaults; not the
  # art pipeline's recipe, log and local sources (art.toml, art.log.jsonl, art/). A hologram
  # collection (themes/<name>/holo/, theme/holo/) ships as VECTOR's and the homelab's do: the
  # manifest, the baked models and the README; its sources (src/, concepts/, previews/,
  # generations.jsonl) stay in the repo
  local f
  while IFS= read -r -d '' f; do
    install -Dm0644 "$_root/$f" "$pkgdir/usr/share/bromigos/$f"
  done < <(cd "$_root" && find themes theme/templates theme/icons theme/holo -type f \
    -not -path 'themes/*/art/*' -not -path 'themes/*/art.toml' \
    -not -path 'themes/*/art.log.jsonl' \
    -not \( -path '*/holo/*' -not -path '*/holo/manifest.json' -not -path '*/holo/*.holo.npz' \
    -not -path '*/holo/README.md' \) -print0)
  # bromigos_theme (the palette in force), bromigos_private (the private overlay's reader),
  # bromigos_emblem + emblem_braille (a theme's emblem kit), bromigos_textual (DRIFTGLASS for
  # Textual) and bromigos_drift (the orb, the emblem and the disk map from `bromigos fieldkit
  # shapes`, for the installer's TUI)
  install -Dm0644 -t "$pkgdir/usr/lib/bromigos/lib/" "$_root"/lib/*.py
  # `bromigos private|secrets|emblem|qr …`: the CLI routes to bromigos-<group> here
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-private \
    "$_root"/bin/bromigos-secrets "$_root"/bin/bromigos-emblem "$_root"/bin/bromigos-qr
  # the private overlay decrypted at login, and again when it changes: on for every user
  # (shipped default.target.wants links, as pipewire ships its own), doing nothing for one
  # without the encrypted file or the age key
  local u
  for u in bromigos-private.service bromigos-private.path; do
    install -Dm0644 "$startdir/$u" "$pkgdir/usr/lib/systemd/user/$u"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s "../$u" "$pkgdir/usr/lib/systemd/user/default.target.wants/$u"
  done
  # the menu's INSTALL › Extension… and REMOVE › Extension… (`bromigos ext`, docs/extensions.md)
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-install-extension \
    "$_root"/bin/bromigos-remove-extension
  # `bromigos terminal`: a command in the user's terminal (the launcher's terminal entries)
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-terminal
  # `bromigos account`: sign in to an account a widget uses (lib/bromigos_account.py)
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-account
  # `bromigos login`, `logout` and `whoami`: your Bromigos account (lib/bromigos_login.py)
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-{login,logout,whoami}
  # `bromigos keyring`: the keyring that keeps them, and the login that unlocks it (lib/bromigos_keyring.py)
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-keyring
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-storage
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-console
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-power-menu
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-splash
  # bromigOS Server's welcome tour (Textual, lib/bromigos_textual.py): `bromigos welcome-console`,
  # and once at the first console or SSH sign-in after an install (profile.d)
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-welcome-console
  install -Dm0644 "$_root"/bin/profile.d/bromigos-welcome.sh "$pkgdir/etc/profile.d/bromigos-welcome.sh"
  # the app launcher's entries (docs/menu.md, "In the app launcher")
  install -Dm0644 -t "$pkgdir/usr/share/applications/" "$_root"/core/applications/*.desktop
  # bromigOS's app icons in the hicolor theme every icon theme inherits (theme/app-icons, drawn
  # by theme/tools/build-app-icons.py: a glyph in the burn-in's ring at 16, 24, 32 and scalable)
  local size
  for size in 16x16 24x24 32x32 scalable; do
    install -Dm0644 -t "$pkgdir/usr/share/icons/hicolor/$size/apps/" "$_root"/theme/app-icons/$size/apps/*.svg
  done
  # the canonical burn-in every emblem kit is drawn from
  install -Dm0644 -t "$pkgdir/usr/share/bromigos/emblem/" "$_root"/theme/emblem/identity.json \
    "$_root"/theme/emblem/flame.svg
  python -m compileall -q -o 0 -o 1 -s "$pkgdir" -p / "$pkgdir/usr/lib/bromigos/lib" >/dev/null
  # the release notes, the manual's What's new page: `bromigos whats-new` reads them offline,
  # and `bromigos update` says when a new release came (docs/release.md)
  install -Dm0644 "$_root/manual/src/whats-new.md" "$pkgdir/usr/share/bromigos/whats-new.md"
  # migrations: run once per user, in name order, by `bromigos update` (core/README.md)
  install -Dm0644 -t "$pkgdir/usr/share/bromigos/migrations/" "$_root"/migrations/*.sh
  # create.toml's packaged default and the ComfyUI workflows `bromigos art` runs
  # (built into the binary too; a file of the same name here or in the user's
  # ~/.config/bromigos/create/workflows wins: docs/art.md)
  install -Dm0644 "$_root/core/crates/bromigos-art/create.default.toml" "$pkgdir/usr/share/bromigos/default/create.toml"
  install -Dm0644 "$_root/core/crates/bromigos-art/targets.default.toml" "$pkgdir/usr/share/bromigos/default/targets.toml"
  install -Dm0644 -t "$pkgdir/usr/share/bromigos/art/workflows/" "$_root"/core/crates/bromigos-art/workflows/*.json
  # the world-loop post step `bromigos art make video.loop --alpha` runs (docs/art.md)
  install -Dm0755 "$_root/theme/tools/glow-loop.py" "$pkgdir/usr/share/bromigos/tools/glow-loop.py"
  install -Dm0755 "$_root/live/tools/make-mehshell.py" "$pkgdir/usr/share/bromigos/tools/make-mehshell.py"
  install -Dm0755 "$_root/theme/hooks/theme-set.d/30-mehshell" "$pkgdir/usr/share/bromigos/hooks/theme-set.d/30-mehshell"
  # the idle policy's packaged defaults and the hypridle template `bromigos idle` renders
  # (built into the binary too; these win: docs/idle.md)
  install -Dm0644 "$_root/core/crates/bromigos-core/idle/idle.toml" "$pkgdir/usr/share/bromigos/default/idle.toml"
  install -Dm0644 "$_root/core/crates/bromigos-core/idle/hypridle.conf.tpl" "$pkgdir/usr/share/bromigos/idle/hypridle.conf.tpl"
  install -Dm0644 "$startdir/bromigos-update.hook" "$pkgdir/usr/share/libalpm/hooks/bromigos-update.hook"
  # Wake-on-LAN kept on for wired network cards, on the desktop, bromigOS Server and the
  # Field Kit's installed Server alike (docs/wake-on-lan.md): NetworkManager's default for
  # wired connections, and a udev rule for each wired card as it appears (systemd-networkd
  # and bare consoles too). BRODEC's machine agent takes the rule's presence as "bromigOS
  # keeps Wake-on-LAN on here". `bromigos wol` reads it and turns it on now.
  install -Dm0644 "$startdir/50-bromigos-wake-on-lan.conf" \
    "$pkgdir/usr/lib/NetworkManager/conf.d/50-bromigos-wake-on-lan.conf"
  install -Dm0644 "$startdir/81-bromigos-wake-on-lan.rules" \
    "$pkgdir/usr/lib/udev/rules.d/81-bromigos-wake-on-lan.rules"
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-wol
  # `bromigos alerts` (docs/alerts.md): what needs you, for the desktop's notification and
  # BRODEC's machine agent. The system checks as root (every 15 minutes and after each boot),
  # yours as you (every 30 minutes, and the notification): on for everyone, as shipped links
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/bin/" "$_root"/bin/bromigos-alerts
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/system/" "$startdir"/bromigos-alerts.{service,timer} \
    "$startdir"/bromigos-alerts-boot.{service,timer}
  install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../bromigos-alerts.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/bromigos-alerts.timer"
  ln -s ../bromigos-alerts-boot.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/bromigos-alerts-boot.timer"
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/user/" "$startdir"/bromigos-alerts-user.{service,timer} \
    "$startdir"/bromigos-alerts-notify.{service,path}
  install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants" "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../bromigos-alerts-user.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/bromigos-alerts-user.timer"
  ln -s ../bromigos-alerts-notify.path "$pkgdir/usr/lib/systemd/user/default.target.wants/bromigos-alerts-notify.path"
  # Hyprland's auto-reload held off while a transaction replaces the desktop's default
  # config, then one verified reload (bromigos session hold|release; docs/update.md)
  install -Dm0644 -t "$pkgdir/usr/share/libalpm/hooks/" \
    "$startdir/bromigos-hypr-hold.hook" "$startdir/bromigos-hypr-release.hook"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" \
    "$_root/LICENSE-MIT" "$_root/LICENSE-APACHE"
}
