# bromigOS: after a kernel or a driver built outside it (NVIDIA's, anything DKMS builds) is
# installed, upgraded or removed, the checks that run after each boot run again, in the
# background: the black screen check among them (docs/alerts.md). So a driver that isn't built
# for the new kernel is raised before the restart, not after it. "zz": hooks run in their
# files' name order, and this one looks after DKMS built its modules, mkinitcpio made the
# startup files and Secure Boot signed them. Nothing where the alerts' timer isn't running:
# alerts turned off, a chroot, an image being built. Never fails the transaction.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/extramodules/*
Target = usr/src/*/dkms.conf

[Action]
Description = Checking that the next start reaches the desktop (in the background)...
When = PostTransaction
Exec = /bin/sh -c 'systemctl -q is-active bromigos-alerts.timer >/dev/null 2>&1 && systemctl start --no-block bromigos-alerts-boot.service >/dev/null 2>&1; exit 0'
