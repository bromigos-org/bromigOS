# Maintainer: bromigOS <packages@bromigos.org>
#
# herdr, the terminal workspace for AI coding agents: bromigOS's Swarm deck and the
# worlds' agent creatures (the Choir, the Sleepers) read its agents. Not in Arch's
# repositories; built here from the tagged upstream source (pinned by checksum) so an
# install never needs an AUR helper. Adapted from the AUR's herdr PKGBUILD. AGPL-3.0:
# unmodified upstream source, linked below.
#
# Zig: herdr's vendored libghostty-vt builds with zig 0.16.0 exactly, while Arch's zig
# has moved on to 0.17.0, and our CI installs makedepends with `pacman -S`,
# which takes no version. So the build brings its own: Zig's official 0.16.0 release for
# x86_64 Linux, pinned by checksum, used only inside $srcdir and never installed. When
# upstream moves to Arch's zig, drop it and put 'zig' back in makedepends.

pkgname=herdr
pkgver=0.9.5
pkgrel=1
pkgdesc='Terminal workspace manager for AI coding agents'
arch=('x86_64')
url='https://github.com/ogulcancelik/herdr'
license=('AGPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
_zigver=0.16.0
makedepends=('cargo' 'git')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/ogulcancelik/herdr/archive/refs/tags/v${pkgver}.tar.gz"
        "https://ziglang.org/download/${_zigver}/zig-x86_64-linux-${_zigver}.tar.xz")
sha256sums=('a2486b09a8153630f6a19e72606ba1c961a6194bce13c09cba67ccce5e4252de'
            '70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00')

# The pinned zig, first on PATH and named by $ZIG (which libghostty-vt's build.rs reads)
_env() {
  export CARGO_HOME="$srcdir/cargo-home" ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
  export ZIG="$srcdir/zig-x86_64-linux-$_zigver/zig"
  export PATH="${ZIG%/*}:$PATH"
}

prepare() {
  _env
  local zv
  zv=$("$ZIG" version)
  [[ $zv == "$_zigver" ]] || { echo "herdr needs zig $_zigver, found $zv" >&2; return 1; }
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
  cd vendor/libghostty-vt
  local i
  for i in 1 2 3; do "$ZIG" build --fetch=all && return 0; sleep 2; done
  return 1
}

build() {
  cd "$pkgname-$pkgver"
  _env
  export HERDR_BUILD_CHANNEL=stable CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/herdr "$pkgdir/usr/bin/herdr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -d "$pkgdir/usr/share/bash-completion/completions" "$pkgdir/usr/share/zsh/site-functions"
  target/release/herdr completion bash > "$pkgdir/usr/share/bash-completion/completions/herdr"
  target/release/herdr completion zsh > "$pkgdir/usr/share/zsh/site-functions/_herdr"
}
