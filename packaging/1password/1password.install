# The onepassword group: the browser-support helper runs setgid to it (1Password's own
# install does the same). Don't add users to it.
GROUP_NAME="onepassword"

app_group_exists() {
    getent group "$GROUP_NAME" >/dev/null
}

setup_browser_helper() {
    chgrp "$GROUP_NAME" /opt/1Password/1Password-BrowserSupport
    chmod g+s /opt/1Password/1Password-BrowserSupport
}

pre_install() {
    app_group_exists || groupadd "$GROUP_NAME"
}

post_install() {
    setup_browser_helper
    echo "1Password: for system-authentication unlock, run: sudo /opt/1Password/install_biometrics_policy.sh"
}

pre_upgrade() {
    pre_install
}

post_upgrade() {
    setup_browser_helper
}

post_remove() {
    app_group_exists && groupdel "$GROUP_NAME" || true
}
