# Maintainer: bromigOS <packages@bromigos.org>
#
# bromigOS's boot menu and text console (docs/boot.md, docs/console.md), on every edition,
# the desktop and Field Kit alike (no desktop needed):
#
#   /usr/share/bromigos/boot/grub/          the boot menu: a GRUB theme per shipped theme
#                                           (themes/<name>/, rendered here, with colors.cfg for
#                                           GRUB's editor and console) and Geist Mono as GRUB
#                                           fonts (fonts/)
#   /usr/lib/bromigos/boot/                 its generator (a user's own theme, high contrast),
#                                           the root helper that puts one in /boot, grub-btrfs's
#                                           snapshot titles, and bromigos-fieldkit-boot (the
#                                           Field Kit's copy on /boot)
#   /etc/grub.d/11_bromigos-options         "Advanced boot options": text mode, safe graphics,
#                                           without a graphics driver, verbose, a snapshot, Field Kit
#   /etc/grub.d/42_bromigos-fieldkit        "bromigOS Field Kit", when its copy is on /boot
#   /usr/share/libalpm/hooks/               the theme in /boot and the entries kept current
#   /usr/share/kbd/consolefonts/bromigos-geist-{16,24,32}.psf.gz   Geist Mono for the console
#   /usr/share/bromigos/console/palette.vtrgb  the console's 16 colours (DRIFTGLASS, the Wick's)
#   /usr/lib/bromigos/console/              the console's setup (colours, font by screen size)
#                                           and its notes (text mode, the graphics didn't start)
#   bromigos-console.service, 91-bromigos-console.rules   run that setup at boot and when a
#                                           graphics driver takes the screen over
#   /usr/share/bromigos/console/kmscon/    kmscon's settings (Geist Mono, DRIFTGLASS in true colour)
#                                           and kmsconvt@.service.d/bromigos.conf, which uses them
#                                           where an edition turns kmscon on (Field Kit, Server)
#   sddm.service.d/bromigos-graphics.conf   no graphics: the text console with a note, never
#                                           a black screen
#   /usr/lib/issue.d/60-bromigos.issue      the text console login banner

pkgname=bromigos-boot
pkgver=0.0.0
pkgrel=1
pkgdesc='bromigOS boot menu and text console: the GRUB theme, advanced boot options, the Field Kit entry, the console font and colours'
arch=('any')
url='https://github.com/bromigos-org/bromigOS'
license=('MIT OR Apache-2.0')
# python-pillow: the root helper writes a user's theme.txt with the generator; kbd: setfont,
# setvtrgb; util-linux>=2.41: agetty reads /usr/lib/issue.d even with an /etc/issue
depends=('python' 'python-pillow' 'kbd' 'util-linux>=2.41')
makedepends=('git' 'python' 'python-pillow' 'grub')
optdepends=('grub: the Bromigos boot menu (bromigos boot theme on) and its advanced options'
            'grub-btrfs: snapshots in the boot menu, titled like bromigOS'"'"'s rollback list'
            'bromigos-fieldkit: bromigOS Field Kit in the boot menu (when /boot has room)'
            'kmscon: the rich console (true colour, Geist Mono) on Field Kit and bromigOS Server'
            'ttf-geist-mono: Geist Mono for kmscon')
# the boot menu and the console banner moved here from bromigos-settings (0.1.3): an update
# brings both, and pacman lets the files change owner within the one transaction
_geist=1.7.2
source=("geist-font-v${_geist}.zip::https://github.com/vercel/geist-font/releases/download/v${_geist}/geist-font-v${_geist}.zip")
sha256sums=('7fc800d2ac6b92844895196e5041aca55d814c15db70c44f79b3b83ab82b04e2')
options=('!debug')

_root="${startdir%/packaging/*}"
# themes/: every shipped theme's boot menu is rendered here, from its colours, art and emblem
_paths=(settings/grub settings/console themes desktop/wallpaper packaging/bromigos-boot LICENSE-MIT LICENSE-APACHE)
_archived=0

pkgver() {
  cd "$_root"
  local base
  base=$(sed -n '/^\[workspace\.package\]/,/^\[/ s/^version *= *"\(.*\)"/\1/p' core/Cargo.toml)
  printf '%s.r%s.g%s' "${base//-/_}" \
    "$((_archived + $(git rev-list --count HEAD -- "${_paths[@]}")))" \
    "$(git log -1 --format=%h -- "${_paths[@]}" | grep . || echo 0)"
}

build() {
  local gen="$_root/settings/grub/build-grub-theme.py" t ttf="$srcdir/geist-font/GeistMono/ttf"
  # the boot menu: Geist Mono as GRUB fonts, then a theme per shipped theme (docs/boot.md)
  python "$gen" --fonts-out "$srcdir/boot/fonts" --font-dir "$ttf"
  for t in "$_root"/themes/*/; do
    [[ -f "$t/colors.toml" ]] || continue
    BROMIGOS_SHARE_DIR=/nonexistent python "$gen" --theme-dir "$t" --no-fonts \
      --out "$srcdir/boot/themes/$(basename "$t")"
  done
  # the text console: Geist Mono as console fonts, the Wick's terminal colours as its palette
  python "$_root/settings/console/build-console-font.py" --font-dir "$ttf" --out "$srcdir/console"
}

check() {
  cd "$_root"
  python -m unittest discover -s settings/grub/tests
  python -m unittest discover -s settings/console/tests
}

package() {
  local boot="$pkgdir/usr/share/bromigos/boot/grub" lib="$pkgdir/usr/lib/bromigos/boot"
  local con="$_root/settings/console" grub="$_root/settings/grub"
  install -d "$boot"
  cp -r "$srcdir/boot/themes" "$srcdir/boot/fonts" "$boot/"
  find "$boot" -type d -exec chmod 0755 {} + ; find "$boot" -type f -exec chmod 0644 {} +
  install -Dm0644 "$grub/build-grub-theme.py" "$lib/build-grub-theme.py"
  install -Dm0755 -t "$lib/" "$grub/bromigos-boot-theme" "$grub/grub-btrfs-titles" "$grub/bromigos-fieldkit-boot"
  install -Dm0755 -t "$pkgdir/etc/grub.d/" "$grub/11_bromigos-options" "$grub/42_bromigos-fieldkit"
  install -Dm0644 -t "$pkgdir/usr/share/libalpm/hooks/" "$grub/bromigos-boot-theme.hook" "$grub/bromigos-boot-menu.hook"
  # the text console
  install -Dm0644 -t "$pkgdir/usr/share/kbd/consolefonts/" "$srcdir"/console/bromigos-geist-*.psf.gz
  install -Dm0644 "$srcdir/console/palette.vtrgb" "$pkgdir/usr/share/bromigos/console/palette.vtrgb"
  install -Dm0755 -t "$pkgdir/usr/lib/bromigos/console/" "$con/bromigos-console-setup" "$con/bromigos-console-hint" \
    "$con/bromigos-console-login"
  install -Dm0644 "$srcdir/console/kmscon.conf" "$pkgdir/usr/share/bromigos/console/kmscon/kmscon.conf"
  install -Dm0644 "$con/kmsconvt-bromigos.conf" "$pkgdir/usr/lib/systemd/system/kmsconvt@.service.d/bromigos.conf"
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/system/" "$con/bromigos-console.service" \
    "$con/bromigos-text-mode.service" "$con/bromigos-no-graphics.service"
  install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants" "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../bromigos-console.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/bromigos-console.service"
  ln -s ../bromigos-text-mode.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/bromigos-text-mode.service"
  install -Dm0644 "$con/sddm-bromigos-graphics.conf" "$pkgdir/usr/lib/systemd/system/sddm.service.d/bromigos-graphics.conf"
  install -Dm0644 "$con/91-bromigos-console.rules" "$pkgdir/usr/lib/udev/rules.d/91-bromigos-console.rules"
  install -Dm0644 "$con/60-bromigos.issue" "$pkgdir/usr/lib/issue.d/60-bromigos.issue"
  install -Dm0644 "$srcdir/geist-font/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/OFL-geist-mono.txt"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_root/LICENSE-MIT" "$_root/LICENSE-APACHE"
}
