# BRODEC's lab bridge: what this lab is called and where VECTOR looks. Read by the service and
# by the brodec-lab command. Leave a line commented out to skip that source. No secrets here:
# a token or key goes in its own file, named by a *_FILE line, readable by brodec-lab only.

# The lab's name, as BRODEC shows it.
BRODEC_LAB_NAME=my-lab

# Prometheus and Alertmanager, if the lab has them.
#BRODEC_LAB_PROMETHEUS_URL=http://prometheus.example.org:9090
#BRODEC_LAB_ALERTMANAGER_URL=http://alertmanager.example.org:9093

# A lab status page with the lab status API, and its read-only token.
#BRODEC_LAB_API_URL=https://status.example.org
#BRODEC_LAB_API_TOKEN_FILE=/etc/brodec-lab/lab-api-token

# VECTOR's brain: any OpenAI-compatible API in your lab (Ollama, vLLM, LiteLLM), ending in /v1.
# Without one he still reports, and says he has no brain in this lab yet.
#BRODEC_BRAIN_URL=http://localhost:11434/v1
#BRODEC_BRAIN_MODEL=llama3.1:8b
#BRODEC_BRAIN_KEY_FILE=/etc/brodec-lab/brain-key

# The brain for guests (people you share the lab with as Can ask). VECTOR never answers them
# with the brain above, which may have your tools or memory; he tells this one only the lab's
# report. It must have no tools of its own: a plain model API. Without one, guests get a polite
# "can't answer". If the brain above is a plain model API, these may be the same values.
#BRODEC_GUEST_BRAIN_URL=http://localhost:11434/v1
#BRODEC_GUEST_BRAIN_MODEL=llama3.1:8b
#BRODEC_GUEST_BRAIN_KEY_FILE=/etc/brodec-lab/guest-brain-key

# The homeserver. Change it only if you were told to.
#BRODEC_HOMESERVER=https://matrix.bromigos.org

# BROADCAST: the lab media server (brodec-lab-media.service, needs the mediamtx package). The
# bridge hands out a key per stream and a token per viewer; MediaMTX asks it about every
# connection. Streams are encrypted on the way but not end-to-end like messages. Every address
# must be on your private network (your tailnet or LAN); nothing is offered to the internet.
# Its control API, on this machine only (mediamtx.yml's apiAddress). Unset: no streaming.
#BRODEC_STREAM_API_URL=http://127.0.0.1:9997
# Where MediaMTX asks the bridge about each connection (mediamtx.yml's authHTTPAddress).
#BRODEC_STREAM_AUTH_LISTEN=127.0.0.1:9108
# This machine's address on your private network, as phones and OBS reach it: its tailnet
# address (100.64.x.y) or name (*.ts.net), or a LAN address.
#BRODEC_STREAM_HOST=100.64.0.7
# A LAN address for game consoles, which can't join a tailnet (RTMP).
#BRODEC_STREAM_LAN_HOST=192.168.1.20
# Ports, if you changed them in mediamtx.yml.
#BRODEC_STREAM_RTMP_PORT=1935
#BRODEC_STREAM_SRT_PORT=8890
#BRODEC_STREAM_WEBRTC_PORT=8889
#BRODEC_STREAM_HLS_PORT=8888
# on: mediamtx.yml has a TURN relay, so people away from your network can watch.
#BRODEC_STREAM_RELAY=on
# on: recordings are kept (mediamtx.yml's recordPath, playback: true).
#BRODEC_STREAM_RECORD=on
# Streams at once, and viewers per stream.
#BRODEC_STREAM_MAX_STREAMS=1
#BRODEC_STREAM_MAX_VIEWERS=10
# on: people you share the lab with as Can ask may go live too.
#BRODEC_STREAM_GUESTS=on
# What the lab can transcode: none (pass-through), opus (sound for WebRTC; needs ffmpeg) or abr
# (a quality ladder; needs a GPU).
#BRODEC_STREAM_TRANSCODE=none
