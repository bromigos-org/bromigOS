# Maintainer: bromigOS <packages@bromigos.org>
#
# bromigOS, the whole of it: `pacman -S bromigos` (or `bromigos install`) on Arch gives the
# desktop (bromigos-desktop: Hyprland, the bar, the lock screen and the session's
# plumbing), the live layer and its worlds, the widgets, VECTOR, the login screen, the
# fonts and the theme, and the manual to read offline. The homelab integrations are
# optional (bromigos-homelab).

pkgname=bromigos
pkgver=0.0.0
pkgrel=1
pkgdesc='bromigOS: holograms, homelab integrations, living themes and widgets on Arch and Hyprland'
arch=('any')
url='https://github.com/bromigos-org/bromigOS'
license=('MIT OR Apache-2.0')
depends=('bromigos-keyring' 'bromigos-core' 'bromigos-desktop' 'bromigos-settings'
         'bromigos-live' 'bromigos-widgets' 'bromigos-vector' 'bromigos-manual')
optdepends=('bromigos-homelab: the homelab integrations (cluster, GitOps, metrics, models, agents)'
            'bromigos-apps: the app bundle (LazyVim, tmux, lazygit, mise, Chromium, Spotify, Signal), configured and themed'
            'herdr: the agents the Swarm deck and the worlds show'
            'paru: AUR packages, updated by bromigos update (bromigos install installs it; docs/aur.md)'
            'ollama: a local brain for VECTOR'
            'uv: VECTOR builds its voice and brain environments with it'
            'bluez: Bluetooth'
            'bluez-utils: Bluetooth from the terminal (bluetoothctl)'
            'brightnessctl: the brightness keys'
            'btop: the bar CPU/memory click'
            'pavucontrol: the bar volume click'
            'pcmanfm: the default file manager bind'
            'swappy: annotate a screenshot from its notification'
            'wf-recorder: screen recording'
            'zoxide: frecent folders (z) and WORKBENCH')
makedepends=('git')
options=('!debug')

_root="${startdir%/packaging/*}"
_paths=(packaging/bromigos LICENSE-MIT LICENSE-APACHE)

# The commits that touched _paths before the history restarted at v0.1.2 (they're in
# bromigos-org/bromigOS-archive): the count goes on from them, so no version sorts below one
# published before the restart (packaging/README.md, Versions).
_archived=5

pkgver() {
  cd "$_root"
  local base
  base=$(sed -n '/^\[workspace\.package\]/,/^\[/ s/^version *= *"\(.*\)"/\1/p' core/Cargo.toml)
  printf '%s.r%s.g%s' "${base//-/_}" \
    "$((_archived + $(git rev-list --count HEAD -- "${_paths[@]}")))" \
    "$(git log -1 --format=%h -- "${_paths[@]}" | grep . || echo 0)"
}

package() {
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_root/LICENSE-MIT" "$_root/LICENSE-APACHE"
}
