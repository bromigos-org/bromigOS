# Maintainer: bromigOS <packages@bromigos.org>
#
# STATIC's art (mascot/): the painted shells that host Den TV's guide.
# Painted and animated on licence-clean models (mascot/README.md; docs/ASSETS.md, "STATIC,
# the mascot"); no code. The apps find it by its manifests and fall back to the code-drawn
# placeholder without it. bromigos depends on it; `bromigos mascot off` turns him off.
#
#   /usr/share/bromigos/static/        manifest.json and the guide's loops (lib/bromigos_static_art.py)

pkgname=bromigos-mascot-art
pkgver=0.1.3.r1.g421add4
pkgrel=1
pkgdesc="bromigOS mascot art: STATIC's painted shells hosting Den TV's guide"
arch=('any')
url='https://github.com/bromigos-org/bromigOS'
license=('MIT OR Apache-2.0')
makedepends=('git' 'python')
checkdepends=('python')
options=('!debug' '!strip')

_root="${startdir%/packaging/*}"
_paths=(mascot packaging/bromigos-mascot-art LICENSE-MIT LICENSE-APACHE)

# <workspace version>.r<commits touching the package>.g<last such commit> (as bromigos-core)
pkgver() {
  cd "$_root"
  local base
  base=$(sed -n '/^\[workspace\.package\]/,/^\[/ s/^version *= *"\(.*\)"/\1/p' core/Cargo.toml)
  printf '%s.r%s.g%s' "${base//-/_}" \
    "$(git rev-list --count HEAD -- "${_paths[@]}")" \
    "$(git log -1 --format=%h -- "${_paths[@]}" | grep . || echo 0)"
}

check() {
  cd "$_root"
  # every manifest parses, and every file it names is in the package (no missing clip ships)
  python - <<'PY'
import json, os
for manifest, key in (("mascot/static/manifest.json", "art"),):
    doc = json.load(open(manifest))
    assert doc["schema"] == 1, manifest
    base = os.path.dirname(manifest)
    if key == "art":
        files = [f for e in doc["art"].values() for h, f in e.items() if h.isdigit()]
    else:
        files = [b[k] for b in doc["bumps"] for k in ("file", "sting") if b.get(k)]
    for f in files:
        assert os.path.isfile(os.path.join(base, f)), (manifest, f)
PY
}

package() {
  local f
  for f in "$_root"/mascot/static/manifest.json "$_root"/mascot/static/*.webp; do
    install -Dm0644 "$f" "$pkgdir/usr/share/bromigos/static/$(basename "$f")"
  done
  install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" "$_root/mascot/README.md" "$_root/mascot/provenance.jsonl"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_root/LICENSE-MIT" "$_root/LICENSE-APACHE"
}
