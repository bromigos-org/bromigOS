# After an automatic update and its restart: did the system come back healthy? If not, the
# update is rolled back and the server restarts, once (docs/server.md, "When an update goes wrong").
[Unit]
Description=bromigOS Server health check after an update
Wants=network-online.target
After=multi-user.target network-online.target
ConditionPathExists=/var/lib/bromigos/server/update.json

[Service]
Type=oneshot
ExecStart=/usr/lib/bromigos/server/bromigos-server health
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
