BASE_UNITS = ["bromigos-server-firewall.service", "bromigos-server-health.service", "bromigos-server-mark-boot.service",
              "prometheus-node-exporter.service", "podman.socket", "kmsconvt@tty1.service",
              "sshguard.service", "smartd.service", "avahi-daemon.service", "apparmor.service",
              "systemd-timesyncd.service", "podman-auto-update.timer", "bromigos-server-backup.timer",
              "bromigos-server-backup-check.timer", "bromigos-server-ups.service"]


def cmd_setup(a):
    """The settings applied: SSH's password rule, the firewall, the exporter's folder, the
    timers and the consoles, the boot menu, .local names, and every role that's on. Safe to
    run again; the package's install runs it."""
    c = config()
    done = []
    # SSH's password rule: this file is setup's own only when it says so; one the installer wrote
    # (the same name, its own words) is left as it is, as are its other drop-ins (01-keys-only,
    # 20-limits), its sysctl and journald files (90-…, after the package's 60-…) and
    # /etc/bromigos/server/nftables.d
    pw = at(SSHD_PASSWORD)
    mine = "# bromigOS Server: password sign-in was chosen at install (/etc/bromigos/server.toml, [ssh] password)"
    try:
        ours = open(pw).read().startswith(mine)
    except OSError:
        ours = None                             # not there
    if c["ssh"]["password"]:
        if ours is not False:
            os.makedirs(os.path.dirname(pw), exist_ok=True)
            with open(pw, "w") as f:
                f.write(mine + "\nPasswordAuthentication yes\nKbdInteractiveAuthentication yes\n")
        done.append("SSH: keys and passwords")
    else:
        if ours:
            os.unlink(pw)
        done.append("SSH: keys only" if ours is not False else "SSH: the installer's own rule kept")
    os.makedirs(at("/opt/bromigos-monitoring/textfile"), mode=0o755, exist_ok=True)
    units = list(BASE_UNITS)
    if c["updates"]["mode"] != "off":
        units.append("bromigos-server-update.timer")
    # the monthly scrub of /, only where / is btrfs (elsewhere it would fail every month)
    if root_fstype() == "btrfs":
        units.append("btrfs-scrub@-.timer")
    if ROOT == "/":
        rc, _, err = run(["systemctl", "enable", *units])
        done.append("enabled: " + ", ".join(units) if rc == 0 else f"systemctl enable: {err.strip()}")
        if c["updates"]["mode"] == "off":
            run(["systemctl", "disable", "bromigos-server-update.timer"])
        # kmscon takes the first console (getty@tty1 conflicts with it, and comes back on its
        # own when kmscon can't start: kmsconvt@'s OnFailure, the plain console's fallback)
        run(["systemctl", "disable", "getty@tty1.service"])
    done.append(setup_boot(c))
    line = setup_nsswitch()
    if line:
        done.append(line)
    # the roles that are on, again (the installer writes [roles] enabled, then runs setup)
    others = {split_entry(e)[0] for e in c["roles"]["enabled"]}
    for entry, r in enabled_roles(c):
        try:
            for line in apply_role(r, c, others - {r["id"]}):
                done.append(f"{r['title']}: {line}")
        except RoleError as e:
            done.append(f"{r['title']}: not applied: {e}")
    if ROOT == "/" and live():
        # running now (not in an installer's chroot): the firewall loads at once
        run(["systemctl", "restart", "bromigos-server-firewall.service"])
        if unit_state("sshd.service") == "active":
            run(["systemctl", "reload", "sshd.service"])
    for line in done:
        print(f"bromigos-server: {line}")
    return 0


def chrooted():
    try:
        return os.stat("/").st_ino != os.stat("/proc/1/root/.").st_ino
    except OSError:
        return True


# ------------------------------------------------------------------ updates and their health

def gateway():
    rc, out, _ = run(["ip", "-j", "route", "show", "default"])
    try:
        rows = json.loads(out or "[]") if rc == 0 else []
    except ValueError:
        rows = []
    return rows[0].get("gateway") if rows else None


def news_items(timeout=20):
    """Arch Linux's news feed, newest first: [{title, link, published, ts}]. None when it can't
    be read (no network, the site down): then nothing is held."""
    import email.utils
    import urllib.request
    import xml.etree.ElementTree as ET
    try:
        with urllib.request.urlopen(NEWS_FEED, timeout=timeout) as r:
            data = r.read(2_000_000)
        root = ET.fromstring(data)
    except (OSError, ValueError, ET.ParseError):
        return None
    items = []
    for it in root.iter("item"):
        try:
            when = email.utils.parsedate_to_datetime(it.findtext("pubDate") or "")
        except (TypeError, ValueError):
            continue
        items.append({"title": (it.findtext("title") or "").strip(), "link": (it.findtext("link") or "").strip(),
                      "published": when.isoformat(), "ts": when.timestamp()})
    return sorted(items, key=lambda i: -i["ts"])


def last_upgrade_ts():
    """When pacman last finished a transaction (its log), or None."""
    when = None
    try:
        with open(at(PACMAN_LOG), errors="replace") as f:
            for line in f:
                if "transaction completed" in line:
                    m = re.match(r"\[([^\]]+)\]", line)
                    if m:
                        try:
                            when = datetime.datetime.fromisoformat(m.group(1)).timestamp()
                        except ValueError:
                            pass
    except OSError:
        pass
    return when


def news_hold(prev):
    """The news items published since the last update that nobody has read for this server, or []."""
    items = news_items()
    if not items:
        return []
    since = max([t for t in (prev.get("last_success_ts"), prev.get("news_seen_ts"), last_upgrade_ts()) if t] or [time.time()])
    return [{k: i[k] for k in ("title", "link", "published")} for i in items if i["ts"] > since][:5]


def window_of(c):
    """[updates] window as (start, end) minutes after midnight, or None (any time)."""
    m = re.fullmatch(r"\s*(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})\s*", str(c["updates"].get("window") or ""))
    if not m:
        return None
    a, b, x, y = (int(v) for v in m.groups())
    return (a * 60 + b) % 1440, (x * 60 + y) % 1440


def in_window(c, t=None):
    """Whether now (or t, a struct_time) is inside [updates] window; no window: always."""
    w = window_of(c)
    if not w:
        return True
    t = t or time.localtime(float(os.environ.get("BROMIGOS_SERVER_NOW", time.time())))
    m = t.tm_hour * 60 + t.tm_min
    start, end = w
    return start <= m < end if start < end else (m >= start or m < end)


def restart_for_update(st, c, a):
    """A new kernel or driver needs a restart: now, when a person asked (--now) or the window
    is open; else it waits for the window (the timer's next run in it). A lab node whose lab
    restarts its machines one at a time (cluster_reboots) leaves it to the lab: kured's
    /run/reboot-required."""
    if c["updates"]["cluster_reboots"] and cluster()["joined"]:
        try:
            open(at(REBOOT_REQUIRED), "w").close()
        except OSError:
            pass
        st.update(phase="reboot-waiting", reason="the lab restarts its machines one at a time; it restarts this one")
        save_state(st)
        print("bromigos-server: updated; the lab restarts this server when its turn comes, then it's checked")
        return 0
    if not a.now and not in_window(c):
        st.update(phase="reboot-waiting", reason=f"the restart waits for the window ({c['updates']['window']})")
        save_state(st)
        print(f"bromigos-server: updated; the restart it needs waits for the window ({c['updates']['window']})")
        return 0
    st["phase"] = "reboot"
    save_state(st)
    print("bromigos-server: updated; the new kernel or driver needs a restart: restarting to check it")
    run(["systemctl", "reboot"])
    return 0


def download_only(st, c):
    """[updates] mode = download: fetch what the update would install, then wait for a person
    (BRODEC's Update on the phone, or update --now). Nothing is installed."""
    rc, out, err = run(["pacman", "-Syuw", "--noconfirm"], timeout=3 * 3600)
    if rc != 0:
        st.update(phase="failed", finished=now(), finished_ts=time.time(),
                  reason="the download didn't finish: " + last_line(err or out, "pacman -Syuw failed"))
        save_state(st)
        remember({"event": "failed", "reason": st["reason"]})
        print(f"bromigos-server: {st['reason']}", file=sys.stderr)
        return 1
    _, out, _ = run(["pacman", "-Qu"])
    pkgs = [line.split()[0] for line in out.splitlines() if line.strip()]
    if not pkgs:
        st.update(phase="nothing", finished=now(), finished_ts=time.time(), reason="", last_success_ts=time.time())
        st.pop("waiting", None)
        save_state(st)
        print(f"bromigos-server: {PHASE_WORDS['nothing']}")
        return 0
    st.update(phase="waiting", waiting={"since": now(), "packages": pkgs, "notify": bool(c["updates"]["notify"])})
    save_state(st)
    remember({"event": "downloaded", "packages": len(pkgs)})
    print(f"bromigos-server: {len(pkgs)} update(s) downloaded, waiting for you: BRODEC's Update on your phone, "
          "or sudo bromigos server update --now")
    return 0


def cmd_update(a):
    c = config()
    if c["updates"]["mode"] == "off" and not a.now:
        print("bromigos-server: automatic updates are off (/etc/bromigos/server.toml, [updates] mode)")
        return 0
    if c["updates"]["channel"] not in CHANNELS:
        print(f"bromigos-server: the {c['updates']['channel']!r} channel isn't here yet: updating from live Arch",
              file=sys.stderr)
    st = load_state()
    # an update that waited for the window to restart: the window is open now
    if st.get("phase") == "reboot-waiting" and not c["updates"]["cluster_reboots"] and (a.now or in_window(c)):
        st["phase"] = "reboot"
        save_state(st)
        print("bromigos-server: restarting for the update that waited for the window")
        run(["systemctl", "reboot"])
        return 0
    if st.get("phase") in ("verify", "reboot", "updating", "reboot-waiting") and not a.now:
        print(f"bromigos-server: the last update is still being checked ({st['phase']}); not starting another")
        return 0
    prev = st
    if not a.now and c["updates"]["news_hold"]:
        news = news_hold(prev)
        if news:
            prev["hold"] = {"since": now(), "items": news}
            save_state(prev)
            remember({"event": "held", "news": news[0]["title"], "link": news[0]["link"]})
            print(f"bromigos-server: holding the update: Arch Linux news since the last one asks to be read first: "
                  f"{news[0]['title']} ({news[0]['link']}). Read it, then: sudo bromigos server update --now")
            return 0
    # carried from one update to the next: when one last succeeded, and the news a person has
    # read (an update with --now is someone deciding: what's published until now is read)
    carry = {k: prev[k] for k in ("last_success_ts", "news_seen_ts") if k in prev}
    if a.now:
        carry["news_seen_ts"] = time.time()
    if c["updates"]["mode"] == "download" and not a.now:
        return download_only(dict(carry, started=now(), started_ts=time.time()), c)
    st = dict(carry, phase="updating", started=now(), started_ts=time.time(), gateway=gateway(),
              sshd=unit_state("sshd.service") == "active", boots=0, btrfs_errors=btrfs_errors()["total"])
    save_state(st)
    rc, out, err = run(["bromigos", "update", "--yes", "--no-aur", "--json"], timeout=3 * 3600)
    try:
        doc = json.loads(out.strip().splitlines()[-1]) if out.strip() else {}
    except ValueError:
        doc = {}
    rep = doc.get("report") or {}
    st["packages"] = [p.get("name") for p in rep.get("packages", [])]
    pair = rep.get("snapshot") or {}
    st["pre"], st["post"] = pair.get("pre"), pair.get("post")
    st["kernel"] = bool((rep.get("reboot") or {}).get("kernel") or (rep.get("reboot") or {}).get("driver"))
    if not st["packages"]:
        st.update(phase="nothing" if rc == 0 else "failed", finished=now(), finished_ts=time.time(),
                  reason="" if rc == 0 else (err.strip().splitlines() or ["bromigos update failed"])[-1])
        if rc == 0:
            st["last_success_ts"] = time.time()
        save_state(st)
        remember({"event": st["phase"]})
        print(f"bromigos-server: {PHASE_WORDS[st['phase']]}")
        return 0 if rc == 0 else 1
    remember({"event": "updated", "packages": len(st["packages"]), "pre": st["pre"], "post": st["post"],
              "kernel": st["kernel"]})
    if st["kernel"] and c["updates"]["reboot"]:
        return restart_for_update(st, c, a)
    st["phase"] = "verify"
    save_state(st)
    return cmd_health(a, booted=False)


def failed_units(ignore):
    rc, out, _ = run(["systemctl", "list-units", "--state=failed", "--plain", "--no-legend", "--no-pager"])
    units = [line.split()[0] for line in out.splitlines() if line.strip()]
    return [u for u in units if u not in ignore and u not in NOT_THE_UPDATE]


def check_health(st, c):
    """(healthy, reasons). Healthy means, all of these:
      - startup finished (the system manager is "running", or "degraded" only by ignored units);
      - no unit failed, except those in [health] ignore_units;
      - NetworkManager and the firewall run, and sshd runs if it ran before the update;
      - each role that's on has its units running (health), and those it gets later
        (health_optional, such as k3s) once they're installed;
      - no btrfs device counted a new error since the update began;
      - the network is back: an address, and the gateway it had before answers (when it had one)."""
    reasons = []
    rc, out, _ = run(["systemctl", "is-system-running"])
    state = out.strip()
    failed = failed_units(set(c["health"]["ignore_units"]))
    if state in ("initializing", "starting"):
        reasons.append(f"startup hasn't finished ({state})")
    if failed:
        reasons.append("failed to start: " + ", ".join(failed[:8]))
    roles_must, roles_later = role_health(c)
    must = list(MUST_RUN) + (["sshd.service"] if st.get("sshd") else []) + roles_must
    must += [u for u in roles_later if unit_exists(u)]
    down = [u for u in dict.fromkeys(must) if unit_state(u) != "active"]
    if down:
        reasons.append("not running: " + ", ".join(down))
    for name, ok_, words in health_scripts():
        if not ok_:
            reasons.append(f"the health check {name} failed" + (f": {words}" if words else ""))
    errors = btrfs_errors()["total"]
    if errors > int(st.get("btrfs_errors", errors)):
        reasons.append(f"the disks counted {errors - int(st['btrfs_errors'])} new btrfs errors")
    if not addresses():
        reasons.append("no network address")
    elif st.get("gateway"):
        rc, _, _ = run(["ping", "-c", "1", "-W", "2", st["gateway"]])
        if rc != 0:
            reasons.append(f"the gateway {st['gateway']} doesn't answer")
    return not reasons, reasons


def health_scripts():
    """[(name, healthy, its last line)] for each script in /etc/bromigos/server/health.d (the
    installer's per-role checks, and any you add): exit 0 is healthy. Run with sh unless it's
    executable; a minute each."""
    d = at(HEALTH_D)
    out = []
    for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        p = os.path.join(d, name)
        if not os.path.isfile(p) or name.startswith(".") or name.endswith(("~", ".disabled", ".pacnew", ".pacsave")):
            continue
        cmd = [p] if os.access(p, os.X_OK) else ["sh", p]
        try:
            rc, o, e = run(cmd, timeout=60)
        except subprocess.TimeoutExpired:
            rc, o, e = 1, "", "it took longer than a minute"
        out.append((name, rc == 0, last_line(e or o, "") if rc != 0 else ""))
    return out


def cmd_mark_boot(a):
    st = load_state()
    if st.get("phase") in ("reboot", "verify"):
        st["boots"] = int(st.get("boots", 0)) + 1
        st["phase"] = "verify"
        save_state(st)
    return 0


def cmd_health(a, booted=True):
    """After an update: wait up to [health] minutes for the system to be healthy. Not healthy:
    the update rolled back (bromigos update --rollback PRE --yes), the kernel in /boot put back
    to match, a restart. Only once: a second failure stops and asks for attention."""
    st = load_state()
    if st.get("phase") != "verify":
        return 0
    c = config()
    # a start that never reached this check (it hung, someone pressed reset): roll back now
    hung = booted and int(st.get("boots", 0)) > 1
    deadline = time.time() + 60 * float(c["health"]["minutes"])
    ok, reasons = False, ["it never reached the check"] if hung else []
    while not hung:
        ok, reasons = check_health(st, c)
        if ok or time.time() >= deadline:
            break
        time.sleep(float(os.environ.get("BROMIGOS_SERVER_HEALTH_POLL", "15")))
    if ok:
        st.update(phase="ok", finished=now(), finished_ts=time.time(), reason="", last_success_ts=time.time())
        save_state(st)
        remember({"event": "healthy", "pre": st.get("pre")})
        print("bromigos-server: the update came back healthy")
        return 0
    reason = "; ".join(reasons)
    if st.get("rolled_back") or not st.get("pre"):
        st.update(phase="attention", finished=now(), finished_ts=time.time(),
                  reason=("after rolling back: " if st.get("rolled_back") else "no snapshot to roll back to: ") + reason)
        save_state(st)
        remember({"event": "attention", "reason": reason})
        print(f"bromigos-server: needs attention: {st['reason']}", file=sys.stderr)
        return 1
    print(f"bromigos-server: not healthy after the update ({reason}): rolling it back", file=sys.stderr)
    rc, out, err = run(["bromigos", "update", "--rollback", str(st["pre"]), "--yes"], timeout=3600)
    if rc != 0:
        st.update(phase="attention", finished=now(), finished_ts=time.time(),
                  reason=f"the rollback failed: {(err or out).strip().splitlines()[-1:] or ['?']}")
        save_state(st)
        remember({"event": "attention", "reason": st["reason"]})
        return 1
    if st.get("kernel"):
        kernel_back()
    st.update(phase="verify", rolled_back=True, boots=0, reason=f"rolled back: {reason}")
    save_state(st)
    remember({"event": "rolled-back", "pre": st["pre"], "post": st.get("post"), "reason": reason})
    print("bromigos-server: rolled back; restarting into it")
    run(["systemctl", "reboot"])
    return 0


def kernel_back():
    """/boot isn't in the snapshots: after rolling back a kernel update, the rolled-back
    system's own kernel goes back into /boot, and its initramfs is made again (offline)."""
    for d in sorted(os.listdir(at("/usr/lib/modules"))) if os.path.isdir(at("/usr/lib/modules")) else []:
        base = os.path.join(at("/usr/lib/modules"), d)
        try:
            pkgbase = open(os.path.join(base, "pkgbase")).read().strip()
        except OSError:
            continue
        src = os.path.join(base, "vmlinuz")
        if os.path.isfile(src):
            shutil.copyfile(src, at(f"/boot/vmlinuz-{pkgbase}"))
            run(["mkinitcpio", "-p", pkgbase], timeout=900)
    os.sync()


def main(argv=None):
    ap = argparse.ArgumentParser(prog="bromigos-server", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("status")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("update")
    p.add_argument("--now", action="store_true", help="even when automatic updates are off, or one is being checked")
    sub.add_parser("health")
    sub.add_parser("mark-boot")
    p = sub.add_parser("firewall")
    p.add_argument("verb", nargs="?", choices=["status", "apply", "allow", "deny"])
    p.add_argument("name", nargs="?")
    p.add_argument("--print", action="store_true", help="print the rules instead of loading them")
    p = sub.add_parser("roles")
    p.add_argument("--json", action="store_true")
    for name in ("role", "extra"):
        p = sub.add_parser(name)
        p.add_argument("verb", choices=["add", "remove"])
        p.add_argument("name", metavar="ROLE[/VARIANT]")
    p = sub.add_parser("backup")
    p.add_argument("verb", nargs="?", choices=["status", "run", "check", "key"])
    p.add_argument("--json", action="store_true")
    p.add_argument("--data", action="store_true", help="check: read back 5 %% of the data too")
    p = sub.add_parser("ups")
    p.add_argument("verb", nargs="?", choices=["status", "detect"])
    p.add_argument("--json", action="store_true")
    sub.add_parser("disk-alert")
    sub.add_parser("setup")
    p = sub.add_parser("secrets", help="this server's secret store: bromigos lab secrets (status, set, generate, rotate …)")
    p.add_argument("rest", nargs=argparse.REMAINDER)
    a = ap.parse_args(argv)
    cmd = a.cmd or "status"
    if cmd == "status":
        d = status_doc()
        if getattr(a, "json", False):
            print(json.dumps(d, indent=1))
        else:
            print_status(d)
        return 0
    if cmd == "roles":
        return cmd_roles(a)
    if cmd == "secrets":
        # the same store and words as the lab's (bromigos_homelab.secretstore): rotate included
        lab = shutil.which("bromigos-lab") or "/usr/lib/bromigos/bin/bromigos-lab"
        if not os.path.exists(lab):
            sys.exit("bromigos-server: the secret store is the lab's (bromigos-lab), which isn't installed")
        os.execv(lab, [lab, "secrets", *a.rest])
    reading = (cmd == "firewall" and (a.print or a.verb in (None, "status") or not a.name)) or \
        (cmd in ("backup", "ups") and a.verb in (None, "status"))
    if ROOT == "/" and os.geteuid() != 0 and not reading:
        sudo = shutil.which("sudo")
        if sudo:
            os.execv(sudo, [sudo, sys.executable, "-I", os.path.realpath(__file__), *(argv if argv is not None else sys.argv[1:])])
        sys.exit("bromigos-server: run it as root")
    return {"update": cmd_update, "health": cmd_health, "mark-boot": cmd_mark_boot,
            "firewall": cmd_firewall, "setup": cmd_setup, "role": cmd_role, "extra": cmd_role,
            "backup": cmd_backup, "ups": cmd_ups, "disk-alert": cmd_disk_alert}[cmd](a)


if __name__ == "__main__":
    sys.exit(main())
