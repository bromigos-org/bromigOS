def install_doc(c):
    """What the installer chose ([network], [storage], [unlock], [services], [apps], [lab],
    [games], [remote], [boot], [kernel], [packages] and [roles] picked), as it wrote them, and
    what it left for the first start: each unit's state, and the packages still waiting."""
    doc = {k: c[k] for k in INSTALLER_SECTIONS if isinstance(c.get(k), dict) and c[k]}
    doc["picked"] = list(c["roles"].get("picked", []))
    first = {}
    for unit, what in FIRST_START.items():
        if unit_exists(unit):
            first[unit] = {"what": what, "enabled": unit_enabled(unit), "state": unit_state(unit)}
    doc["first_start"] = first
    try:
        doc["pending_packages"] = open(at(PENDING)).read().split()
    except OSError:
        doc["pending_packages"] = []
    return doc


def install_lines(d):
    """The installer's choices in a few plain lines (status)."""
    out = []
    n = d.get("network") or {}
    if n:
        how = (f"fixed {n.get('address')}/{n.get('prefix')}, router {n.get('gateway') or '?'}" if n.get("method") == "static"
               else "address from the router (DHCP)")
        extra = [w for w in (f"VLAN {n['vlan']}" if n.get("vlan") else "",
                             "bonded: " + " + ".join(n["bond"]) if n.get("bond") else "",
                             "Wake-on-LAN on" if n.get("wake_on_lan") else "") if w]
        out.append(f"Network      {n.get('interface') or 'auto'}: {how}" + (f"; {', '.join(extra)}" if extra else ""))
    st = d.get("storage") or {}
    if st.get("disks"):
        out.append(f"Data disks   {', '.join(st['disks'])}: " + ("two copies (RAID1)" if st.get("layout") == "raid1" else "one copy")
                   + f" at {st.get('mount') or '/srv/data'}" + (f"; shares: {', '.join(st['shares'])}" if st.get("shares") else ""))
    u = (d.get("unlock") or {}).get("mode")
    if u:
        out.append("Unlocking    " + {"tpm": "the security chip (TPM) opens the disk at each start",
                                      "passphrase": "the passphrase at each start",
                                      "none": "not encrypted"}.get(u, u))
    sv = d.get("services") or {}
    if sv.get("on"):
        out.append(f"Services     {', '.join(sv['on'])}")
    apps = (d.get("apps") or {}).get("enabled")
    if apps:
        out.append(f"Apps         {', '.join(apps)} (containers, their images pinned)")
    g = d.get("games") or {}
    if g:
        out.append("Games        " + ", ".join(w for w in (f"Pelican panel {g['pelican_url']}" if g.get("pelican_url") else "",
                                                          f"registry mirror {g['registry_mirror']}" if g.get("registry_mirror") else "",
                                                          "Docker" if g.get("docker") else "") if w))
    r = d.get("remote") or {}
    if r:
        on = [w for w, k in (("Tailscale", "tailscale"), ("WireGuard", "wireguard")) if r.get(k)]
        out.append("Remote       " + (", ".join(on) + " on" if on else "Tailscale and WireGuard off"))
    for unit, f in d.get("first_start", {}).items():
        if f["enabled"] == "enabled" or f["state"] not in ("inactive", "unknown"):
            out.append(f"First start  {f['what']}: {f['state']}")
    if d.get("pending_packages"):
        out.append(f"Waiting      {len(d['pending_packages'])} package(s) for a network: {' '.join(d['pending_packages'][:6])}"
                   + (" …" if len(d["pending_packages"]) > 6 else ""))
    return out


