# game servers, open to everyone: Minecraft's 25565 (the Game server role); other games'
# ports go in /etc/bromigos/server.toml's [firewall] public_tcp and public_udp
add rule inet bromigos-server input tcp dport 25565 accept comment "games (Minecraft)"
add rule inet bromigos-server input udp dport 25565 accept comment "games (Minecraft)"
