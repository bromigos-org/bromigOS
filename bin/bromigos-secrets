#!/usr/bin/env python3
# bromigos:summary=Refresh the desktop's secret files from Vault (never prints values)
# bromigos:args=sync [--quiet]|status
"""bromigos-secrets (`bromigos secrets …`, package bromigos-core): refresh the desktop's secret
files from Vault.

    bromigos-secrets sync [--quiet]   Vault -> ~/.local/share/bromigos/<file> (0600)
    bromigos-secrets status           which files exist (names and modes, never values)

Real secrets (tokens, keys, kubeconfigs) are never stored in the dotfiles, not even
encrypted. They live in Vault; this copies each one to a mode-600 file the desktop reads.
The manifest (file -> Vault path#key) is the `secrets:` list in the private overlay
(private.sops.yaml, decrypted by bromigos-private), so the Vault paths stay private too.

Vault login, first that works: $VAULT_TOKEN, ~/.vault-token (the operator's session),
then VECTOR's AppRole (vault-vector-role-id / -secret-id). Vault's address is the
overlay's endpoints.vault; its CA is $VAULT_CACERT or ~/.config/homelab/homelab-ca.crt.
A path the token may not read (VECTOR's AppRole can't read every tree) keeps its
existing file; nothing is ever deleted or blanked. Values are never printed or logged.
bromigos-secrets.service runs `sync --quiet` at login.
"""
import json
import os
import ssl
import sys
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
DEST = os.path.join(HOME, ".local/share/bromigos")
sys.path[:0] = ["/usr/lib/bromigos/lib", os.path.join(HOME, ".config/bromigos/lib")]   # package bromigos-core
import bromigos_private as PRIV  # noqa: E402

CA = os.environ.get("VAULT_CACERT") or os.path.join(HOME, ".config/homelab/homelab-ca.crt")


def ctx():
    return ssl.create_default_context(cafile=CA) if os.path.exists(CA) else ssl.create_default_context()


def req(addr, method, path, token=None, body=None):
    h = {"Content-Type": "application/json"}
    if token:
        h["X-Vault-Token"] = token
    r = urllib.request.Request(f"{addr}/v1/{path}", method=method, headers=h,
                               data=json.dumps(body).encode() if body is not None else None)
    with urllib.request.urlopen(r, timeout=15, context=ctx()) as f:
        return json.load(f)


def read_file(p):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return ""


def tokens(addr):
    """Candidate tokens in order (label, token); the AppRole login only if needed."""
    t = os.environ.get("VAULT_TOKEN") or ""
    if t:
        yield "VAULT_TOKEN", t
    t = read_file(os.path.join(HOME, ".vault-token"))
    if t:
        yield "operator session", t
    rid, sid = read_file(os.path.join(DEST, "vault-vector-role-id")), read_file(os.path.join(DEST, "vault-vector-secret-id"))
    if rid and sid:
        try:
            a = req(addr, "POST", "auth/approle/login", body={"role_id": rid, "secret_id": sid})
            yield "vector AppRole", a["auth"]["client_token"]
        except (OSError, ValueError, KeyError):
            pass


def kv_get(addr, token, path):
    mount, _, sub = path.partition("/")
    return req(addr, "GET", f"{mount}/data/{sub}", token)["data"]["data"]


def write_secret(name, value):
    os.makedirs(DEST, exist_ok=True)
    p = os.path.join(DEST, name)
    try:
        with open(p) as f:
            if f.read() == value:
                os.chmod(p, 0o600)
                return "unchanged"
    except OSError:
        pass
    tmp = p + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(value)
    os.replace(tmp, p)
    return "updated"


def sync(quiet=False):
    addr = PRIV.url("vault")
    manifest = PRIV.get("secrets", [])
    if not addr or not manifest:
        if not quiet:
            print("bromigos-secrets: no Vault or manifest in the private overlay; nothing to do")
        return 0
    cache, results, label = {}, [], None
    cands = tokens(addr)
    tok_list = []
    for e in manifest:
        name, path, key = e.get("file"), e.get("vault"), e.get("key")
        if not (name and path and key) or "/" in name:
            results.append((name or "?", "bad manifest entry"))
            continue
        data, why = None, "unreadable"
        i = 0
        while True:
            if i >= len(tok_list):
                nxt = next(cands, None)
                if nxt is None:
                    break
                tok_list.append(nxt)
            lab, tok = tok_list[i]
            i += 1
            k = (lab, path)
            if k not in cache:
                try:
                    cache[k] = kv_get(addr, tok, path)
                except urllib.error.HTTPError as err:
                    cache[k] = None if err.code in (403, 404) else "error"
                except (OSError, ValueError, KeyError):
                    cache[k] = "error"
            got = cache[k]
            if isinstance(got, dict) and key in got:
                data, label = got[key], lab
                break
            why = "Vault unreachable" if got == "error" else ("no such key" if isinstance(got, dict) else "denied")
        if data is None:
            results.append((name, why + "; kept the existing file"))
            continue
        results.append((name, write_secret(name, str(data))))
    bad = [r for r in results if r[1] not in ("updated", "unchanged")]
    if not quiet or bad:
        print(f"bromigos-secrets: {len(results) - len(bad)}/{len(results)} from Vault" + (f" ({label})" if label else ""))
        for n, s in results:
            if not quiet or s not in ("updated", "unchanged"):
                print(f"  {n:<28} {s}")
    return 0


def status():
    names = [e.get("file") for e in PRIV.get("secrets", [])]
    if not names:
        print("bromigos-secrets: no manifest (private overlay `secrets:`)")
    for n in names:
        p = os.path.join(DEST, n)
        try:
            st = os.stat(p)
            print(f"  {n:<28} present, mode {oct(st.st_mode & 0o777)}")
        except OSError:
            print(f"  {n:<28} MISSING")
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "sync":
        return sync(quiet="--quiet" in sys.argv)
    if cmd == "status":
        return status()
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
