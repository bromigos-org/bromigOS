#!/usr/bin/env python3
# bromigos:summary=The welcome tour in the terminal (bromigOS Server's first sign-in): the network, SSH, joining your lab, and what's here
# bromigos:args=[--if-pending] [--step STEP] [--render DIR [--size WxH]]
# bromigos:examples=bromigos welcome-console
"""bromigos-welcome-console: bromigOS Server's welcome tour, at the first sign-in on its console
(docs/iso.md, "Editions"; /etc/profile.d/bromigos-welcome.sh starts it once, when the installer
left ~/.local/state/bromigos/welcome-pending). Textual, in DRIFTGLASS (lib/bromigos_textual.py:
the theme's palette, truecolour or the console's 16 colours). Every step can be skipped, and
each one changes things the usual way, so nothing here keeps a setting of its own:

  The network      what's connected and its address; Wi-Fi through nmtui
  SSH              on or off (systemctl), keys only or passwords too (bromigOS Server's settings,
                   /etc/bromigos/server.toml and `bromigos-server setup` when it's installed; else
                   an sshd drop-in), a key pasted in (~/.ssh/authorized_keys)
  Join your lab    `bromigos setup homelab --find`, which asks before it reads anything
  What's here      the lab console, updates and rollback, Field Kit, the server's status
  Done

  bromigos welcome-console                 open it (again)
  bromigos welcome-console --if-pending    only when the install left it pending (the console's sign-in)
  bromigos welcome-console --step STEP    open it on one step (network, ssh, vector, lab, phone, tour, done)
  bromigos welcome-console --render DIR [--size WxH]
                                           each step to DIR/server-welcome-STEP.svg (checked to
                                           fit at that size), and exit
"""
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))   # its own first
sys.path.append("/usr/lib/bromigos/lib")

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "bromigos")
PENDING = os.path.join(STATE, "welcome-pending")
SERVER_TOML = "/etc/bromigos/server.toml"
KEYS_ONLY = "/etc/ssh/sshd_config.d/01-bromigos-keys-only.conf"

GUIDE = {   # VECTOR's one line per step, under the rail
    "network": "This server's address on your network.",
    "ssh": "Keys only is safest. Nobody can guess a key.",
    "vector": "Where should I think? Your lab is best.",
    "lab": "Join your lab and I can use it.",
    "phone": "Scan it with BRODEC and I'm on your phone.",
    "tour": "The commands worth knowing.",
    "done": "All set. Sign in from anywhere with SSH.",
}

STEPS = [
    ("network", "Network", "The network",
     "This server's connection and its address on your network. Other computers reach it there."),
    ("ssh", "SSH", "Sign in from another computer",
     "SSH lets you manage this server from your own computer. Keys only is safest: nobody can guess a key."),
    ("vector", "VECTOR", "VECTOR, this server's AI",
     "Where his brain runs. Nothing leaves this server unless you choose a service."),
    ("lab", "Lab", "Join your lab",
     "If you run a homelab, this server can join it: the lab console then shows it, and VECTOR can use it."),
    ("phone", "Phone", "Pair your phone",
     "With BRODEC on your phone: talk to VECTOR, approve his fixes, restart, shut down or update this server."),
    ("tour", "What's here", "What's on this server",
     "The few things worth knowing. Type any of them at the prompt; each says more with --help."),
    ("done", "Done", "You're set",
     "This tour opens again with: bromigos welcome-console."),
]
TOUR = [
    ("bromigos-lab", "The lab console: your machines, their GPUs and services, and the jobs they run"),
    ("bromigos update", "Updates, with a snapshot before each one"),
    ("bromigos update --rollback", "Undo the last update, or start an older snapshot from the boot menu"),
    ("bromigos-server status", "This server in plain words: SSH, the firewall, updates, the lab"),
    ("fieldkit", "Field Kit's repair and lab tools, when they're installed"),
    ("bromigos settings --help", "Everything bromigOS can set, from the command line"),
]


def run(argv, timeout=20):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)


def network():
    """[(device, kind, state, connection, addresses)]"""
    code, out, _ = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"])
    rows = []
    for line in out.splitlines():
        f = line.split(":")
        if len(f) < 4 or f[1] in ("loopback", "bridge", "wifi-p2p") or f[0].startswith(("veth", "docker", "virbr")):
            continue
        code, a, _ = run(["ip", "-brief", "addr", "show", f[0]])
        addrs = " ".join(x.split("/")[0] for x in a.split()[2:] if not x.startswith("fe80"))
        rows.append((f[0], f[1], f[2], f[3], addrs))
    return rows


def ssh_state():
    on = run(["systemctl", "is-enabled", "sshd"])[1].strip() == "enabled"
    keys_only = os.path.exists(KEYS_ONLY)
    if os.path.exists(SERVER_TOML):
        m = re.search(r"^\s*password\s*=\s*(true|false)", open(SERVER_TOML).read(), re.M)
        keys_only = not (m and m.group(1) == "true")
    try:
        keys = [l for l in open(os.path.expanduser("~/.ssh/authorized_keys")) if l.strip() and not l.startswith("#")]
    except OSError:
        keys = []
    return on, keys_only, len(keys)


def main(argv):
    if "--if-pending" in argv and not os.path.exists(PENDING):
        return 0
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    try:
        import bromigos_firstrun as F
        import bromigos_textual as BT
        from rich.table import Table
        from rich.text import Text
        from textual import on
        from textual.app import App
        from textual.binding import Binding
        from textual.containers import Horizontal, Vertical, VerticalScroll
        from textual import work
        from textual.widgets import Button, Input, Label, RadioButton, RadioSet, Static, Switch
    except ImportError:
        print("The welcome tour needs Textual (python-textual) and bromigos-core's bromigos_textual.")
        return 1
    BT.prepare_terminal()
    render = argv[argv.index("--render") + 1] if "--render" in argv else None

    class Welcome(App):
        CSS = BT.CSS + """
        Screen { background: $background; }
        #top { height: 1; padding: 0 1; background: $surface; color: $primary; text-style: bold; }
        #body { height: 1fr; }
        #rail { width: 22; height: 1fr; padding: 1 1; border-right: solid $primary 30%; background: $surface; }
        #page { padding: 1 2; }
        .intro { color: $text-muted; margin-bottom: 1; }
        .muted { color: $text-muted; }
        .row { height: auto; margin-top: 1; width: 1fr; }
        Input { width: 1fr; }
        .glass { margin-top: 1; }
        #nav { height: 3; padding: 0 2; align-horizontal: right; }
        #nav Button { margin-left: 2; min-width: 12; }
        #msg { height: auto; padding: 0 2; color: $warning; }
        #hint { height: 1; padding: 0 2; color: $text-muted; }
        Screen.-compact #rail { width: 18; }
        Screen.-narrow #rail { display: none; }
        Screen.-narrow #page, Screen.-narrow #nav, Screen.-narrow #msg, Screen.-narrow #hint { padding: 0 1; }
        Screen.-narrow #nav { height: 1; }
        #qr { width: auto; height: auto; margin-right: 3; }
        #pair-row { height: auto; }
        #pair-side { width: 1fr; height: auto; }
        #pair-code { height: auto; margin-bottom: 1; }
        Screen.-narrow #page Button { width: 1fr; }
        /* the pairing QR on a short screen (80×24): it gets the whole page */
        Screen.-qr-tight #page Emitter, Screen.-qr-tight #page .intro, Screen.-qr-tight #hint { display: none; }
        Screen.-qr-tight #page { padding: 0 1; }
        Screen.-qr-tight #nav { height: 1; }
        Screen.-qr-tight #nav Button { height: 1; border: none; padding: 0 1; min-width: 8; }
        Screen.-narrow #nav Button { min-width: 8; margin-left: 1; height: 1; border: none; padding: 0 1; }
        """
        BINDINGS = [Binding("escape", "back", "Back"), Binding("ctrl+n", "next", "Continue"), Binding("ctrl+q", "quit", "Leave")]

        def __init__(self):
            super().__init__()
            self.i = 0

        def compose(self):
            yield Static(BT.TOO_SMALL_WORDS, id="too-small")
            yield Static("", id="top")
            with Horizontal(id="body"):
                yield Static("", id="rail")
                yield VerticalScroll(id="page")
            yield Static("", id="msg")
            with Horizontal(id="nav"):
                b = Button("Back", id="back")
                b.tooltip = "The step before"
                yield b
                b = Button("Skip", id="skip")
                b.tooltip = "Leave this as it is and go on"
                yield b
                b = Button("Continue", id="next", variant="primary")
                b.tooltip = "Use what's chosen here and go on (Ctrl+N)"
                yield b
            yield Static("Tab moves · Enter picks · Esc goes back · Ctrl+Q leaves", id="hint")

        async def on_mount(self):
            self.register_theme(BT.theme())
            self.theme = "bromigos"
            if BT.motion() != "full":
                self.animation_level = "none"
            start = argv[argv.index("--step") + 1] if "--step" in argv else None
            ids = [st[0] for st in STEPS]
            await self.show(ids.index(start) if start in ids else 0)

        def on_resize(self, event):
            self.bp = BT.apply_breakpoint(self.screen, event.size.width, event.size.height)
            if STEPS[getattr(self, "i", 0)][0] == "phone" and getattr(self, "last_code", None) and self.qr.display is not None:
                self.call_after_refresh(self._qr, self.last_code)      # the QR, or the big code, for the new size
            try:
                self._top()
            except Exception:
                pass

        def on_descendant_focus(self, event):
            self.call_after_refresh(event.widget.scroll_visible, animate=False)

        def _top(self):
            narrow = getattr(self, "bp", "normal") in ("narrow", "too-small")
            self.query_one("#top", Static).update(f"SERVER  {self.i + 1}/{len(STEPS)}  {STEPS[self.i][1].upper()}" if narrow
                                                  else f"BROMIGOS SERVER // WELCOME    STEP {self.i + 1} OF {len(STEPS)}")

        async def show(self, i):
            self.stop_pairing()              # the phone step's watching ends with it
            self.i = i
            sid, short, head, intro = STEPS[i]
            self._top()
            c = BT.palette()
            rail = Text()
            icons = {"network": "network", "ssh": "ssh", "vector": "vector", "lab": "lab", "phone": "phone", "tour": "tour",
                     "done": "done"}
            for j, s in enumerate(STEPS):
                ic = BT.icon(icons.get(s[0], "done")) if hasattr(BT, "icon") else "•"
                if j == i:
                    rail.append("▌" + ic + " " + s[1] + "\n", style="bold " + c["primary"])
                else:
                    rail.append(" " + ic + " " + s[1], style="" if j < i else "dim")
                    rail.append((" " + (BT.icon("check") if hasattr(BT, "icon") else "✓")) if j < i else "", style=c["primary"])
                    rail.append("\n")
            if hasattr(BT, "orb") and self.size.height >= 30 and getattr(self, "bp", "normal") not in ("compact", "narrow"):
                rail.append("\n")
                rail.append_text(BT.orb(0.0, 12, 6))
                line = GUIDE.get(sid, "")
                if line:
                    rail.append("\n")
                    rail.append("VECTOR  ", style="bold " + c["primary"])
                    rail.append(line)
            self.query_one("#rail", Static).update(rail)
            page = self.query_one("#page", VerticalScroll)
            await page.remove_children()
            if i == 0 and self.size.height >= 30 and getattr(self, "bp", "normal") not in ("narrow", "too-small"):
                text, ansi = BT.emblem()
                page.mount(Static(Text.from_ansi(text) if ansi else text))
            page.mount(BT.Emitter(head), Static(intro, classes="intro"))
            self.screen.set_class(sid == "phone" and self.size.height < 34, "-qr-tight")
            getattr(self, f"build_{sid}")(page)
            self.query_one("#msg", Static).update("")
            self.query_one("#back").display = i > 0
            self.query_one("#skip").display = sid != "done"
            self.query_one("#next", Button).label = "Finish" if sid == "done" else "Continue"

        def build_network(self, page):
            t = Table.grid(padding=(0, 2))
            rows = [] if render else network()
            if render:
                rows = [("enp3s0", "ethernet", "connected", "Wired connection 1", "192.0.2.24"), ("wlan0", "wifi", "disconnected", "--", "")]
            for dev, kind, state, conn, addrs in rows:
                t.add_row(Text(dev, style="bold"), kind, state, addrs or "no address")
            page.mount(Static(t, classes="glass"))
            on_ = any(r[2] == "connected" for r in rows)
            page.mount(BT.Reading("Connected" if on_ else "Not connected: plug in a cable, or connect to Wi-Fi", "ok" if on_ else "warn"))
            b = Button("Connect to Wi-Fi…", id="wifi")
            b.tooltip = "Open the Wi-Fi settings (nmtui) to join a network"
            page.mount(b)

        def build_ssh(self, page):
            on_, keys_only, nkeys = (True, True, 1) if render else ssh_state()
            row = Horizontal(classes="glass row")
            page.mount(row)
            sw = Switch(on_, id="ssh-on")
            sw.tooltip = "On: other computers can sign in with SSH. Off: only this console"
            row.mount(sw, Label("  SSH is " + ("on" if on_ else "off")))
            row2 = Horizontal(classes="glass row")
            page.mount(row2)
            ko = Switch(keys_only, id="keys-only")
            ko.tooltip = "On: keys only (safest). Off: your password works over SSH too"
            row2.mount(ko, Label("  Keys only"))
            page.mount(Static(f"{nkeys} key{'s' if nkeys != 1 else ''} can sign in as you.", classes="muted"))
            page.mount(Label("Add a key (one line from your other computer's .pub file)", classes="row"))
            inp = Input(id="key", placeholder="ssh-ed25519 AAAA… you@laptop")
            inp.tooltip = "Your other computer's public key, for example ~/.ssh/id_ed25519.pub there"
            page.mount(inp)

        def button(self, page, label, bid, tip):
            b = Button(label, id=bid)
            b.tooltip = tip
            page.mount(b)
            return b

        def build_vector(self, page):
            vram = 0.0 if render else F.gpu_vram_gib()
            self.model = None if render else F.local_model(vram)
            have = [] if render else F.lab_brains()
            self.brains = [("lab", "Your lab", have[0]["name"] if have else "found on the next step")]
            if self.model:
                self.brains.append(("local", "This server", f"{self.model['name']}, {self.model['disk_gib']:.0f} GB to download"))
            self.brains += [("service", "A service", "an OpenAI-compatible server you name"), ("none", "Not now", "")]
            rs = RadioSet(id="brain")
            rs.tooltip = "Where VECTOR thinks"
            page.mount(rs)
            for k, t, sub in self.brains:
                rb = RadioButton(f"{t}" + (f": {sub}" if sub else ""), value=k == getattr(self, "brain_pick", "lab"), id=f"brain-{k}")
                rb.tooltip = f"{t}. {sub}"
                rs.mount(rb)
            for iid, ph, tip in (("svc-url", "https://…/v1", "The service's OpenAI-compatible address"),
                                 ("svc-model", "model (blank: VECTOR's default)", "Which model he uses"),
                                 ("svc-key", "a file holding its API key (blank: none)", "The key stays in that file")):
                w = Input(placeholder=ph, id=iid)
                w.tooltip = tip
                page.mount(w)
            self.vec_line = BT.Reading("", "idle")
            page.mount(self.vec_line)

        @on(RadioSet.Changed, "#brain")
        def brain_changed(self, ev):
            self.brain_pick = ev.pressed.id.removeprefix("brain-")

        @work(thread=True)
        def apply_vector(self):
            pick = getattr(self, "brain_pick", "lab")
            say = lambda t, st="busy": self.call_from_thread(self.vec_line.set, t, st)  # noqa: E731
            if pick == "local":
                ok, why = F.install_local_brain(self.model, lambda l: say(l))
                if not ok:
                    return say(why, "fail")
            elif pick == "service":
                url = self.call_from_thread(lambda: self.query_one("#svc-url", Input).value.strip())
                if not url:
                    return say("Type the service's address, or choose another place for his brain.", "warn")
                code, out, err = F.set_brain("service", url=url,
                                             model=self.call_from_thread(lambda: self.query_one("#svc-model", Input).value.strip()) or None,
                                             key_file=self.call_from_thread(lambda: self.query_one("#svc-key", Input).value.strip()) or None)
                if code:
                    return say("VECTOR's brain couldn't be set: " + F.plain_error(err or out), "fail")
            elif pick == "none":
                F.set_brain("none")
            if pick in ("local", "service"):
                ok, words = F.hello()
                say(("VECTOR: " + words) if ok else words, "ok" if ok else "fail")
                if not ok:
                    return
            self.call_from_thread(self.show, self.i + 1)

        def build_lab(self, page):
            page.mount(Static("Find my lab reads what this server already knows of your network (it never scans), "
                              "checks those devices, and changes nothing until you press Connect.", classes="glass"))
            self.button(page, "Look for it", "findlab", "Find the lab's machines and what they offer")
            self.lab_out = Static("", classes="muted")
            page.mount(self.lab_out)
            self.button(page, "Connect it", "connectlab", "Add what was found to this server's homelab settings").display = False
            page.mount(Label("Or a lab connection file (homelab.toml, or one from a Field Kit stick):", classes="row"))
            f = Input(placeholder="/path/to/homelab.toml", id="labfile")
            f.tooltip = "The path of a homelab.toml to use"
            page.mount(f)
            self.button(page, "Use the file", "labfile-use", "Connect the lab in that file")
            if render or F.gpu_vram_gib() >= 8:
                self.button(page, "Make this server my lab: show the plan", "labplan",
                            "bromigos-lab's reviewed plan for this server; nothing changes")

        @work(thread=True)
        def lab_action(self, what):
            out = self.lab_out
            put = lambda t: self.call_from_thread(out.update, t)  # noqa: E731
            if what == "find":
                put("Looking…")
                r = F.find_lab()
                if r["error"] or not r["hosts"]:
                    return put(r["error"] or "No lab found. Use its connection file, or connect it later (bromigos setup homelab).")
                put("\n".join(f"{h['name']}: {', '.join(h['offers'])}" for h in r["hosts"]))
                self.lab_found = r
                self.call_from_thread(lambda: setattr(self.query_one("#connectlab"), "display", True))
            elif what == "connect":
                ok, why = F.connect_lab()
                brains = (getattr(self, "lab_found", {}) or {}).get("brains") or F.lab_brains()
                if ok and getattr(self, "brain_pick", "lab") == "lab" and brains:
                    F.set_brain("lab", url=brains[0]["url"])
                    ok2, words = F.hello()
                    return put(("Connected. VECTOR: " + words) if ok2 else "Connected. " + words)
                put("Connected." if ok else why)
            elif what == "file":
                ok, why = F.use_lab_file(self.call_from_thread(lambda: self.query_one("#labfile", Input).value.strip()))
                put("Your lab is connected." if ok else why)
            elif what == "plan":
                ok, text = F.provision_plan()
                put(("The plan (nothing has changed):\n" + text[-1500:]) if ok else "The plan couldn't be made: " + F.plain_error(text))

        def build_phone(self, page):
            # the QR on the left (half blocks, dark on light, its quiet zone; nothing touching
            # it), and beside it the code to type, the live status and the steps: all three on
            # screen without scrolling at 120×35; when the QR can't fit, the code big instead
            page.mount(Static(Text(f"Get BRODEC: Google Play (iPhone: coming).", overflow="fold"), classes="muted"))
            row = Horizontal(id="pair-row")
            page.mount(row)
            self.qr = Static("", id="qr")
            side = Vertical(id="pair-side")
            row.mount(self.qr, side)
            self.code = Static("", id="pair-code")
            self.pair_line = BT.Reading("Waiting for the pairing code…", "busy")
            self.pair_steps = Static("In BRODEC: LAB › MACHINES › ADD MACHINE, then scan the code, or type it.",
                                     classes="muted", id="pair-steps")
            side.mount(self.code, self.pair_line, self.pair_steps)
            self.pair_page = page
            if render:
                self._qr({"qr": "https://accounts.bromigos.org/device#machine=k1.example&n=server", "user_code_display": "KPGG-ZFVT"})
            elif not F.machine_installed():
                self.pair_line.set("Pairing needs BRODEC's helper (brodec-machine). It runs only what your phone signs; "
                                   "STOP ALL halts it.", "warn")
                self.button(side, "Install it", "machine-install", "Install BRODEC's helper (sudo asks for your password)")
            elif not F.machine_config_ready():
                self.pair_line.set("BRODEC's helper starts once this server allows it (a settings file only root writes).", "warn")
                self.button(side, "Allow pairing", "machine-allow", "Let BRODEC's helper run here (sudo asks for your password)")
            else:
                self.start_pairing()
            if not render and F.lab_bridge_available():
                self.button(page, "Pair the lab's bridge", "bridge-pair", "Show the lab VECTOR bridge's pairing code (sudo asks)")
            page.mount(Static("Then your phone can: " + "; ".join(c[0].lower() + c[1:] if not c.startswith("VECTOR") else c
                                                              for c in F.PHONE_CAN) + ".", classes="muted"))

        def qr_room(self):
            """(columns, rows) the QR may take beside its side column on this screen."""
            rail = 0 if getattr(self, "bp", "normal") in ("narrow", "too-small") else (18 if getattr(self, "bp", "") == "compact" else 22)
            cols = self.size.width - rail - 4 - 30           # the page's padding, the side column
            tight = self.screen.has_class("-qr-tight")
            rows = self.size.height - (6 if tight else 12)   # top, nav, hint, message; the heading and intro
            return cols, rows

        def start_pairing(self, argv=None):
            self.stop_pairing()
            self.pairing = F.Pairing(argv or F.machine_pair_argv(), lambda ev: self.call_from_thread(self._pair_event, ev))

        def stop_pairing(self):
            if getattr(self, "pairing", None):
                self.pairing.cancel()
                self.pairing = None

        def _pair_event(self, ev):
            if STEPS[self.i][0] != "phone":
                return
            e = ev.get("event")
            if e == "code":
                self._qr(ev)
            elif e == "paired":
                self.qr.display = False                                    # the code's done its job
                self.code.update(BT.big_code("PAIRED") if hasattr(BT, "big_code") else Text("PAIRED", style="bold"))
                self.pair_line.set(f"✓ Paired with {ev.get('owner') or 'your phone'}", "ok")
                self.pair_steps.display = False
                if self.screen.has_class("-qr-tight"):
                    self.query_one("#top", Static).update("PAIR YOUR PHONE  ·  ✓ PAIRED")
                side = self.query_one("#pair-side")
                side.mount(Static("To let it restart, update and open terminals here too: in BRODEC, LAB › MACHINES › this "
                                  "server › ALLOW THIS PHONE, then choose Allow this phone (sudo asks, then shows the "
                                  "phone's key to compare).", classes="muted"), after=self.pair_line)
                self.button(side, "Allow this phone", "machine-enroll",
                            "Allow the phone that asked (sudo brodec-machine enroll: compare the key, then y)")
            else:
                words = F.pairing_words(ev).replace("press Allow pairing (it asks for your password)", "choose Allow pairing")
                self.pair_line.set(words or "…", "warn" if e in ("failed", "cancelled", "expired") else "busy")

        def _qr(self, code):
            self.last_code = code
            shown = code.get("user_code_display") or code.get("user_code") or ""
            self.shown_code = shown
            m = BT.qr_matrix(code.get("qr", "")) if hasattr(BT, "qr_matrix") else None
            cols, rows = self.qr_room()
            if m and BT.qr_size(m)[0] <= cols and BT.qr_size(m)[1] <= rows:
                self.qr.display = True
                self.qr.update(BT.qr_text(m))
                self.code.update(Text(shown, style="bold " + BT.palette()["primary"]))
            else:                                     # no room for a QR a phone can read: the code, big
                self.qr.display = False
                big = BT.big_code(shown) if hasattr(BT, "big_code") else Text(shown, style="bold")
                self.code.update(Text.assemble(big, "\n\n", ("Make the window bigger to show the QR code. Or type this "
                                                             "code in BRODEC.", "")))
            self.pair_line.set("Waiting for your phone to confirm…", "busy")
            if self.screen.has_class("-qr-tight"):      # the code where it's always seen
                self.query_one("#top", Static).update(f"PAIR YOUR PHONE  ·  CODE {shown}")

        def build_tour(self, page):
            t = Table.grid(padding=(0, 2))
            for cmd, what in TOUR:
                t.add_row(Text(cmd, style="bold"), what)
            page.mount(Static(t, classes="glass"))

        def build_done(self, page):
            page.mount(BT.Reading("This server is ready. Sign in from another computer with: ssh " +
                                  os.environ.get("USER", "you") + "@" + os.uname().nodename, "ok"))

        async def action_next(self):
            if render:
                return
            sid = STEPS[self.i][0]
            if sid == "vector":
                self.apply_vector()
                return
            if sid == "ssh":
                problem = self.apply_ssh()
                if problem:
                    self.query_one("#msg", Static).update("▲ " + problem)
                    return
            if sid == "done":
                return self.finish()
            await self.show(self.i + 1)

        async def action_back(self):
            if self.i > 0:
                await self.show(self.i - 1)

        def apply_ssh(self):
            want_on = self.query_one("#ssh-on", Switch).value
            keys_only = self.query_one("#keys-only", Switch).value
            key = self.query_one("#key", Input).value.strip()
            if key:
                if not re.match(r"^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp\d+|sk-\S+@openssh\.com) [A-Za-z0-9+/=]{20,}", key):
                    return "That isn't an SSH public key: it's one line starting ssh-ed25519 or ssh-rsa."
                d = os.path.expanduser("~/.ssh")
                os.makedirs(d, mode=0o700, exist_ok=True)
                with open(os.path.join(d, "authorized_keys"), "a") as f:
                    f.write(key + "\n")
                os.chmod(os.path.join(d, "authorized_keys"), 0o600)
            on_, was_keys_only, nkeys = ssh_state()
            if want_on and keys_only and nkeys == 0:
                return "Keys only needs a key: paste one above, or turn Keys only off."
            cmds = []
            if want_on != on_:
                cmds.append(["systemctl", "enable" if want_on else "disable", "--now", "sshd"])
            if keys_only != was_keys_only:
                if os.path.exists("/usr/bin/bromigos-server"):
                    cmds.append(["sh", "-c", f"mkdir -p /etc/bromigos && touch {SERVER_TOML} && "
                                 f"(grep -q '^\\[ssh\\]' {SERVER_TOML} || printf '[ssh]\\npassword = false\\n' >> {SERVER_TOML}) && "
                                 f"sed -i -E 's/^(\\s*password\\s*=\\s*).*/\\1{'false' if keys_only else 'true'}/' {SERVER_TOML} && "
                                 "bromigos-server setup"])
                elif keys_only:
                    cmds.append(["sh", "-c", f"printf 'PasswordAuthentication no\\nKbdInteractiveAuthentication no\\n' > {KEYS_ONLY} "
                                 "&& systemctl reload sshd"])
                else:
                    cmds.append(["sh", "-c", f"rm -f {KEYS_ONLY} && systemctl reload sshd"])
            if cmds:
                with self.suspend():
                    print("Changing SSH (sudo asks for your password):")
                    for c in cmds:
                        if subprocess.run(["sudo", *c]).returncode != 0:
                            return "That didn't work (see above). Nothing else was changed."
            return None

        def on_unmount(self):
            self.stop_pairing()

        def finish(self):
            self.stop_pairing()
            try:
                os.unlink(PENDING)
            except OSError:
                pass
            self.exit()

        @on(Button.Pressed)
        async def pressed(self, ev):
            b = ev.button.id
            if b == "next":
                await self.action_next()
            elif b == "back":
                await self.action_back()
            elif b == "skip":
                await self.show(self.i + 1)
            elif b == "wifi":
                with self.suspend():
                    subprocess.run(["nmtui", "connect"])
                await self.show(self.i)
            elif b == "findlab":
                self.lab_action("find")
            elif b == "connectlab":
                self.lab_action("connect")
            elif b == "labfile-use":
                self.lab_action("file")
            elif b == "labplan":
                self.lab_action("plan")
            elif b == "machine-install":
                with self.suspend():          # pacman asks for the password here (a server has no password window)
                    subprocess.run(["sudo", "pacman", "-S", "--needed", F.machine_package()])
                    subprocess.run(F.machine_config_sudo_cmd())
                await self.show(self.i)
            elif b == "machine-allow":
                with self.suspend():
                    subprocess.run(F.machine_config_sudo_cmd())
                await self.show(self.i)
            elif b == "machine-enroll":
                with self.suspend():          # it shows the phone's key to compare, and asks y/N
                    subprocess.run(["sudo", "brodec-machine", "enroll"])
                    input("Press Enter to go back to the tour. ")
            elif b == "bridge-pair":
                with self.suspend():          # sudo asks here, then the bridge's code comes as events
                    subprocess.run(["sudo", "-v"])
                self.start_pairing(F.lab_pair_argv(gui=False))

    if render:
        import asyncio

        size = tuple(int(x) for x in argv[argv.index("--size") + 1].split("x")) if "--size" in argv else (110, 36)

        async def shots():
            app = Welcome()
            os.makedirs(render, exist_ok=True)
            problems = []
            async with app.run_test(size=size) as pilot:
                await pilot.pause(0.2)
                for k, s in enumerate(STEPS):
                    await app.show(k)
                    await pilot.pause(0.3)
                    app.save_screenshot(os.path.join(render, f"server-welcome-{s[0]}.svg"))
                    # it fits: nothing off the side, the buttons on screen
                    if app.query_one("#page").max_scroll_x:
                        problems.append(f"{s[0]}: runs off the side")
                    for b in app.query("#nav Button"):
                        if b.display and b.region.right > size[0]:
                            problems.append(f"{s[0]}: {b.id} cut off")
            return problems
        problems = asyncio.run(shots())
        for p in problems:
            print("does not fit:", p)
        return 1 if problems else 0
    if "--live-shots" in argv:          # tests: one step, live, pictures at the seconds given
        import asyncio
        out, step, at = argv[argv.index("--live-shots") + 1: argv.index("--live-shots") + 4]
        size = tuple(int(x) for x in argv[argv.index("--size") + 1].split("x")) if "--size" in argv else (110, 36)

        async def live():
            app = Welcome()
            os.makedirs(out, exist_ok=True)
            async with app.run_test(size=size) as pilot:
                await pilot.pause(0.2)
                await app.show([s[0] for s in STEPS].index(step))
                done = 0.0
                for t in (float(x) for x in at.split(",")):
                    await pilot.pause(t - done)
                    done = t
                    app.save_screenshot(os.path.join(out, f"server-welcome-{step}-{t:g}s.svg"))
                app.stop_pairing()
        asyncio.run(live())
        return 0
    Welcome().run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
