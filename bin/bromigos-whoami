#!/usr/bin/env python3
# bromigos:summary=Show who's signed in to a Bromigos account here, and how
# bromigos:args=[--json]
# bromigos:examples=bromigos whoami
"""bromigos-whoami (`bromigos whoami`, package bromigos-core): the command line of
lib/bromigos_login.py, the sign-in to your Bromigos account (docs/bromigos-account.md)."""
import os
import sys

for d in (os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"), "/usr/lib/bromigos/lib"):
    if os.path.isfile(os.path.join(d, "bromigos_login.py")):
        sys.path.insert(0, d)
        break
import bromigos_login  # noqa: E402

sys.exit(bromigos_login.main("whoami", sys.argv[1:]))
