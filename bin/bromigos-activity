#!/usr/bin/env python3
# bromigos:summary=What this computer and its lab are doing: long jobs with named steps, that keep running when you close the terminal, can ask you a question, and can be read later; ComfyUI generations and pipeline runs beside them
# bromigos:args=[list [--all] [--limit N] [--lab|--server] [--json]] | show [ID] [--log N] [--json] | watch [ID] [--lab|--server] [--no-images] [--once] | answer ID CHOICE [--json] | cancel ID [--json] | retry ID [--via VIA] [--device NAME] [--detach] [--json] | run --kind KIND --title WORDS [--subject TYPE:ID[:NAME]] [--lock NAME]… [--parent ID] [--cancel-safe] [--retry-safe] [--via VIA] [--device NAME] [--detach] [--json] -- COMMAND… | emit RUN start --title WORDS [--kind KIND] [--subject TYPE:ID[:NAME]] [--pid PID] | emit RUN ::LINE… | emit RUN media PATH [--step ID] [--output] | emit RUN end [STATE] [WORDS…] | follow [--system] [--once] [--poll S] [--idle S --wanted FILE] [--allow-dropin PATH]
# bromigos:examples=bromigos activity; bromigos activity watch; bromigos activity show; bromigos activity list --lab --json; sudo bromigos activity answer drive.replace swapped; sudo bromigos activity cancel backup; bromigos activity emit ships start --title "Universe assets: ships"; bromigos activity emit ships ::step cutout running Cutting out ship-a; sudo bromigos activity run --kind backup.run --title "Backing up" --lock backup-repo -- bromigos server backup run
"""bromigos-activity (`bromigos activity`): what this computer is doing (docs/activity.md).

  bromigos activity [list]            the jobs still going, then the newest that ended: this
                                      computer's, and its lab's (ComfyUI generations and
                                      pipeline runs, docs/activity.md "Lab jobs")
      --all                           every job kept (the last 30 days, 200 at most)
      --limit N                       at most N (default 20)
      --lab                           the lab's jobs only
      --server                        this computer's own jobs only
      --json                          the records
  bromigos activity show [ID]         one job: its steps, its notes, its command and the end of
                                      its log. ID is a job's id or a part of it; without one,
                                      the newest job
      --log N                         N lines of the log (default 20; 0 for all of it)
      --json                          the record, with the log's lines
  bromigos activity watch [ID]        follow the jobs live in this terminal: progress, stage,
                                      the queue, and in kitty the picture being made. Ctrl+C
                                      stops watching (the jobs carry on). With ID, that job
      --lab, --server                 as for list
      --no-images                     no pictures, even in kitty
      --once                          one look, then return (no live updates)
  bromigos activity answer ID CHOICE  answer the question a job asks (its state is "needs you").
                                      `show ID` prints the question and each CHOICE. The job
                                      carries on. Needs root
  bromigos activity cancel ID         stop a job. Refused unless the job says that stopping now
                                      is safe; it says why not. A job that only waits for
                                      another job can always be stopped. Needs root. A lab
                                      job: a queued generation leaves ComfyUI's queue, a
                                      running one is interrupted (no root needed)
  bromigos activity retry ID          start again a job that failed, was cancelled or was
                                      interrupted, when it was started with --retry-safe: a new
                                      job with the same command. Takes run's --via, --device,
                                      --detach and --json. Needs root
      --json                          (answer, cancel) what happened, and the record
  bromigos activity run --kind KIND --title WORDS [options] -- COMMAND…
                                      run COMMAND as a job. It gets its own systemd unit
                                      (bromigos-job-<id>.service), so it carries on when this
                                      terminal closes. What it prints shows here and goes to
                                      its log; its `::stage`, `::item` and `::step` lines
                                      become the record's steps. Needs root: it asks for your
                                      password (sudo, or polkit without a terminal)
      --kind KIND                     what sort of job: app.install, backup.run, drive.test, …
      --title WORDS                   plain words for people: "Backing up"
      --subject TYPE:ID[:NAME]        what it's about: app:photos:Photos
      --lock NAME                     what it must have to itself: apps, pool, backup-repo. While
                                      another job holds NAME this one waits ("waiting for
                                      another job"), in the order they started. Repeat for more
      --parent ID                     the job this one is a part of (default: the job that
                                      runs this command, if one does)
      --cancel-safe                   stopping it is safe, until it prints `::cancel unsafe WHY`
      --retry-safe                    starting it again after it failed is safe: allows `retry`
      --via VIA                       who asked: cli (default), board, phone, timer, vector
      --device NAME                   the device that asked
      --detach                        print the job's id and return at once
      --json                          don't show the output; print the record at the end

  bromigos activity emit RUN …        add a line to a job feed: how a tool that isn't run by
                                      `activity run` (a pipeline, a script on another
                                      schedule) shows its steps everywhere jobs show. RUN is
                                      short lower-case words (ships-20261112); the job's id is
                                      feed-RUN. The feed is ~/.local/state/bromigos/activity/
                                      feed/RUN.jsonl (root's: /var/lib/bromigos/activity/feed;
                                      BROMIGOS_ACTIVITY_FEED chooses another folder)
      start --title WORDS             begin the run (again): its title, and --kind (lab.pipeline),
                                      --subject TYPE:ID[:NAME], --pid PID (the process that does
                                      the work: when it's gone, the run reads as interrupted)
      ::step ID STATE [WORDS]         any progress line `run` reads: ::step, ::stage, ::item,
                                      ::note, ::error
      media PATH                      a picture, clip or 3D model of the step (a thumbnail);
                                      --step ID names the step, --output marks a result
      end [STATE] [WORDS]             the run ended: succeeded (default), failed or cancelled
  bromigos activity follow            keep the lab's jobs and their previews in a state folder,
                                      live, for the pages that show them (the Lab board, the
                                      start page). systemd runs it; --once looks once
      --system                        the machine's own settings and folders (the board's)
      --poll S                        seconds between looks at each ComfyUI (default 2)
      --idle S --wanted FILE          stop when nobody touched FILE for S seconds
      --allow-dropin PATH             write the systemd drop-in that lets the machine's follower
                                      connect to labjobs.toml's ComfyUIs and nothing else, and
                                      reload systemd when it changed (root; the board runs it)

Where there's no systemd (a container), `run` runs the job in this terminal, with the same record.

Exit status: `run` and `retry` end with COMMAND's own (130 when you stop watching with Ctrl+C,
or the job was cancelled; 127 when COMMAND isn't there). Otherwise 0, 1 for a problem said in
words (no such job), 2 for a wrong command, 3 when the job refused: it isn't asking, it has no
such answer, stopping it now isn't safe, or it can't be started again.
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import threading
import time

here = os.path.dirname(os.path.realpath(__file__))
for candidate in reversed((os.path.join(os.path.dirname(here), "lib"), "/usr/lib/bromigos/lib")):
    if os.path.isdir(candidate):
        sys.path.insert(0, candidate)

import bromigos_activity as A  # noqa: E402
import bromigos_labjobs as L  # noqa: E402

USAGE = __doc__.split("\n\n", 1)[1]
SELF = os.path.realpath(__file__)


def usage():
    print(USAGE, file=sys.stderr)
    return 2


def say(words):
    print("bromigos activity: " + words, file=sys.stderr)


def options(args, flags=(), values=(), many=()):
    """(the options found, what's left); None for an option this verb doesn't have. An option
    in `many` may be given more than once, and is a list."""
    got, rest = {}, []
    args = list(args)
    while args:
        a = args.pop(0)
        if a in flags:
            got[a] = True
        elif a in many and args:
            got.setdefault(a, []).append(args.pop(0))
        elif a in values and args:
            got[a] = args.pop(0)
        elif a.startswith("-"):
            return None, None
        else:
            rest.append(a)
    return got, rest


def number(text, default):
    try:
        return max(0, int(text))
    except (TypeError, ValueError):
        return default


def which(got):
    """list_jobs's lab and server from --lab and --server: both by default."""
    if "--lab" in got and "--server" in got:
        return None
    return {"lab": None if "--server" in got else {}, "server": "--lab" not in got}


def cmd_list(env, args):
    got, rest = options(args, ("--json", "--all", "--lab", "--server"), ("--limit",))
    if got is None or rest or which(got) is None:
        return usage()
    tidy(env)
    jobs = A.list_jobs(env, None if "--all" in got else number(got.get("--limit"), 20) or None, **which(got))
    if "--json" in got:
        print(json.dumps({"schema": A.SCHEMA, "jobs": jobs}, indent=1))
    else:
        print(A.plain_list(jobs, env.now_ms()))
    return 0


def cmd_show(env, args):
    got, rest = options(args, ("--json",), ("--log",))
    if got is None or len(rest) > 1:
        return usage()
    tidy(env)
    try:
        rec = A.find(env, rest[0] if rest else None)
    except KeyError as e:
        say(str(e.args[0]))
        return 1
    tail = [] if rec.get("lab") else A.log_tail(env, rec, number(got.get("--log"), 20))
    if "--json" in got:
        print(json.dumps({"schema": A.SCHEMA, "job": rec, "log_tail": tail}, indent=1))
    else:
        print(A.plain_show(rec, tail, env.now_ms()))
    return 0


def show_line(line):
    """A line of the job's output, to whoever watches. When they're gone, say so once (the
    caller stops showing) and let the rest of this process write to nowhere."""
    try:
        print(line, flush=True)
    except OSError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        raise


def announce(rec):
    """To whoever watches a job in a terminal: what it waits for, and what to type."""
    q = rec.get("question")
    if rec["state"] == "needs-you" and q:
        say(f"it asks: {q['text']}")
        for c in q["choices"]:
            say(f"  sudo bromigos activity answer {rec['id']} {c['id']}    ({c['label']})")
    elif rec["state"] == "waiting" and rec.get("waiting_for") == "another job":
        say((rec.get("stage") or "Waiting for another job to finish") + f"  ({rec['id']})")


def as_root(env):
    """Jobs are the system's: the same command again, as root (sudo, or polkit without a terminal)."""
    before = A.elevation(env, sys.stdin.isatty())
    if before:
        os.execvp(before[0], before + [SELF, *sys.argv[1:]])


def told(got, out):
    """An answer's or a cancel's outcome, said; the exit status (3 when the job refused)."""
    if "--json" in got:
        print(json.dumps(dict(schema=A.SCHEMA, **out), indent=1))
    elif out["ok"]:
        print(out["words"])
    else:
        say(out["words"])
    return 0 if out["ok"] else 3


def cmd_answer(env, args):
    got, rest = options(args, ("--json",))
    if got is None or len(rest) != 2:
        return usage()
    rec = A.find(env, rest[0])
    q = rec.get("question") or {}
    if rec["state"] == "needs-you" and rest[1] in [c["id"] for c in q.get("choices") or []]:
        as_root(env)                                 # only an answer the job would take asks for a password
    return told(got, A.answer(env, rec["id"], rest[1]))


def cmd_cancel(env, args):
    got, rest = options(args, ("--json",))
    if got is None or len(rest) != 1:
        return usage()
    rec = A.find(env, rest[0])
    if rec["state"] not in A.FINAL and rec.get("cancel_safe") and not rec.get("lab"):
        as_root(env)                                 # a lab job is the ComfyUI's: no root needed
    out = A.cancel(env, rec["id"])
    if out["refused"] == "unsafe" and "--json" not in got:
        say("not stopped. " + out["words"])
        unit = out["job"].get("unit")
        say("  To stop it anyway: " + (f"sudo systemctl stop {unit}" if unit else "press Ctrl+C in the terminal that runs it"))
        return 3
    return told(got, out)


def cmd_retry(env, args):
    got, rest = options(args, ("--json", "--detach"), ("--via", "--device"))
    if got is None or len(rest) != 1:
        return usage()
    rec = A.find(env, rest[0])
    why = A.retry_refusal(rec)
    if why:
        if "--json" in got:
            print(json.dumps({"schema": A.SCHEMA, "ok": False, "refused": "not-retryable", "words": why, "job": rec}, indent=1))
        else:
            say("not started again. " + why)
        return 3
    as_root(env)
    quiet = "--json" in got
    code, job_id = A.retry(env, rec["id"], got.get("--via", "cli"), got.get("--device"), detach="--detach" in got,
                           echo=None if quiet else show_line, self_argv=[SELF], note=say,
                           on_state=None if quiet else announce)
    return ran(env, got, code, job_id)


def cmd_run(env, args):
    if "--" in args:
        k = args.index("--")
        args, command = args[:k], args[k + 1:]
    else:
        command = []
    got, rest = options(args, ("--json", "--detach", "--cancel-safe", "--retry-safe"),
                        ("--kind", "--title", "--subject", "--via", "--device", "--job", "--parent"), ("--lock",))
    if got is None or rest:
        return usage()
    if "--job" in got:                               # inside the unit: be the job (start_unit runs this)
        return A.run_spec(env, got["--job"])
    if not command or "--kind" not in got or "--title" not in got:
        return usage()
    subject = A.parse_subject(got["--subject"]) if "--subject" in got else None
    A.check(got["--kind"], got["--title"], got.get("--via", "cli"))
    A.check_locks(got.get("--lock"))
    if not env.find(command[0]):
        say(f"no such command: {command[0]}")
        return 127
    as_root(env)
    quiet = "--json" in got
    parent = got.get("--parent")
    inside = env.environ.get("BROMIGOS_ACTIVITY_JOB")                # a job started by a job is a part of it
    if not parent and inside and A.JOB_ID_OK.match(inside) and A.alive(env, inside):
        parent = inside
    code, job_id = A.run(env, got["--kind"], got["--title"], command, subject, got.get("--via", "cli"), got.get("--device"),
                         detach="--detach" in got, echo=None if quiet else show_line,
                         self_argv=[SELF], note=say, locks=got.get("--lock") or (), parent=parent,
                         cancel_safe="--cancel-safe" in got, retry_safe="--retry-safe" in got,
                         on_state=None if quiet else announce)
    return ran(env, got, code, job_id)


def ran(env, got, code, job_id):
    """What `run` and `retry` print once the job is started (detached) or has ended."""
    quiet = "--json" in got
    detached = "--detach" in got and env.runner() == "systemd"
    if detached:                                     # it's on its way; its record follows
        print(json.dumps({"schema": A.SCHEMA, "id": job_id, "unit": A.unit_name(job_id)}) if quiet else job_id)
        return code
    try:
        rec = A.find(env, job_id)
    except KeyError:
        return code
    if quiet:
        print(json.dumps({"schema": A.SCHEMA, "job": rec}, indent=1))
    elif rec["state"] in A.FINAL:
        words = A.now_words(rec)
        say(f"{A.WORDS[rec['state']]}{': ' + words if words else ''}  ({job_id})")
    return code


def cmd_emit(env, args):
    """A line in a job feed (bromigos_labjobs.Feed)."""
    if len(args) < 2:
        return usage()
    run, what, rest = args[0].lower(), args[1], args[2:]
    if what == "start":
        got, left = options(rest, (), ("--title", "--kind", "--subject", "--pid"))
        if got is None or left or "--title" not in got:
            return usage()
        if "--subject" in got:
            A.parse_subject(got["--subject"])
        pid = number(got.get("--pid"), None) if "--pid" in got else None
        L.Feed(run, got["--title"], got.get("--kind", "lab.pipeline"), got.get("--subject"), env=env, pid=pid)
        return 0
    feed = L.Feed(run, run, env=env, resume=True, pid=None)
    if what.startswith("::"):
        feed.line(" ".join([what, *rest]))
    elif what == "media":
        got, left = options(rest, ("--output",), ("--step",))
        if got is None or len(left) != 1:
            return usage()
        if not os.path.isfile(left[0]):
            say(f"no such file: {left[0]}")
            return 1
        feed.media(left[0], got.get("--step"), output="--output" in got)
    elif what == "end":
        state = rest[0] if rest and rest[0] in ("succeeded", "failed", "cancelled") else "succeeded"
        words = " ".join(rest[1:] if rest and rest[0] == state else rest)
        feed.end(state, words)
    else:
        return usage()
    return 0


def cmd_follow(env, args):
    got, rest = options(args, ("--system", "--once"), ("--poll", "--idle", "--wanted", "--allow-dropin"))
    if got is None or rest:
        return usage()
    where = L.Where(env, system=True if "--system" in got else None)
    if "--allow-dropin" in got:
        # (root, before the board's follower starts: the only addresses it may connect to)
        changed = L.write_allow_dropin(where, got["--allow-dropin"])
        if changed and not env.stand_in and env.find("systemctl"):
            subprocess.run([env.find("systemctl"), "daemon-reload"], check=False)
        print("changed" if changed else "unchanged")
        return 0
    poll = max(0.5, float(got.get("--poll") or 2))
    idle = float(got["--idle"]) if got.get("--idle") else None
    return L.Follower(where, poll=poll).run(once="--once" in got, idle_s=idle, wanted=got.get("--wanted"))


def watch_frame(jobs, now, one=None, width=100):
    """What `watch` shows: (lines, the job whose picture goes beside them)."""
    if one:
        jobs = [j for j in jobs if j["id"] == one or one in j["id"]][:1]
    going = [j for j in jobs if j["state"] not in A.FINAL and j["state"] != "queued"]
    queued = [j for j in jobs if j["state"] == "queued"]
    ended = [j for j in jobs if j["state"] in A.FINAL][: 1 if one else 4]
    cut = lambda t, n=width: t if len(t) <= n else t[: n - 1] + "…"  # noqa: E731
    lines = []
    for j in going:
        lab = j.get("lab") or {}
        lines.append(cut(f"{A.MARKS['running']} {j['title']}  ({A.WORDS[j['state']]})"))
        lines.append(cut(f"  [{L.bar(j.get('pct'))}] " + (f"{j['pct']} %" if j.get("pct") is not None else "") +
                         (" (estimated)" if lab.get("estimated") else "") + (f"  {j['stage']}" if j.get("stage") else "")))
        t = []
        if lab.get("elapsed_ms") is not None:
            t.append(f"{A.took(lab['elapsed_ms'])} so far")
        elif not lab:
            t.append(f"{A.took(now - j['started_at'])} so far")
        if lab.get("estimate_ms"):
            t.append(f"usually {A.took(lab['estimate_ms'])}")
        if lab.get("instance"):
            t.append(f"ComfyUI {lab['instance']}")
        if lab.get("client"):
            t.append(f"from {lab['client']}")
        if t:
            lines.append(cut("  " + " · ".join(t)))
        if j["steps"]:
            lines.append(cut("  " + "  ".join(f"{A.MARKS[s['state']]} {s['label']}" for s in j["steps"][:8])))
        lines.append(f"  {j['id']}")
        lines.append("")
    if not going:
        lines += ["Nothing is running now.", ""]
    if queued:
        lines.append(f"Queue ({len(queued)})")
        lines += [cut(f"  {k + 1}. {j['title']}") for k, j in enumerate(queued[:8])]
        if len(queued) > 8:
            lines.append(f"  … and {len(queued) - 8} more")
        lines.append("")
    if ended:
        lines.append("Ended")
        lines += [cut(f"  {A.WORDS[j['state']]:<11} {A.ago(now - (j.get('ended_at') or j['started_at'])):<9} {j['title']}"
                      + (f": {A.now_words(j)}" if A.now_words(j) else "")) for j in ended]
    top = next((j for j in going if (j.get("lab") or {}).get("preview")), None) or \
        next((j for j in going + ended if ((j.get("result") or {}).get("outputs") or [])), None)
    return lines, top


def picture_of(job, media_dir):
    """The bytes of a job's live preview, else its first image output, or None."""
    lab = job.get("lab") or {}
    for m in [lab.get("preview")] + [o for o in (job.get("result") or {}).get("outputs") or [] if o.get("kind") == "image"]:
        if not isinstance(m, dict):
            continue
        for p in ([m["path"]] if m.get("path") else []) + [L.media_path(media_dir, n) for n in (m.get("thumb"), m.get("media"))
                                                             if n and media_dir]:
            if p and os.path.isfile(p):
                with open(p, "rb") as f:
                    return f.read(L.MEDIA_MAX)
    return None


def cmd_watch(env, args):
    got, rest = options(args, ("--lab", "--server", "--once", "--no-images"), ("--every",))
    if got is None or len(rest) > 1 or which(got) is None:
        return usage()
    one = rest[0] if rest else None
    every = max(0.5, float(got.get("--every") or 1))
    kinds = which(got)
    where = L.Where(env)
    follower = None
    if not "--once" in got and kinds["lab"] is not None and L.read_state(where)[0] is None:
        # nobody keeps the lab's state on this machine: follow it here while watching, for the
        # live progress and the pictures
        follower = L.Follower(where, poll=1.5, log=lambda words: None)
        threading.Thread(target=follower.run, daemon=True).start()
    tty = sys.stdout.isatty() and "--once" not in got
    pictures = tty and "--no-images" not in got and L.is_kitty(env.environ)
    shown = None
    try:
        while True:
            now = env.now_ms()
            jobs = A.list_jobs(env, None, **kinds)
            cols = shutil.get_terminal_size((100, 30)).columns
            lines, top = watch_frame(jobs, now, one, (cols - 44 if pictures else cols) - 1)
            head = ("LAB AND SERVER JOBS" if kinds["server"] and kinds["lab"] is not None else
                    "LAB JOBS" if kinds["lab"] is not None else "JOBS") + (f"  ·  {time.strftime('%H:%M:%S')}" if tty else "")
            lines = [L.clean(t) for t in lines]          # no record's text reaches the terminal as a control
            if not tty:
                print("\n".join([head, ""] + lines).rstrip())
                return 0
            out = ["\x1b[H"] + [f"{t}\x1b[K\n" for t in [head, ""] + lines] + ["\x1b[J"]
            pic = None
            if pictures and top:
                _, media_dir = L.read_state(where)
                pic = picture_of(top, media_dir)
            key = hashlib.sha256(pic).hexdigest() if pic else None
            if pictures and key != shown:
                draw = L.kitty_image(pic) if pic else None
                out.append(f"\x1b7\x1b[3;{max(1, cols - 42)}H" + (draw or "\x1b_Ga=d,d=I,i=7311,q=2\x1b\\") + "\x1b8")
                shown = key
            sys.stdout.write("".join(out))
            sys.stdout.flush()
            time.sleep(every)
    except KeyboardInterrupt:
        return 0
    finally:
        if follower:
            follower.stop.set()
        if pictures:
            sys.stdout.write("\x1b_Ga=d,d=I,i=7311,q=2\x1b\\\n")
            sys.stdout.flush()


def tidy(env):
    """Whoever may write the folder closes what a restart left running, and drops the old."""
    if os.access(env.jobs_dir(), os.W_OK):
        A.sweep(env)


def main(argv):
    args = list(argv)
    verb = args[0] if args and not args[0].startswith("-") else "list"
    rest = args[1:] if args and not args[0].startswith("-") else args
    if verb != "run" and any(a in ("-h", "--help") for a in rest) or verb == "help":
        print(USAGE)
        return 0
    if verb == "run" and any(a in ("-h", "--help") for a in (rest[:rest.index("--")] if "--" in rest else rest)):
        print(USAGE)
        return 0
    env = A.Env()
    try:
        if verb == "list":
            return cmd_list(env, rest)
        if verb == "show":
            return cmd_show(env, rest)
        if verb == "run":
            return cmd_run(env, rest)
        if verb == "answer":
            return cmd_answer(env, rest)
        if verb == "cancel":
            return cmd_cancel(env, rest)
        if verb == "retry":
            return cmd_retry(env, rest)
        if verb == "watch":
            return cmd_watch(env, rest)
        if verb == "emit":
            return cmd_emit(env, rest)
        if verb == "follow":
            return cmd_follow(env, rest)
    except (A.ActivityError, KeyError) as e:
        say(str(e.args[0]) if e.args else str(e))
        return 1
    except PermissionError as e:
        say(f"can't write {e.filename or 'the activity folder'}: jobs are the system's, so starting one needs root")
        return 1
    return usage()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:                          # whoever read this went away
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(141)
