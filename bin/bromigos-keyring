#!/usr/bin/env python3
# bromigos:summary=The keyring that keeps your sign-ins (oo7): whether it runs and your login unlocks it, and setting that up
# bromigos:args=status [--json] | setup [--dry-run]
# bromigos:examples=bromigos keyring status; bromigos keyring setup
"""bromigos-keyring (`bromigos keyring …`, package bromigos-core): the command line of
lib/bromigos_keyring.py. `setup` adds oo7's lines to the login's PAM files, through sudo,
and turns KWallet's own Secret Service off (docs/bromigos-account.md, "The keyring")."""
import os
import sys

for d in (os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"), "/usr/lib/bromigos/lib"):
    if os.path.isfile(os.path.join(d, "bromigos_keyring.py")):
        sys.path.insert(0, d)
        break
import bromigos_keyring  # noqa: E402

sys.exit(bromigos_keyring.main(sys.argv[1:]))
