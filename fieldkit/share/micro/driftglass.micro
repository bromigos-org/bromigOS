# DRIFTGLASS for micro (docs/fieldkit.md): the console's 16 colours, which bromigos-boot sets to
# the Wick's (palette.vtrgb), so it reads the same on the Linux console and over SSH.
color-link default "white,black"
color-link comment "brightblack"
color-link identifier "brightgreen"
color-link constant "cyan"
color-link constant.string "yellow"
color-link constant.number "cyan"
color-link statement "green"
color-link symbol "white"
color-link preproc "brightcyan"
color-link type "brightgreen"
color-link special "magenta"
color-link underlined "underline cyan"
color-link error "bold red"
color-link todo "bold yellow"
color-link selection "black,green"
color-link cursor-line "black"
color-link line-number "brightblack"
color-link current-line-number "green"
color-link statusline "black,green"
color-link tabbar "black,green"
color-link indent-char "brightblack"
color-link gutter-error "red"
color-link gutter-warning "yellow"
color-link diff-added "green"
color-link diff-modified "yellow"
color-link diff-deleted "red"
color-link scrollbar "green"
