# btop theme: "{{ theme }}" ({{ meta.name }}), written by `bromigos theme set`. Don't edit.
# The theme-set hook links it to ~/.config/btop/themes/bromigos.theme; btop.conf then
# says color_theme = "bromigos" (bromigos-apps' default does).
theme[main_bg]="{{ background }}"
theme[main_fg]="{{ text }}"
theme[title]="{{ primary }}"
theme[hi_fg]="{{ primary }}"
theme[selected_bg]="{{ selection }}"
theme[selected_fg]="{{ primary }}"
theme[inactive_fg]="{{ faint }}"
theme[graph_text]="{{ soft }}"
theme[meter_bg]="{{ selection }}"
theme[proc_misc]="{{ cyan }}"
theme[cpu_box]="{{ dim }}"
theme[mem_box]="{{ dim }}"
theme[net_box]="{{ dim }}"
theme[proc_box]="{{ dim }}"
theme[div_line]="{{ dim }}"
theme[temp_start]="{{ primary }}"
theme[temp_mid]="{{ warn }}"
theme[temp_end]="{{ danger }}"
theme[cpu_start]="{{ primary }}"
theme[cpu_mid]="{{ warn }}"
theme[cpu_end]="{{ danger }}"
theme[free_start]="{{ dim }}"
theme[free_mid]="{{ primary }}"
theme[free_end]="{{ soft }}"
theme[cached_start]="{{ dim }}"
theme[cached_mid]="{{ cyan }}"
theme[cached_end]="{{ soft }}"
theme[available_start]="{{ dim }}"
theme[available_mid]="{{ primary }}"
theme[available_end]="{{ soft }}"
theme[used_start]="{{ primary }}"
theme[used_mid]="{{ warn }}"
theme[used_end]="{{ danger }}"
theme[download_start]="{{ dim }}"
theme[download_mid]="{{ primary }}"
theme[download_end]="{{ soft }}"
theme[upload_start]="{{ dim }}"
theme[upload_mid]="{{ warn }}"
theme[upload_end]="{{ gold }}"
theme[process_start]="{{ dim }}"
theme[process_mid]="{{ primary }}"
theme[process_end]="{{ danger }}"
