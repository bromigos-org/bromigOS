# Test doubles only: the real Plymouth interpreter runs the theme without a daemon,
# a display, a console or a service. Every image and sprite is an in-memory record.
Window.GetWidth = fun () { return global.test_width; };
Window.GetHeight = fun () { return global.test_height; };
Window.GetX = fun () { return 0; };
Window.GetY = fun () { return 0; };
Window.SetBackgroundTopColor = fun (r, g, b) { };
Window.SetBackgroundBottomColor = fun (r, g, b) { };

Image.GetWidth = fun () { return this.width; };
Image.GetHeight = fun () { return this.height; };
Image.Scale = fun (width, height) {
    result = [] | global.Image;
    result.name = this.name; result.text = this.text;
    result.width = width; result.height = height; result.angle = this.angle;
    return result;
};
Image.Rotate = fun (angle) {
    result = this.Scale(this.width, this.height);
    result.angle = angle;
    return result;
};
Image.Text = fun (text, r, g, b) {
    result = [] | global.Image;
    result.text = text; result.name = "text";
    result.width = 200; result.height = 24;
    if (text == "") result.width = 0;
    return result;
};
Image |= fun (name) {
    result = [] | global.Image;
    result.name = name; result.width = 512; result.height = 512; result.angle = 0;
    return result;
};

Sprite.SetImage = fun (image) { this.image = image; };
Sprite.SetX = fun (x) { this.x = x; };
Sprite.SetY = fun (y) { this.y = y; };
Sprite.SetZ = fun (z) { this.z = z; };
Sprite |= fun (image) {
    result = [] | global.Sprite;
    result.image = image; result.x = 0; result.y = 0; result.z = 0;
    return result;
};

Plymouth.GetMode = fun () { return global.test_mode; };
Plymouth.SetRefreshFunction = fun (callback) { global.refresh = callback; };
Plymouth.SetBootProgressFunction = fun (callback) { global.progress = callback; };
Plymouth.SetMessageFunction = fun (callback) { global.legacy_message = callback; };
Plymouth.SetDisplayMessageFunction = fun (callback) { global.display_message = callback; };
Plymouth.SetDisplayPasswordFunction = fun (callback) { global.password = callback; };
Plymouth.SetDisplayNormalFunction = fun (callback) { global.normal = callback; };
Plymouth.SetQuitFunction = fun (callback) { global.quit = callback; };
