#!/usr/bin/env bash
# Install bromigOS from the live medium (docs/iso.md): archinstall builds the Arch system
# (btrfs on LUKS2, GRUB with snapper's snapshots in its menu) and bromigOS's own installer
# runs in it, all from the medium's offline repository.
#
#   bromigos-iso-install                      the installer, in this terminal (the text
#                                             installer: the same steps as the graphical one)
#   bromigos-iso-install --answers FILE       what the installers run: their answers (JSON;
#                                             bromigos_installer.common.backend_answers):
#                                             the disk (erased, or bromigOS beside what's
#                                             there, shrinking it first when asked), the user,
#                                             the edition, encryption, keyboard, time zone
#   bromigos-iso-install --config C --creds K unattended: archinstall's config and credentials
#                                             (answers.py writes them: /usr/local/lib/bromigos-iso)
#   options  --menu          with --config: archinstall's menu, prefilled, to change anything
#                            there before it installs
#            --repo URL      the package repository the installed system updates from
#                            (default: the medium's, /etc/bromigos-iso/repo.url)
#            --channel NAME  stable (default: the medium's), rc or edge: which of the
#                            repository's channels the installed system follows
#            --ca FILE       that repository's TLS CA, if it has its own
#            --with PKG      optional bromigOS pieces (bromigos-homelab, herdr; repeatable)
#            --ssh-key FILE  authorize this public key for the new user and enable sshd
#            --no-reboot     stay here when it's done
#            --dry-run       say what it would do
# Progress goes to stdout as `::stage PERCENT plain words` lines and a failure's reason as
# one `::error plain words` line (the installers show them); everything else is detail.
set -euo pipefail

lib=/usr/local/lib/bromigos-iso
repo_dir=/var/lib/bromigos/repo
target=/mnt                      # where archinstall mounts the new system (4.x; older: /mnt/archinstall)
log=/var/log/bromigos-iso-install.log

config='' creds='' answers='' repo='' ca='' channel='' sshkey='' reboot=1 dry=0 menu=0 extras=()
desktop=1 mode=erase other_os=0 online=0 full_name='' xkb_layout='' xkb_variant=''   # from --answers
(($#)) || PYTHONPATH=$lib exec python3 -m bromigos_installer.tui
while (($#)); do
    case $1 in
        --answers) answers=$2; shift 2 ;;
        --config) config=$2; shift 2 ;;
        --creds) creds=$2; shift 2 ;;
        --menu) menu=1; shift ;;
        --repo) repo=$2; shift 2 ;;
        --channel) channel=$2; shift 2 ;;
        --ca) ca=$2; shift 2 ;;
        --with) extras+=("$2"); shift 2 ;;
        --ssh-key) sshkey=$2; shift 2 ;;
        --no-reboot) reboot=0; shift ;;
        --dry-run) dry=1; shift ;;
        --text|--plain) PYTHONPATH=$lib exec python3 -m bromigos_installer.tui "$@" ;;
        -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "bromigos-iso-install: unknown option $1" >&2; exit 2 ;;
    esac
done
[[ $EUID -eq 0 ]] || { echo "bromigos-iso-install: run it with sudo" >&2; exit 2; }
[[ -n $config || -n $answers ]] || { echo "bromigos-iso-install: --answers FILE, or --config and --creds" >&2; exit 2; }
[[ -z $config || -n $creds ]] || { echo "bromigos-iso-install: --config needs --creds" >&2; exit 2; }
[[ -n $repo ]] || repo=$(cat /etc/bromigos-iso/repo.url 2>/dev/null || true)
[[ -n $repo ]] || repo="https://pkgs.example.invalid"        # no repository known: updates wait for one
[[ -n $channel ]] || channel=$(cat /etc/bromigos-iso/channel 2>/dev/null || echo stable)
case $channel in edge) sub='' ;; stable|rc) sub="/$channel" ;; *) echo "bromigos-iso-install: --channel is stable, rc or edge" >&2; exit 2 ;; esac
[[ -n $ca || ! -f /etc/bromigos-iso/repo-ca.crt ]] || ca=/etc/bromigos-iso/repo-ca.crt
[[ -d $repo_dir/bromigos ]] || { echo "bromigos-iso-install: no offline repository at $repo_dir" >&2; exit 1; }

say() { printf '%s\n' "$*" | tee -a "$log"; }
run() { say "+ $*"; (( dry )) || "$@"; }
in_target() { run arch-chroot "$target" "$@"; }
# stage PERCENT "plain words": the installers' progress bar and status line
now_stage='Starting'
stage() { now_stage=$2; printf '::stage %s %s\n' "$1" "$2"; printf '[%s%%] %s\n' "$1" "$2" >> "$log"; }
# a failure, in plain words, with what to do (the installers show it; the log keeps the rest)
fail_words() {
    printf '::error %s stopped and the install didn'"'"'t finish. %s The details are in %s on the live system.\n' \
        "$now_stage" "$1" "$log"
}
# a reinstall that stops before its new system can start puts the old one back
# (reinstall.py undo: @ again from @old-root-DATE, its kernels back on /boot)
reinstall_open=0
reinstall_undo() {
    (( reinstall_open )) || return 1
    reinstall_open=0
    PYTHONPATH=$lib python3 "$lib/bromigos_installer/reinstall.py" undo --answers "$answers" 2>&1 | grep -v '^::error' | tee -a "$log" >/dev/null
    (( PIPESTATUS[0] == 0 ))
}
on_error() {
    local rc=$?
    trap - ERR
    if [[ ${mode:-} == reinstall ]] && reinstall_undo; then
        fail_words "Your old bromigOS was put back as it was, and your files weren't touched. Restart and try again."
        exit "$rc"
    fi
    case $now_stage in
        Making\ room*) fail_words "The other system's files are as they were." ;;
        Checking*|Reading*) fail_words "Nothing on the disk was changed." ;;
        *) fail_words "Restart and try again. If it happens again, choose Erase the whole disk, or install on another disk." ;;
    esac
    exit "$rc"
}
trap on_error ERR

say "== bromigos-iso-install $(date -Is)"

# ── 0. the installers' answers: the room made, archinstall's files written ──────────────
ans() { python3 -c 'import json,sys; v = json.load(open(sys.argv[1])).get(sys.argv[2]); print("" if v is None else (int(v) if isinstance(v, bool) else v))' "$answers" "$1"; }
# how the person chose to be guided (the installers' first step): guidance voice_guide|accessibility
# prints that file's JSON; acc KEY prints 1 or 0 for one accessibility choice
guidance() { [[ -n $answers ]] && python3 -c 'import json,sys; g = (json.load(open(sys.argv[1])).get("guidance") or {}).get(sys.argv[2]); print(json.dumps(g, indent=2) if g else "")' "$answers" "$1"; }
acc() { [[ -n $answers ]] && python3 -c 'import json,sys; print(int(bool(((json.load(open(sys.argv[1])).get("guidance") or {}).get("accessibility") or {}).get(sys.argv[2]))))' "$answers" "$1" || echo 0; }
if [[ -n $answers ]]; then
    stage 2 "Checking your choices"
    mode=$(ans mode); desktop=$(ans desktop); other_os=$(ans other_os); online=$(ans online)
    full_name=$(ans full_name); xkb_layout=$(ans xkb_layout); xkb_variant=$(ans xkb_variant)
    [[ -n $(ans disk) && -b $(ans disk) ]] || { now_stage="Checking your choices"; printf '::error The disk chosen (%s) is gone. Plug it back in and start the installer again.\n' "$(ans disk)"; exit 1; }
    say "answers: $(python3 -c 'import json,sys; d = json.load(open(sys.argv[1])); [d.pop(k, None) for k in ("password", "passphrase")]; print(json.dumps(d))' "$answers")"
    if (( ! dry )) && [[ $mode == reinstall ]]; then
        # the old system kept as a snapshot, a fresh root, your home as it is: mounted at /mnt
        now_stage="Opening your bromigOS"
        reinstall_open=1
        PYTHONPATH=$lib python3 "$lib/bromigos_installer/reinstall.py" prepare --answers "$answers" | tee -a "$log"
        (( PIPESTATUS[0] == 0 )) || { trap - ERR; reinstall_undo || true; exit 1; }
    elif (( ! dry )); then
        now_stage="Making room"
        python3 "$lib/bromigos_installer/disks.py" shrink --answers "$answers" | tee -a "$log"
        (( PIPESTATUS[0] == 0 )) || { trap - ERR; exit 1; }
    fi
    now_stage="Preparing the installation"
    out=$(mktemp -d)
    python3 "$lib/answers.py" --answers "$answers" --out "$out" >/dev/null
    config=$out/config.json; creds=$out/creds.json
    stage 10 "Your choices are ready"
fi

# ── 0a. an online install (an edition this medium doesn't carry): Arch's mirrors and
# bromigOS's repository first in the live system's pacman.conf, the databases synced
if (( online && ! dry )); then
    stage 10 "Connecting to the package servers"
    python3 - /etc/pacman.conf "$repo" "$sub" <<'PY'
import re, sys
path, repo, sub = sys.argv[1:4]
out, sect = [], ""
for line in open(path).read().split("\n"):
    if line.startswith("["):
        sect = line.strip()
        out.append(line)
        if sect in ("[core]", "[extra]"):
            out.append("Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch")
        elif sect == "[bromigos]":
            out.append(f"Server = {repo}/$repo{sub}/$arch")
        continue
    out.append(line)
open(path, "w").write("\n".join(out))
PY
    pacman -Sy >/dev/null 2>&1 || { printf '::error The package servers can'"'"'t be reached, so what you chose can'"'"'t be downloaded. Check the network (cable or Wi-Fi), or choose Field Kit, which is on this USB stick.\n'; exit 1; }
fi

# ── 0b. the hardware: what this machine's GPU and kind need (`bromigos hw`, read here: the
# live system's /sys is the machine's), added to archinstall's packages and services so they
# come from the medium too; `bromigos install`'s hardware step writes the rest in step 2
# (the desktop's: Field Kit has no desktop to draw)
if (( desktop )) && hwjson=$(bromigos hw detect --json 2>/dev/null) && [[ -n $hwjson ]]; then
    hwconfig=$(mktemp --suffix=.json)
    if line=$(python3 "$lib/hardware.py" "$config" "$hwconfig" <<<"$hwjson"); then
        say "hardware: $line"
        config=$hwconfig
    else
        say "hardware: couldn't read bromigos hw's plan; the GPU's drivers wait for \`bromigos hw setup\` after the install"
    fi
fi

# ── 1. archinstall: the Arch system ─────────────────────────────────────────────────────
args=(--config "$config" --creds "$creds" --skip-ntp --skip-wkd --skip-version-check --skip-wifi-check)
(( online )) || args+=(--offline)
# a reinstall's boot loader is reinstall.py's (archinstall reads "No bootloader" only with this)
[[ ${mode:-} != reinstall ]] || args+=(--skip-boot)
(( menu )) || args+=(--silent)
say "archinstall ${args[*]}"
if (( ! dry )); then
    # pacman's keyring, which archinstall verifies every package with: archiso's pacman-init
    # fills it after time-sync.target (30 s at most with no network, the medium's
    # systemd-time-wait-sync drop-in); started here, it waits for that, or returns at once
    systemctl start pacman-init.service || { say "pacman's keyring isn't ready (systemctl status pacman-init)"; exit 1; }
    stage 11 "Preparing the disk"
    # its output, read for the progress bar (progress.py: partitions, encryption, each
    # package, the boot loader), lands in the log as it is
    if (( menu )); then
        archinstall "${args[@]}"
    else
        archinstall "${args[@]}" 2>&1 | python3 "$lib/bromigos_installer/progress.py" | tee -a "$log"
        (( PIPESTATUS[0] == 0 )) || { now_stage="Installing the system"; false; }
    fi
    [[ -d $target/etc/pacman.d ]] || target=/mnt/archinstall
    [[ -d $target/etc/pacman.d ]] || { say "archinstall didn't leave a system at /mnt (nor /mnt/archinstall)"; exit 1; }
    say "the new system is at $target"
fi

# ── 1b'. a reinstall: the old system's people back (their user IDs and passwords), the
# disk's unlocking and GRUB (archinstall had a pre-mounted root: no boot loader of its own)
if (( ! dry )) && [[ $mode == reinstall ]]; then
    now_stage="Bringing back your files and people"
    PYTHONPATH=$lib python3 "$lib/bromigos_installer/reinstall.py" finish --answers "$answers" | tee -a "$log"
    (( PIPESTATUS[0] == 0 )) || { trap - ERR; reinstall_undo || true; exit 1; }
    PYTHONPATH=$lib python3 "$lib/bromigos_installer/reinstall.py" boot --answers "$answers" | tee -a "$log"
    (( PIPESTATUS[0] == 0 )) || { trap - ERR; reinstall_undo || true; exit 1; }
    reinstall_open=0                    # the new system starts now: no going back
    PYTHONPATH=$lib python3 "$lib/bromigos_installer/reinstall.py" tidy --answers "$answers" | tee -a "$log"
fi

# ── 1b. snapper's configuration for /home ───────────────────────────────────────────────
# archinstall doesn't make snapper's configurations here (4.5 reads a config file's subvolume
# names as strings, so it never finds `@` on `/`). /home's is the installer's (the user's files,
# snapshotted by the timer); /'s is `bromigos rollback setup`'s, in step 3, with the snapshots in
# GRUB's menu. wheel (the user) may list them.
if (( ! dry )) && [[ $(findmnt -no FSTYPE "$target") == btrfs ]]; then
    configs=$(arch-chroot "$target" snapper --no-dbus list-configs 2>/dev/null || true)
    if ! grep -q '^home ' <<<"$configs"; then
        in_target snapper --no-dbus -c home create-config /home
        in_target snapper --no-dbus -c home set-config ALLOW_GROUPS=wheel SYNC_ACL=yes
    fi
fi

# ── 1c. installed beside another system: /boot a plain Linux partition again (on GPT
# archinstall's boot flag made it an EFI system partition's type; the disk keeps one ESP,
# Windows'), and the other systems in GRUB's menu (os-prober, read at every grub-mkconfig)
if (( ! dry )) && [[ $mode == alongside ]]; then
    bootdev=$(findmnt -no SOURCE "$target/boot")
    disk=/dev/$(lsblk -no PKNAME "$bootdev")
    if [[ $(lsblk -dno PTTYPE "$disk") == gpt ]]; then
        run sfdisk --part-type "$disk" "$(cat "/sys/class/block/$(basename "$bootdev")/partition")" 0FC63DAF-8483-4772-8E79-3D69D8477DE4
    fi
fi
if (( ! dry )) && (( other_os )) && [[ -f $target/etc/default/grub ]]; then
    if grep -qE '^#?GRUB_DISABLE_OS_PROBER=' "$target/etc/default/grub"; then
        sed -i -E 's/^#?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' "$target/etc/default/grub"
    else
        echo 'GRUB_DISABLE_OS_PROBER=false' >> "$target/etc/default/grub"
    fi
    # the menu waits for a choice a little longer when there's more than one system
    sed -i -E 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=10/' "$target/etc/default/grub"
fi

# ── 2. bromigOS in the new system ───────────────────────────────────────────────────────
stage 76 "Setting up your account"
user=''
if (( ! dry )); then
    user=$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /nologin|false/ { print $1; exit }' "$target/etc/passwd")
    [[ -n $user ]] || { say "no user in the new system (archinstall's user step)"; exit 1; }
    [[ -z $full_name ]] || in_target usermod -c "$full_name" "$user"
fi
say "the new system's user: ${user:-<dry run>}"

# the medium's repository, visible inside the chroot at the same path (file:// URLs)
run mkdir -p "$target$repo_dir"
run mount --bind "$repo_dir" "$target$repo_dir"
cleanup() { umount "$target$repo_dir" 2>/dev/null || true; }
trap cleanup EXIT

# pacman: Arch's mirrors (the geo mirror first, the stock list after it, for the first
# `pacman -Syu` once there's a network) and bromigOS's repository at its real URL; the
# offline copy served the install and isn't carried over
if (( ! dry )); then
    mirrorlist=$(ls "$repo_dir"/core/os/x86_64/pacman-mirrorlist-*.pkg.tar.zst 2>/dev/null | head -1)
    {
        echo '## Arch Linux repository mirrorlist (bromigOS: the geo mirror first; `reflector` picks closer ones)'
        echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch'
        [[ -n $mirrorlist ]] && tar -xOf "$mirrorlist" etc/pacman.d/mirrorlist | grep -v '^Server = file://' || true
    } > "$target/etc/pacman.d/mirrorlist"
    python3 - "$target/etc/pacman.conf" "$repo" "$sub" <<'PY'
import sys
path, repo, sub = sys.argv[1:4]
out, skip = [], False
for line in open(path).read().split("\n"):
    if line.startswith("["):                          # every [bromigos] section goes (the medium's)
        skip = line.strip() == "[bromigos]"
    if skip or line.replace(" ", "").startswith("Server=file:///var/lib/bromigos/repo"):
        continue                                      # and the offline copy's servers in core/extra
    out.append(line)
s = "\n".join(out).rstrip("\n") + f"\n\n[bromigos]\nSigLevel = Required DatabaseOptional\nServer = {repo}/$repo{sub}/$arch\n"
open(path, "w").write(s)
PY
    if [[ -n $ca ]]; then
        install -Dm0644 "$ca" "$target/etc/ca-certificates/trust-source/anchors/bromigos-repo-ca.crt"
        in_target update-ca-trust
    fi
fi

# bromigOS's installer, as the new user (sudo without a password for its commands only;
# the file goes when they're done). The packages are installed by archinstall from
# the offline copy, so this is the thin configs, the desktop settings and the theme.
if (( ! dry )); then
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$user" > "$target/etc/sudoers.d/90-bromigos-iso-install"
    chmod 440 "$target/etc/sudoers.d/90-bromigos-iso-install"
fi
with=(); for e in "${extras[@]}"; do with+=(--with "$e"); done
# an edition with no desktop: its own first steps as the new user (user_commands), and it
# starts to the text console
if (( ! desktop )) && [[ -n $answers ]] && (( ! dry )); then
    while IFS= read -r c; do
        [[ -n $c ]] || continue
        in_target sudo -u "${user:-user}" -H bash -lc "$c" || say "the edition's step '$c' reported a problem"
    done < <(python3 -c 'import json, sys; print("\n".join(json.load(open(sys.argv[1])).get("user_commands") or []))' "$answers")
    in_target systemctl set-default "$(ans default_target)"
    # its name in GRUB's menu, until its boot package names it (the desktop's boot theme does)
    if [[ -f $target/etc/default/grub ]] && ! grep -q '^GRUB_DISTRIBUTOR="bromigOS' "$target/etc/default/grub"; then
        sed -i -E 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="bromigOS Server"/' "$target/etc/default/grub"
        grep -q '^GRUB_DISTRIBUTOR=' "$target/etc/default/grub" || echo 'GRUB_DISTRIBUTOR="bromigOS Server"' >> "$target/etc/default/grub"
    fi
    # the welcome tour at the first sign-in (bromigos welcome-console: the network, SSH, the lab)
    in_target sudo -u "${user:-user}" -H sh -c 'mkdir -p ~/.local/state/bromigos && touch ~/.local/state/bromigos/welcome-pending'
fi
if (( desktop )); then
    stage 78 "Setting up the desktop"
    in_target sudo -u "${user:-user}" -H bromigos install --yes --no-services --no-setup "${with[@]}"
    # the first-run answers a fresh install can give here: the outputs as they are now (the
    # machine's own: /sys is the target's), the Wick, VECTOR's brain and voice off (bromigos
    # setup, any time, for a brain, a voice, a homelab)
    a11y=()          # the first step's Reduce motion and High contrast (bromigos accessibility)
    [[ $(acc reduce_motion) == 1 ]] && a11y+=(--motion reduced)
    [[ $(acc high_contrast) == 1 ]] && a11y+=(--contrast high)
    in_target sudo -u "${user:-user}" -H bromigos setup --monitors auto --theme wick --vector none --voice off --create none "${a11y[@]}"
    # the welcome tour at the first login (bromigos welcome --if-pending: Wi-Fi, screens, a
    # world, VECTOR, the homelab, the keys; the answers above are its starting point)
    in_target sudo -u "${user:-user}" -H sh -c 'mkdir -p ~/.local/state/bromigos && touch ~/.local/state/bromigos/welcome-pending'
    # the keyboard chosen, for the desktop too (the console's is archinstall's vconsole.conf)
    if [[ -n $xkb_layout ]]; then
        kb=(--set kb_layout "$xkb_layout"); [[ -n $xkb_variant ]] && kb+=(--set kb_variant "$xkb_variant")
        in_target sudo -u "${user:-user}" -H bromigos setup input "${kb[@]}" \
            || say "the desktop's keyboard layout wasn't set (Settings › Keyboard & input sets it)"
    fi
fi

# how the person chose to be guided (the installers' first step; docs/voice-guide.md): the voice
# guide's on and muted, and the other choices (screen reader, larger text, high contrast, less
# motion), in the new user's ~/.local/state/bromigos, where the welcome tour reads them first
if [[ -n $answers ]] && (( ! dry )); then
    for pair in voice_guide:voice-guide accessibility:accessibility; do
        doc=$(guidance "${pair%%:*}")
        [[ -n $doc ]] || continue
        printf '%s\n' "$doc" | in_target sudo -u "${user:-user}" -H sh -c \
            "mkdir -p ~/.local/state/bromigos && cat > ~/.local/state/bromigos/${pair#*:}.json" \
            || say "how you chose to be guided wasn't saved (${pair#*:}.json); the welcome tour starts as usual"
    done
    # the console's bigger letters (terminus-font, from answers.py when it was chosen)
    if [[ $(acc console_font) == 1 ]]; then
        if [[ -f $target/usr/share/kbd/consolefonts/ter-v32n.psf.gz ]]; then
            touch "$target/etc/vconsole.conf"
            sed -i '/^FONT=/d' "$target/etc/vconsole.conf"
            echo 'FONT=ter-v32n' >> "$target/etc/vconsole.conf"
        else
            say "the console's bigger font isn't installed (terminus-font): the console keeps its letters"
        fi
    fi
fi

# ── 3. the splash, the snapshots in GRUB's menu, SSH ───────────────────────────────────
stage 86 "Setting up the boot menu and snapshots"
if (( ! dry && desktop )); then
    # the plymouth hook, right after udev (or systemd) and before encrypt, which asks for the
    # passphrase through Plymouth when it runs; in every file that sets HOOKS (archinstall
    # 4.5 writes /etc/mkinitcpio.conf's; a drop-in in mkinitcpio.conf.d would override it)
    for conf in "$target/etc/mkinitcpio.conf" "$target"/etc/mkinitcpio.conf.d/*.conf; do
        [[ -f $conf ]] && grep -qE '^HOOKS=' "$conf" || continue
        grep -qE '^HOOKS=.*\bplymouth\b' "$conf" || sed -i -E 's/^(HOOKS=\([^)]*\b(udev|systemd)\b)/\1 plymouth/' "$conf"
    done
fi
# `splash quiet` on the kernel line (the desktop's; Field Kit keeps the boot's text): GRUB's
# default (archinstall's choice here), or systemd-boot's entries if a config chose that.
# grub-mkconfig after it, which also lists the other systems found (os-prober, step 1c)
if (( ! dry )); then
    if [[ -f $target/etc/default/grub ]]; then
        words=(quiet); (( desktop )) && words=(splash quiet)
        for w in "${words[@]}"; do
            grep -qE "^GRUB_CMDLINE_LINUX_DEFAULT=\"[^\"]*\b$w\b" "$target/etc/default/grub" && continue
            sed -i -E "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"([^\"]*)\"/GRUB_CMDLINE_LINUX_DEFAULT=\"\1 $w\"/" "$target/etc/default/grub"
        done
        sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=")\s+/\1/' "$target/etc/default/grub"
        in_target grub-mkconfig -o /boot/grub/grub.cfg
    fi
    for f in "$target"/boot/loader/entries/*.conf; do
        (( desktop )) || continue
        [[ -f $f ]] && grep -q '^options' "$f" && ! grep -q 'splash' "$f" && sed -i 's/^options .*/& splash quiet/' "$f"
    done
fi
(( ! desktop )) || in_target plymouth-set-default-theme bromigos
# the snapshots and the boot menu: `bromigos rollback setup`, as on any machine (`bromigos
# install` skipped its rollback step under --no-services). It sees the chroot (its root mount
# isn't PID 1's) and runs snapper with --no-dbus (the bus arch-chroot binds in is the live
# system's): snapper's root configuration (@.snapshots comes off
# /.snapshots while snapper makes it, then goes back on), wheel allowed to list it (`bromigos
# update` records each update for --rollback as the user), grub-btrfs-overlayfs last in HOOKS
# (a snapshot booted from GRUB's menu is read-only; the hook lays a writable overlay on it)
# and the initramfs made again. snap-pac, grub-btrfs and its daemon are archinstall's.
root_fs=btrfs; (( dry )) || root_fs=$(findmnt -no FSTYPE "$target")
if [[ $root_fs == btrfs ]]; then
    in_target sudo -u "${user:-user}" -H bromigos rollback setup --yes
else
    say "the root is $root_fs: no snapshots (they need btrfs)"
fi
# the initramfs with the splash theme: setup made it again when it added the hook; if it had
# nothing to add, now
if (( ! dry && desktop )) && ! lsinitcpio "$target/boot/initramfs-linux.img" 2>/dev/null | grep -q 'usr/share/plymouth/themes/bromigos/'; then
    in_target mkinitcpio -P
fi
[[ $root_fs != btrfs ]] || in_target sudo -u "${user:-user}" -H bromigos rollback status

run rm -f "$target/etc/sudoers.d/90-bromigos-iso-install"

if [[ -n $sshkey ]]; then
    if (( ! dry )); then
        home=$(awk -F: -v u="$user" '$1 == u { print $6 }' "$target/etc/passwd")
        install -d -m 700 "$target$home/.ssh"
        install -m 600 "$sshkey" "$target$home/.ssh/authorized_keys"
        in_target chown -R "$user:$user" "$home/.ssh"
    fi
    in_target systemctl enable sshd.service
fi
# the installers' SSH answers (archinstall enabled sshd): the keys chosen, key-only unless a
# password login was asked for; a server's firewall and automatic updates
if [[ -n $answers ]] && (( ! dry )); then
    keys=$(python3 -c 'import json, sys; print("\n".join(json.load(open(sys.argv[1])).get("ssh_keys") or []))' "$answers")
    if [[ -n $keys ]]; then
        home=$(awk -F: -v u="$user" '$1 == u { print $6 }' "$target/etc/passwd")
        install -d -m 700 "$target$home/.ssh"
        printf '%s\n' "$keys" >> "$target$home/.ssh/authorized_keys"
        chmod 600 "$target$home/.ssh/authorized_keys"
        in_target chown -R "$user:$user" "$home/.ssh"
    fi
    # bromigOS Server's own package, when it's there, applies its settings (its firewall, SSH
    # and updates: /etc/bromigos/server.toml, `bromigos-server setup`); else the installer's
    server_pkg=0; [[ -x $target/usr/bin/bromigos-server ]] && server_pkg=1
    if (( server_pkg )); then
        install -d "$target/etc/bromigos"
        {
            echo "# bromigOS Server's settings, from the installer (bromigos-server: docs/server.md)"
            echo "[ssh]"; echo "password = $([[ $(ans ssh_password) == 1 ]] && echo true || echo false)"
            echo "[updates]"; echo "auto = $([[ $(ans auto_updates) == 1 ]] && echo true || echo false)"
        } > "$target/etc/bromigos/server.toml"
        in_target bromigos-server setup || say "bromigos-server setup reported a problem (sudo bromigos-server setup runs it again)"
    fi
    if (( ! server_pkg )) && [[ $(ans ssh) == 1 && $(ans ssh_password) != 1 ]]; then
        install -d "$target/etc/ssh/sshd_config.d"
        printf '# bromigOS installer: keys only (docs/iso.md)\nPasswordAuthentication no\nKbdInteractiveAuthentication no\n' \
            > "$target/etc/ssh/sshd_config.d/01-bromigos-keys-only.conf"
    fi
    if (( ! server_pkg )) && [[ $(ans firewall) == 1 ]]; then
        ssh_rule=''; [[ $(ans ssh) == 1 ]] && ssh_rule='        tcp dport 22 accept comment "SSH"'
        cat > "$target/etc/nftables.conf" <<NFT
#!/usr/bin/nft -f
# bromigOS Server's firewall (the installer's; docs/iso.md): nothing comes in but replies to
# this computer's own connections, ping, and SSH when it's on. Edit and reload it with
# systemctl reload nftables.
flush ruleset
table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state invalid drop
        ct state { established, related } accept
        iif lo accept
        meta l4proto { icmp, ipv6-icmp } accept
$ssh_rule
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
    }
    chain output {
        type filter hook output priority filter; policy accept;
    }
}
NFT
        in_target systemctl enable nftables.service
    fi
    if (( ! server_pkg )) && [[ $(ans auto_updates) == 1 ]]; then
        enabled=0
        for u in $(python3 -c 'import json, sys; print(" ".join(json.load(open(sys.argv[1])).get("auto_update_units") or []))' "$answers"); do
            if [[ -e $target/usr/lib/systemd/system/$u ]]; then in_target systemctl enable "$u"; enabled=1; fi
        done
        (( enabled )) || say "automatic updates: no update timer in this system yet (the bromigos-server package brings it)"
    fi
fi
# Field Kit, the repair toolkit, in the boot menu: bromigos-boot's own step (its pacman hook
# ran while the packages went in; again now that GRUB is set up), copying Field Kit to /boot,
# which is 2 GiB for it, and adding its GRUB and firmware entries
if (( ! dry )) && [[ -x $target/usr/lib/bromigos/boot/bromigos-fieldkit-boot ]]; then
    in_target /usr/lib/bromigos/boot/bromigos-fieldkit-boot sync --menu \
        || say "Field Kit isn't in the boot menu yet (bromigos-fieldkit-boot status says why)"
fi

# Secure Boot (docs/secureboot.md): the new system starts with it on, through shim, with a key
# of its own (bromigos-secureboot setup: the key, GRUB built with its fonts inside and signed,
# the kernels and Field Kit signed, the firmware's "bromigOS" entry first, the installer's own
# GRUB entry gone, and the key's enrollment asked for at the first start). The code approves
# it there; the installers show it on their last page (::secureboot CODE). Never stops the
# install: without it, the system starts as before, with Secure Boot off.
if (( ! dry )) && [[ -d /sys/firmware/efi ]] && [[ -x $target/usr/lib/bromigos/secureboot/bromigos-secureboot ]]; then
    stage 94 "Setting up Secure Boot"
    sbcode=''; [[ -n $answers ]] && sbcode=$(ans secureboot_code)
    [[ $sbcode =~ ^[0-9]{4,8}$ ]] || sbcode=$(printf '%04d' $(( $(od -An -N2 -tu2 /dev/urandom) % 10000 )))
    if in_target /usr/lib/bromigos/secureboot/bromigos-secureboot setup --fresh-install --code "$sbcode"; then
        printf '::secureboot %s\n' "$sbcode"
    else
        say "Secure Boot isn't fully set up (bromigos secureboot, on the new system, says why; sudo bromigos secureboot setup tries again); until it is, start bromigOS with Secure Boot off"
    fi
fi

stage 96 "Finishing"
# the sync databases are the offline copy's, newer than the repositories' own: the first
# `pacman -Sy` would keep them (it asks "modified since?", the server says no) and check
# the server's signature against the wrong file. Dated 1970, they're all fetched afresh.
run touch -d @0 "$target"/var/lib/pacman/sync/*.db
# everything on the disk before anyone pulls the plug (the reboot unmounts; --no-reboot
# leaves /mnt mounted, for a look round)
run sync
say "== bromigOS is installed. Sign in at the Bromigos login screen after the reboot."
# the answers, without the password, kept for a repeat (an answer file: docs/iso.md)
if [[ -n $answers ]] && (( ! dry )); then
    install -d -m 0755 "$target/var/log/bromigos"
    python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("answers_toml") or "", end="")' "$answers" \
        > "$target/var/log/bromigos/install-answers.toml"
    chmod 0644 "$target/var/log/bromigos/install-answers.toml"
fi
[[ -z $answers ]] || rm -f "$answers" "$creds"
stage 100 "bromigOS is installed"
if (( reboot && ! dry )); then
    cleanup; trap - EXIT
    sleep 3
    systemctl reboot
fi
