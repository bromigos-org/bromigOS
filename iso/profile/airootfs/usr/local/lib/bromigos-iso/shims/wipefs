#!/bin/bash
# wipefs for archinstall (bromigos-iso-install puts this folder first on its PATH): it waits for
# the partitions it's given to be there before wiping them. Right after archinstall writes a
# partition table, the kernel re-reads it and udev takes /dev/vda1 away and back for a moment;
# a wipefs in that moment failed the whole install ("probing initialization failed: No such
# file or directory"). Here: udev settles, each device node is waited for (up to 20 s), and a
# probe that fails like that is tried again (3 times). Anything else is wipefs as it is.
real=/usr/bin/wipefs
log=/var/log/bromigos-iso-install.log
note() { echo "wipefs (bromigos): $*" >> "$log" 2>/dev/null || true; }
devs=()
for a in "$@"; do [[ $a == /dev/* ]] && devs+=("$a"); done
if ((${#devs[@]})); then
    udevadm settle --timeout=10 2>/dev/null || true
    for d in "${devs[@]}"; do
        waited=0
        until [[ -b $d ]] || (( waited >= 200 )); do sleep 0.1; waited=$((waited + 1)); done
        (( waited )) && note "waited $((waited * 100)) ms for $d"
    done
fi
for try in 1 2 3; do
    err=$("$real" "$@" 2>&1 >/dev/fd/3)
    rc=$?
    if (( rc != 0 )) && [[ $err == *"probing initialization failed"* ]] && (( try < 3 )); then
        note "try $try: $err; again after udev settles"
        udevadm settle --timeout=10 2>/dev/null || true
        sleep 1
        continue
    fi
    [[ -n $err ]] && printf '%s\n' "$err" >&2
    exit "$rc"
done 3>&1
