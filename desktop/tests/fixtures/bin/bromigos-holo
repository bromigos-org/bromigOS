#!/usr/bin/env python3
"""A stand-in bromigos-holo (tests, offscreen renders): never the real VECTOR. It keeps the
state files the real one keeps, in this HOME and runtime directory: the voice's mute
(~/.local/state/bromigos/vector-voice-muted), its pinned mode (vector-voice-mode), the
emergency switch's markers (~/.local/state/bromigos/vector-switch/off and
$XDG_RUNTIME_DIR/bromigos-vector-switch/off; `off`, `on`, `switch`, and their old names
`shell off|on`) and, while he "runs", $XDG_RUNTIME_DIR's bromigos-vector.json
(conversation, model). Every call is logged (fixture.py)."""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
import fixture as F  # noqa: E402

a = sys.argv[1:]
F.log("bromigos-holo", a)
STATE = os.path.join(os.path.expanduser("~"), ".local/state/bromigos")
RUN = os.environ.get("XDG_RUNTIME_DIR") or "/nonexistent"
LIVE = os.path.join(RUN, "bromigos-vector.json")
os.makedirs(STATE, exist_ok=True)
fx = F.load("bromigos-holo")


def live():
    try:
        with open(LIVE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def start():
    d = live()
    if d is None:
        d = {"state": "idle", "model": fx.get("model"), "muted": os.path.exists(os.path.join(STATE, "vector-voice-muted")),
             "voice_mode": "auto", "conversation": False}
        with open(LIVE, "w") as f:
            json.dump(d, f)
    return d


def save(d):
    with open(LIVE, "w") as f:
        json.dump(d, f)


verb = a[0] if a else "status"
arg = a[1] if len(a) > 1 else ""
if verb == "mute":
    f = os.path.join(STATE, "vector-voice-muted")
    if arg == "toggle":
        arg = "off" if os.path.exists(f) else "on"
    if arg == "on":
        open(f, "w").close()
    elif arg == "off" and os.path.exists(f):
        os.unlink(f)
    print("muted" if os.path.exists(f) else "unmuted")
elif verb == "voice":
    d = start()
    if arg not in ("auto", "main", "robot", "scientist", "floor", "notify"):
        print("error: voice must be auto or one of ['main', 'robot', 'scientist', 'floor', 'notify']")
        sys.exit(0)
    with open(os.path.join(STATE, "vector-voice-mode"), "w") as f:
        f.write(arg)
    d["voice_mode"] = arg
    save(d)
    print("voice " + arg)
elif verb == "conversation":
    d = start()
    d["conversation"] = not d.get("conversation")
    save(d)
    print("conversation " + ("on" if d["conversation"] else "off"))
elif verb in ("off", "on", "switch", "shell"):
    marks = [os.path.join(STATE, "vector-switch", "off"), os.path.join(RUN, "bromigos-vector-switch", "off")]
    want = verb if verb in ("off", "on") else arg
    if want == "off":
        for m in marks:
            os.makedirs(os.path.dirname(m), exist_ok=True)
            with open(m, "w") as f:
                json.dump({"by": "the operator (" + next((x[7:] for x in a if x.startswith("--from=")), "cli") + ")"}, f)
        print("VECTOR is off")
    elif want == "on":
        for m in marks + [os.path.join(STATE, "vector-shell-off")]:
            if os.path.lexists(m):
                os.unlink(m)
        print("VECTOR is on")
    else:
        print("off" if any(os.path.lexists(m) for m in marks) else "on")
elif verb == "status":
    d = live()
    print(json.dumps(d) if d is not None else "not running")
else:
    print("ok")
