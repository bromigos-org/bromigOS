#!/usr/bin/env python3
"""A stand-in pacman (tests, offscreen renders): -Q and -Qi from fixtures' pacman.json; nothing
else (it never installs)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
import fixture as F  # noqa: E402

a = sys.argv[1:]
F.log("pacman", a)
st = F.load("pacman")
inst = st["installed"]
if a[:1] == ["-Q"]:
    names = a[1:] or list(inst)
    bad = 0
    for n in names:
        if n in inst:
            print(n, inst[n])
        else:
            print(f"error: package '{n}' was not found", file=sys.stderr)
            bad = 1
    sys.exit(bad)
if a[:1] == ["-Qi"]:
    for n in a[1:]:
        if n in inst:
            print(f"Name            : {n}\nVersion         : {inst[n]}\nLicenses        : {st['licenses'].get(n, 'unknown')}\n")
    sys.exit(0)
print("pacman stand-in: only -Q and -Qi are pretended", file=sys.stderr)
sys.exit(1)
