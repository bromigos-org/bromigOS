#!/usr/bin/env python3
"""A stand-in pkexec (tests, offscreen renders): runs nothing as root; it records what it was
asked (fixtures' pkexec.log) and answers as a dismissed password prompt does (126)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
import fixture as F  # noqa: E402

F.log("pkexec", sys.argv[1:])
print("Error executing command as another user: Not authorized", file=sys.stderr)
sys.exit(126)
