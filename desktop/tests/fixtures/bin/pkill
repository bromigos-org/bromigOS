#!/usr/bin/env python3
"""A stand-in pkill (tests, offscreen renders): signals nothing; it records what it was asked
(fixtures' pkill.log) and says a process matched, as with a running waybar."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
import fixture as F  # noqa: E402

F.log("pkill", sys.argv[1:])
sys.exit(0)
