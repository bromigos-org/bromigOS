#!/usr/bin/env python3
"""A stand-in powerprofilesctl (tests, offscreen renders): power-profiles-daemon as
fixtures/powerprofilesctl.json says; `set` changes the active profile."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
import fixture as F  # noqa: E402

a = sys.argv[1:]
F.log("powerprofilesctl", a)
st = F.load("powerprofilesctl")
if not st.get("running", True):
    F.die("Failed to activate service 'net.hadess.PowerProfiles': timed out")
cmd = a[0] if a else "list"
if cmd == "get":
    print(st["active"])
elif cmd == "list":
    blocks = []
    for p in st["profiles"]:
        lines = [f"{'*' if p['name'] == st['active'] else ' '} {p['name']}:", f"    CpuDriver:\t{p['driver']}"]
        if p["name"] == "performance":
            lines.append(f"    Degraded:   {p['degraded']}")
        blocks.append("\n".join(lines))
    print("\n\n".join(blocks))
elif cmd == "set":
    if a[1] not in [p["name"] for p in st["profiles"]]:
        F.die(f"Profile '{a[1]}' not available")
    st["active"] = a[1]
else:
    F.die(f"powerprofilesctl stand-in: {cmd} isn't pretended")
F.save("powerprofilesctl", st)
