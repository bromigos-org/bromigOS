# The lab's creation jobs for this desktop (docs/activity.md, "Lab jobs"): `bromigos activity
# follow` keeps what the lab's ComfyUI makes, and the runs of tools that write a job feed, in
# $XDG_RUNTIME_DIR/bromigos-labjobs, with the pictures in ~/.cache/bromigos/labjobs: for the start
# page's LAB JOBS card and `bromigos activity watch`. The start page's snapshot starts it when a
# ComfyUI is set. It looks every 2 seconds while something runs or waits, and every 30 otherwise.
[Unit]
Description=bromigOS: follow the lab's creation jobs
Documentation=file:///usr/share/doc/bromigos/desktop.md
After=bromigos-private.service

[Service]
Type=simple
ExecStart=/usr/lib/bromigos/bin/bromigos-activity follow
Nice=10
IOSchedulingClass=idle
Restart=on-failure
RestartSec=30
# It reads what other machines send (ComfyUI's answers, its pictures), so it runs boxed in: it
# writes only its two folders, reads the home folder, gains no privilege, and is bounded
RuntimeDirectory=bromigos-labjobs
RuntimeDirectoryPreserve=yes
CacheDirectory=bromigos/labjobs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryMax=512M
TasksMax=32
