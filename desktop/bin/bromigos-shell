#!/usr/bin/env python3
# bromigos:summary=Choose, configure, preview and diagnose the shell prompt
# bromigos:args=[status] | prompt mehshell|starship|none [--json] | doctor [--json] [--timings] | preview [--width N] [--style STYLE] | configure KEY VALUE
# bromigos:examples=bromigos shell prompt mehshell; bromigos shell doctor; bromigos shell preview --width 40; bromigos shell configure brand bromigos
"""Choose the zsh prompt and configure mehshell.
bromigos shell status | prompt mehshell|starship|none [--json]
bromigos shell doctor [--json] [--timings]
bromigos shell preview [--width N] [--style lean|classic|rainbow] [--plain]
bromigos shell configure KEY VALUE
Open a new shell after changing the prompt engine or shell-hook settings.
"""
import os
from pathlib import Path
import sys
import shutil
import subprocess
import tomllib
sys.path.insert(0, "/usr/lib/bromigos/lib")
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "lib"))
import bromigos_cli as C
from bromigos_prompt import atomic_write, update

FILE = Path(C.CONFIG) / "bromigos/shell.toml"
CHOICES = ("mehshell", "starship", "none")


def status(args=None):
    data = tomllib.loads(FILE.read_text()) if FILE.exists() else {}
    choice = data.get("prompt", "none")
    if choice not in CHOICES:
        raise C.Fail(f"Invalid prompt in {FILE}")
    return {"prompt": choice, "managed": FILE.exists(), "file": str(FILE)}


def prompt(args):
    if len(args) != 1 or args[0] not in CHOICES:
        raise C.Fail("bromigos shell prompt mehshell|starship|none")
    choice = args[0]
    if choice != "none":
        C.need(choice, choice)
    # This file owns only the shell choice. Never edit a user's startup files here.
    if choice == "mehshell":
        update()
    atomic_write(FILE, f'# bromigOS zsh prompt\nprompt = "{choice}"\n')
    return dict(status(), said=f"Prompt: {choice}. Open a new zsh shell.")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("doctor", "preview", "configure"):
        tool = shutil.which("mehshell")
        if not tool:
            print("Install mehshell to configure or inspect its prompt.", file=sys.stderr)
            sys.exit(1)
        route = {"doctor": ["doctor"], "preview": ["preview"], "configure": ["config", "set"]}[sys.argv[1]]
        # Let mehshell own validation and output. Preview text is never evaluated.
        try:
            sys.exit(subprocess.call([tool, *route, *sys.argv[2:]]))
        except OSError:
            print("Could not run mehshell.", file=sys.stderr)
            sys.exit(1)
    sys.exit(C.main({"status": status, "prompt": prompt}, __doc__))
