#!/usr/bin/env python3
# bromigos:summary=Proton versions for Steam: list them, install the latest GE-Proton (checksum verified), remove one
# bromigos:args=[list] | install [VERSION] | remove VERSION [--force]  [--json]
# bromigos:examples=bromigos game proton; bromigos game proton install; bromigos game proton remove GE-Proton10-25
"""bromigos-game-proton (`bromigos game proton`): the Proton versions Steam can run games with.

  bromigos game proton [list]           every Proton here: Steam's own, and GE-Proton
                                        versions in ~/.local/share/Steam/compatibilitytools.d,
                                        with the runtime each needs and the games set to it
  bromigos game proton install [VERSION]
                                        download GE-Proton (the latest, or VERSION such as
                                        GE-Proton10-25) from its GitHub releases, check it
                                        against the published SHA-512 checksum, and unpack it
                                        into compatibilitytools.d. Restart Steam to see it
  bromigos game proton remove VERSION [--force]
                                        delete a GE-Proton version. Steam must be closed.
                                        --force removes one that games are still set to

Pick a Proton for a game in Steam: the game's Properties › Compatibility. The manual's
Playing games page explains which to use.
"""
import os
import shutil
import sys

sys.path.insert(0, "/usr/lib/bromigos/lib")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import bromigos_cli as C  # noqa: E402
import bromigos_steam as S  # noqa: E402
from bromigos_cli import Fail  # noqa: E402

USAGE = __doc__.split("\n\n", 1)[1]
JSON = "--json" in sys.argv


def say(msg):
    """Progress on stderr: stdout is the document's."""
    if not JSON:
        print(msg, file=sys.stderr, flush=True)


def root_or_fail():
    root = S.steam_root()
    if root is None:
        raise Fail("Steam hasn't run here yet: install it with `bromigos game setup`, start it once, "
                   "then try again")
    return root


def status(args):
    root = root_or_fail()
    installed = S.apps(root)
    _, _, block = S.compat_mapping(root)
    mapping = S.mapping_entries(block)
    default = mapping.get("0", {}).get("name") or None
    tools = []
    for t in S.custom_tools(root) + S.steam_tools(root, installed):
        d = t.doc()
        req = t.requires
        if req:
            app = installed.get(req)
            d["runtime"] = {"appid": req, "name": (app and app.name) or S.RUNTIMES.get(req, f"app {req}"),
                            "installed": bool(app and app.installed)}
        d["games"] = sorted((k for k, v in mapping.items() if k != "0" and v["name"] == t.name), key=int)
        d["default"] = t.name == default
        tools.append(d)
    lines = []
    for d in tools:
        rt = d.get("runtime")
        extra = []
        if d["default"]:
            extra.append("the default for every game")
        if d["games"]:
            extra.append(f"{len(d['games'])} game{'s' if len(d['games']) != 1 else ''} set to it")
        if rt and not rt["installed"]:
            extra.append(f"needs {rt['name']}, not installed yet")
        where = {"user": "yours", "system": "a package's", "steam": "Steam's"}[d["kind"]]
        lines.append(f"{d['display_name']:<28} {where}" + (f"  ({'; '.join(extra)})" if extra else ""))
    if not lines:
        lines = ["No Proton yet. `bromigos game proton install` gets the latest GE-Proton; Steam "
                 "downloads its own Proton the first time a Windows game needs it."]
    return {"steam_root": root, "default": default, "tools": tools, "said": "\n".join(lines)}


def install(args):
    tag = args[0] if args else None
    root = root_or_fail()
    try:
        got = S.install_ge(root, tag, say)
    except S.InstallError as e:
        raise Fail(str(e))
    name, final = got["tag"], got["path"]
    if got["already"]:
        return dict(status([]), installed=name, said=f"{name} is installed already ({final})")
    shown = next((t.display for t in S.custom_tools(root) if t.path == final), got["top"])
    said = f"Installed {name} in {final}, checked against its published SHA-512 checksum."
    said += (" Restart Steam to see it." if S.steam_running() else "") + \
        f" Pick it for a game in Steam: Properties › Compatibility › {shown}."
    return dict(status([]), installed=name, said=said)


def remove(args):
    force = C.flag(args, "--force", takes=False, default=False)
    if not args:
        raise Fail("which version? `bromigos game proton` lists them")
    name = args[0]
    root = root_or_fail()
    if S.steam_running():
        raise Fail("Steam is running: close it first (Steam › Exit), then try again")
    tool = next((t for t in S.custom_tools(root) if t.kind == "user" and
                 name in (t.name, os.path.basename(t.path), t.name.removesuffix("-" + S.machine()))), None)
    if tool is None:
        raise Fail(f"{name} isn't one of your Proton versions in {S.compat_dir(root)} "
                   "(`bromigos game proton` lists them; Steam removes its own Proton itself)")
    base = os.path.realpath(S.compat_dir(root))
    folder = os.path.realpath(tool.path)
    if os.path.dirname(folder) != base:
        raise Fail(f"{tool.path} isn't directly in {base}: remove it yourself")
    _, _, block = S.compat_mapping(root)
    games = sorted(k for k, v in S.mapping_entries(block).items() if v["name"] == tool.name)
    if games and not force:
        who = "every game (the default)" if "0" in games else f"{len(games)} game(s): app {', '.join(games)}"
        raise Fail(f"{tool.name} is set for {who}. Choose another Proton for them in Steam first, "
                   "or pass --force (Steam then uses its default for them)")
    shutil.rmtree(folder)
    return dict(status([]), removed=tool.name, said=f"Removed {tool.name}.")


if __name__ == "__main__":
    sys.exit(C.main({"list": status, "status": status, "install": install, "remove": remove}, USAGE,
                    default="list"))
