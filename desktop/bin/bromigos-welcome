#!/usr/bin/env python3
# bromigos:summary=The welcome tour after an install: Wi-Fi, your screens, a world, VECTOR and his voice, your homelab, the keys; every step skippable
# bromigos:args=[--if-pending] [--step STEP] [--render DIR]
# bromigos:examples=bromigos welcome; bromigos welcome --step world
"""bromigos-welcome: the first login's walkthrough (docs/first-run.md), a full-screen window in
the Settings window's style (DRIFTGLASS: GLOW steps, the emblem as the one FLARE, no motion
when motion is reduced). Each step is one section of `bromigos setup`, run with its flags,
so there is no second config path:

  Wi-Fi (only when offline)   nmcli
  Your screens                bromigos setup monitors --monitors auto --primary OUTPUT
  A world                     bromigos setup theme --theme NAME (the theme switcher's cards)
  VECTOR                      your lab, this computer (the lab catalog's model, through Ollama), a service,
                              or not now: bromigos setup vector …; his voice: bromigos setup voice …;
                              then he says hello
  Your lab                    find it (bromigos setup homelab --find, in the background), a connection
                              file (--homelab FILE), or bromigos-lab's plan for making this computer it
  Ask VECTOR                  once his brain answers: a box on every step for a question about it, his
                              answer shown (and spoken, with the voice guide on and his voice running)
  Pair your phone             BRODEC's machine helper (brodec-desktop, installed with consent): its QR
                              and code, ticked when the phone confirms
  The keys                    a short tour: each key's card lights when you press it
  Done

  bromigos welcome                 open it (again: Settings › About › Welcome tour opens it too)
  bromigos welcome --if-pending    the session's autostart: only when the installer left
                                   ~/.local/state/bromigos/welcome-pending (a new install)
  bromigos welcome --step STEP     open it on one step (network, screens, world, vector, lab, phone, keys)
  bromigos welcome --render DIR    each step drawn to DIR/welcome-STEP.png and exit (a Wayland display
                                   is needed: tests use a headless one)

It starts the way the installer's first step left it (docs/voice-guide.md): VECTOR's voice guide
(voice-guide.json; Ctrl+Alt+V turns it on, then mutes it) reads each step's line, and
accessibility.json's larger text, high contrast and reduced motion apply here, and once, the
first time, to the session's own settings (and Orca, for the screen reader).
"""
import json
import os
import shutil
import subprocess
import sys
import threading

HERE = os.path.dirname(os.path.realpath(__file__))
for p in ("/usr/lib/bromigos/lib", "/usr/lib/bromigos/settings", os.path.join(HERE, "../lib"),
          os.path.join(HERE, "../../lib"), os.path.join(HERE, "../settings")):
    if os.path.isdir(p) and p not in sys.path:
        sys.path.append(p)

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "bromigos")
PENDING = os.path.join(STATE, "welcome-pending")
DONE = os.path.join(STATE, "welcome.json")

STEPS = [
    ("network", "Wi-Fi", "Connect to the internet",
     "Updates, VECTOR's online brains and the voice download need it. Pick a network, or skip: you can connect "
     "from the bar any time."),
    ("screens", "Screens", "Your screens",
     "Which screen is the main one: the live background and the panels go there. Arrange them and set their "
     "sizes in Settings › Displays."),
    ("world", "World", "Choose a world",
     "The whole desktop's look. The Wick is the phosphor console; the worlds are living scenes that read your "
     "machine. Change it any time in Settings › Theme."),
    ("vector", "VECTOR", "VECTOR, your desk's AI",
     "Where his brain runs, and whether he speaks. Nothing leaves this computer unless you choose a service."),
    ("lab", "Your lab", "Your lab",
     "Optional. If you run servers at home, this computer can use them: the panels show them, and VECTOR can "
     "think on their graphics cards. Everything happens here; nothing opens elsewhere."),
    ("phone", "Phone", "Pair your phone",
     "With BRODEC on your phone you can talk to VECTOR from anywhere, approve his fixes, and restart, shut down "
     "or update this computer."),
    ("keys", "Keys", "The keys worth knowing",
     "Try each one now: its card lights up when it works. Super is the key with the Windows logo."),
    ("done", "Done", "You're all set",
     "Everything here can be changed again in Settings, and this tour opens from Settings › About."),
]
STEP = {s[0]: s for s in STEPS}

# VECTOR's one line per step, in the rail's corner: the voice guide's catalogue (tour.STEP in
# lib/guide/lines.toml), so the caption and his clip say the same words

KEY_TOUR = [   # (keys, what it does, how we see it worked: a window class appearing, or None)
    ("Super + Space", "The app launcher: type to find any app", "Rofi"),
    ("Super + Enter", "A terminal", "kitty"),
    ("Super + ,", "Settings", "org.bromigos.Settings"),
    ("Super + K", "Every shortcut, searchable", None),
    ("Super + W", "Show or hide the desktop's panels", None),
    ("Super + Q", "Close the window in front", None),
]
KEY_ICONS = {"Super + Space": "system-search-symbolic", "Super + Enter": "utilities-terminal-symbolic",
             "Super + ,": "preferences-system-symbolic", "Super + K": "input-keyboard-symbolic",
             "Super + W": "view-reveal-symbolic", "Super + Q": "window-close-symbolic"}

# the renders' sample data (--render): no real network, screen or choice is read
SAMPLE_WIFI = [{"ssid": "Rivera Home", "signal": 86, "secure": True, "connected": True},
               {"ssid": "Rivera Home 5G", "signal": 71, "secure": True, "connected": False},
               {"ssid": "Corner Cafe Guest", "signal": 44, "secure": False, "connected": False},
               {"ssid": "Upstairs", "signal": 22, "secure": True, "connected": False}]
SAMPLE_BRAIN = {"url": "http://192.0.2.24:4000/v1", "model": "sample", "key": "none"}
SAMPLE_ASK = ("What does my lab give me?", "Your lab's graphics card runs my brain and the models, so this computer stays "
              "cool and quiet. The panels show its machines, and you can send it jobs from here.")
SAMPLE_CHOSE = {"network": "Connected to Rivera Home", "screens": "Main screen: DP-1", "world": "World: mire",
                "vector": "Brain: your lab (connected on the next step), voice: Kokoro", "lab": "Your lab is connected",
                "phone": "Your phone is paired"}


def run(argv, timeout=60):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)


def setup(*args):
    """One `bromigos setup` section with its flags (the only way the tour changes anything)."""
    return run(["bromigos", "setup", *args], timeout=600)


def online():
    code, out, _ = run(["nmcli", "-t", "networking", "connectivity"], timeout=5)
    return code == 0 and out.strip() == "full"


def wifi_list():
    code, out, _ = run(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "auto"], timeout=20)
    nets, seen = [], set()
    for line in out.splitlines():
        parts = line.replace("\\:", "\0").split(":")
        if len(parts) < 4:
            continue
        inuse, ssid, signal, sec = (p.replace("\0", ":") for p in parts[:4])
        if not ssid or ssid in seen:
            continue
        seen.add(ssid)
        nets.append({"ssid": ssid, "signal": int(signal or 0), "secure": bool(sec and sec != "--"), "connected": inuse == "*"})
    return sorted(nets, key=lambda n: -n["signal"])


def monitors():
    # started outside the session (a terminal over SSH, a test): Hyprland's instance from its
    # runtime folder, so hyprctl still finds it
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        base = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "hypr")
        try:
            newest = max((os.path.join(base, d) for d in os.listdir(base)), key=os.path.getmtime)
            os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(newest)
        except (OSError, ValueError):
            pass
    code, out, _ = run(["hyprctl", "monitors", "-j"], timeout=5)
    try:
        return [{"name": m["name"], "desc": " ".join(x for x in (m.get("make"), m.get("model")) if x) or m["name"],
                 "size": f"{m['width']}×{m['height']}", "focused": m.get("focused", False)} for m in json.loads(out)]
    except (ValueError, KeyError, TypeError):
        return []


def voice_sizes():
    """What each voice downloads, when VECTOR's setup can say (bromigos-holo setup --sizes --json)."""
    code, out, _ = run(["bromigos-holo", "setup", "--sizes", "--json"], timeout=15)
    try:
        d = json.loads(out)
        return {k: v for k, v in d.items() if isinstance(v, str)}
    except ValueError:
        return {}


def has_gpu():
    code, out, _ = run(["bromigos", "hw", "detect", "--json"], timeout=30)
    try:
        return any(g.get("vendor") in ("NVIDIA", "AMD") for g in json.loads(out).get("detection", {}).get("gpus", []))
    except ValueError:
        return False


def main(argv):
    if "--if-pending" in argv and not os.path.exists(PENDING):
        return 0
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    if not os.environ.get("WAYLAND_DISPLAY") and "--render" not in argv:
        # no desktop here (a server, a console, SSH): the tour in the terminal, bromigos-core's
        console = "/usr/lib/bromigos/bin/bromigos-welcome-console"
        if os.access(console, os.X_OK):
            os.execv(console, [console, *argv])
        print("The welcome tour needs the desktop. Run it from a terminal on the desktop.")
        return 1
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, GLib, Gtk, Pango
    import bromigos_firstrun as F          # this command's own lib first: the settings' import below
    import bromigos_glass as glass
    try:                                   # VECTOR's lines and voice, the installer's choices (bromigos-core's)
        import bromigos_guide as guide
    except ImportError:
        guide = None
    render_dir = argv[argv.index("--render") + 1] if "--render" in argv else None
    # how the installer's first step left it (accessibility.json); pictures use the defaults
    acc = guide.access() if guide and not render_dir else {}
    try:                                   # may put the installed one ahead of it
        from bromigos_settings import style
    except ImportError:
        style = None

    def hint(w, text):
        if text:
            w.set_tooltip_text(text)
            try:
                w.update_property([Gtk.AccessibleProperty.DESCRIPTION], [text])
            except Exception:
                pass
        return w

    def lab(text, *classes, wrap=True):
        l_ = Gtk.Label(label=text, wrap=wrap, xalign=0)
        for c in classes:
            l_.add_css_class(c)
        return l_

    def reduced():
        if os.environ.get("BROMIGOS_REDUCED_MOTION") or acc.get("reduce_motion"):
            return True
        try:
            import bromigos_theme as T
            return T.motion() != "full"
        except Exception:
            return False

    class Win(Adw.ApplicationWindow):
        def __init__(self, app, start, render):
            super().__init__(application=app, title="Welcome to bromigOS")
            self.connect("close-request", lambda *_: (self.stop_pairing(), False)[1])
            self.set_default_size(1280, 800)
            self.render = render
            self.connect("close-request", lambda *_: (self.voice and self.voice.stop(), False)[1])
            # VECTOR's voice: quiet in pictures; its on and muted are voice-guide.json's
            self.voice = guide.Guide("gui", notify=lambda w: GLib.idle_add(lambda: (self.msg.set_label("▲ " + w), False)[1])) \
                if guide and not render else None
            if guide and render:                 # pictures: a player that never makes a sound, its settings nobody's
                self.voice = guide.Guide("gui", state=os.devnull, root="/nonexistent")
                self.voice._out = ("pw-play", None)
                self.voice.play = self.voice.say = lambda *a, **k: False
            self.spoken = None
            # his brain: looked for in the background; until it answers, he's scripted and the
            # Ask VECTOR box stays hidden. Pictures: a sample one, unless BROMIGOS_VECTOR_BRAIN says otherwise
            forced = os.environ.get("BROMIGOS_VECTOR_BRAIN")
            self.brain = (SAMPLE_BRAIN if render and not forced else None)
            self.greeted = bool(render)
            self.asks = {}
            self.steps = [s[0] for s in STEPS if s[0] != "network" or render or not online()]
            self.step = start if start in self.steps else self.steps[0]
            self.done_steps = {}
            css = Gtk.CssProvider()
            c = dict(style.WICK) if style else {}
            if style:
                c, _, _ = style.colors()
            css.load_from_string((style.css(c) if style else "") + f"""
.bw-rail {{ background-color: {c.get('panel', '#001300')}; padding: 18px 0; min-width: 200px; }}
.bw-step {{ padding: 7px 22px; letter-spacing: 0.08em; color: {c.get('faint', '#4e6b4e')}; }}
.bw-step.done {{ color: {c.get('soft', '#9cff8a')}; }}
.bw-step.now {{ color: {c.get('primary', '#39ff14')}; font-weight: 700; box-shadow: inset 3px 0 {c.get('primary', '#39ff14')}; }}
.bw-heading {{ font-size: 1.9em; font-weight: 700; letter-spacing: 0.14em; color: {c.get('primary', '#39ff14')}; }}
.bw-intro {{ color: {c.get('muted', '#7e927e')}; font-size: 1.05em; }}
.bw-key {{ font-size: 1.2em; font-weight: 700; letter-spacing: 0.08em; color: {c.get('soft', '#9cff8a')}; }}
.bw-keycard {{ border: 1px solid {c.get('dim', '#159b09')}; padding: 14px 18px; }}
.bw-keycard.lit {{ border-color: {c.get('primary', '#39ff14')}; box-shadow: 0 0 10px {c.get('primary', '#39ff14')}; }}
.bw-bar {{ padding: 12px 24px; border-top: 1px solid {c.get('dim', '#159b09')}; }}
.bw-group-title {{ font-weight: 700; letter-spacing: 0.12em; font-size: 0.9em; color: {c.get('primary', '#39ff14')}; margin-top: 6px; }}
.bw-card {{ border: 1px solid {c.get('dim', '#159b09')}; background-color: {c.get('panel', '#001300')}; padding: 16px 18px; }}
.bw-qr-slot picture {{ background-color: #ffffff; }}
.bw-code {{ font-size: 1.9em; font-weight: 700; letter-spacing: 0.18em; color: {c.get('primary', '#39ff14')}; }}
.bw-status {{ font-size: 1.05em; color: {c.get('soft', '#9cff8a')}; }}
.bw-tick {{ font-size: 5em; color: {c.get('primary', '#39ff14')}; }}
""" + glass.css(c, bool(acc.get("high_contrast"))))
            self.c = glass.palette(c)
            if acc.get("large_text"):            # unless the session's text is already bigger (applied below)
                st = Gtk.Settings.get_default()
                dpi = st.get_property("gtk-xft-dpi")
                if 0 < dpi < int(96 * 1024 * 1.2):
                    st.set_property("gtk-xft-dpi", int(dpi * 1.25))
            glass.use_icon_theme()
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            root = Gtk.Box()
            self.rail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.rail.add_css_class("bw-rail")
            root.append(self.rail)
            right = Adw.ToolbarView(hexpand=True)
            hb = Adw.HeaderBar(show_end_title_buttons=False, show_start_title_buttons=False)
            hb.set_title_widget(hint(lab("BROMIGOS // WELCOME", "title", wrap=False), "The welcome tour: every step can be skipped"))
            right.add_top_bar(hb)
            self.scroll = Gtk.ScrolledWindow(vexpand=True)
            self.clamp = Adw.Clamp(maximum_size=920)
            self.scroll.set_child(self.clamp)
            right.set_content(self.scroll)
            bar = Gtk.Box(spacing=12)
            bar.add_css_class("bw-bar")
            self.msg = lab("")
            self.msg.set_hexpand(True)
            self.back = hint(Gtk.Button(label="Back"), "The step before")
            self.skip = hint(Gtk.Button(label="Skip"), "Leave this as it is and go on: nothing changes")
            self.next = hint(Gtk.Button(label="Continue"), "Use what's chosen here and go on")
            self.next.add_css_class("suggested-action")
            self.back.connect("clicked", lambda *_: self.go(-1))
            self.skip.connect("clicked", lambda *_: self.go(1))
            self.next.connect("clicked", lambda *_: self.apply_and_go())
            # VECTOR's voice, one key away: what it's doing now, and a click to change it
            self.voice_btn = Gtk.Button(valign=Gtk.Align.CENTER)
            self.voice_btn.add_css_class("flat")
            self.voice_btn.connect("clicked", lambda *_: self.toggle_voice())
            self.voice_btn.set_visible(bool(guide))
            for b in (self.voice_btn, self.msg, self.back, self.skip, self.next):
                bar.append(b)
            if guide:
                sc = Gtk.ShortcutController(scope=Gtk.ShortcutScope.GLOBAL)
                sc.add_shortcut(Gtk.Shortcut.new(Gtk.ShortcutTrigger.parse_string(guide.GTK_ACCEL),
                                                 Gtk.CallbackAction.new(lambda *_: (self.toggle_voice(), True)[1])))
                self.add_controller(sc)
            right.add_bottom_bar(bar)
            root.append(right)
            self.set_content(root)
            self.show_step(self.step)
            if not render:
                threading.Thread(target=self.find_brain, daemon=True).start()
                if acc and not acc.get("applied"):
                    threading.Thread(target=self.apply_access, daemon=True).start()
            elif forced:
                threading.Thread(target=self.find_brain, daemon=True).start()

        # ── VECTOR: his voice, his brain, the installer's choices ──────────────────
        def apply_access(self):
            """Once, the first time: the session's own settings as the installer's first step
            chose (bromigOS's own motion and contrast were set while it installed)."""
            sets = []
            if acc.get("large_text"):
                sets.append(("org.gnome.desktop.interface", "text-scaling-factor", "1.25"))
            if acc.get("high_contrast"):
                sets.append(("org.gnome.desktop.a11y.interface", "high-contrast", "true"))
            if acc.get("reduce_motion"):
                sets.append(("org.gnome.desktop.interface", "enable-animations", "false"))
            if acc.get("screen_reader"):
                sets.append(("org.gnome.desktop.a11y.applications", "screen-reader-enabled", "true"))
            for schema, key, value in sets:
                run(["gsettings", "set", schema, key, value], timeout=10)
            if acc.get("screen_reader") and shutil.which("orca") and run(["pgrep", "-x", "orca"], timeout=5)[0] != 0:
                try:
                    subprocess.Popen(["orca"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                except OSError:
                    pass
            guide.save_access({"applied": True})

        def find_brain(self):
            b = F.brain()
            GLib.idle_add(self._brain_found, b)

        def _brain_found(self, b):
            was = self.brain
            self.brain = b
            for box in self.asks.values():
                box.set_visible(bool(b))
            if b and not was and not self.greeted and guide:      # he's arrived: he says hello, aloud with the guide on
                self.greeted = True
                if self.voice and self.voice.status() == "on":
                    self.spoken = ("tour.hello",)
                    self.voice.say(guide.line("tour.hello"), fallback="tour.hello")
                self.guide.line.set_label(guide.line("tour.hello"))
            return False

        def toggle_voice(self):
            if not self.voice:
                return
            self.voice.toggle()
            self.spoken = None
            if self.voice.status() == "on":
                self.speak()
            self.voice_shown()

        def voice_shown(self):
            if not self.voice:
                self.voice_btn.set_visible(False)
                return
            st = self.voice.status()
            word = {"on": "Voice on", "muted": "Voice muted", "off": "Voice off", "screen-reader": "Voice quiet",
                    "no-sound": "No sound"}[st]
            box = Gtk.Box(spacing=6)
            box.append(Gtk.Image.new_from_icon_name("audio-volume-high-symbolic" if st == "on" else "audio-volume-muted-symbolic"))
            box.append(Gtk.Label(label=f"{word} · {guide.HOTKEY}"))
            self.voice_btn.set_child(box)
            hint(self.voice_btn, self.voice.describe() + " Click, or press " + guide.HOTKEY + ", to change it.")

        def speak(self):
            """The step's line, once: going back, or drawing the step again, doesn't repeat it."""
            if self.voice and self.spoken != self.step:
                self.spoken = self.step
                self.voice.play(f"tour.{self.step}")

        def ask_box(self, sid):
            """Ask VECTOR: a question about this step, his answer under it. Hidden until his brain answers."""
            g = Adw.PreferencesGroup(title="ASK VECTOR")
            g.set_description("A question about this step: he answers here.")
            row = Adw.EntryRow(title="Your question")
            row.set_show_apply_button(True)
            hint(row, "Type a question about this step and press Enter: VECTOR answers below")
            row.add_prefix(glass.icon("dialog-question-symbolic", 18, "dg-row-icon"))
            g.add(row)
            ans = lab("", "bw-intro")
            ans.set_selectable(True)
            ans.set_margin_top(8)
            ans.update_property([Gtk.AccessibleProperty.LABEL], ["VECTOR's answer"])
            g.add(ans)
            row.connect("entry-activated", lambda r: self.ask(sid, r, ans))
            row.connect("apply", lambda r: self.ask(sid, r, ans))
            g.set_visible(bool(self.brain))
            g.answer, g.entry = ans, row
            self.asks = {sid: g}
            return g

        def ask(self, sid, row, ans):
            q = row.get_text().strip()
            if not q:
                ans.set_label("Type a question first, then press Enter.")
                return
            ans.set_label("VECTOR is thinking…")
            row.set_sensitive(False)
            _, _, head, intro = STEP[sid]
            ctx = f"{head}. {intro}"

            def work():
                ok, words = F.ask(q, ctx, self.brain)
                return (self._answered, sid, row, ans, ok, words)
            self.later(work)

        def _answered(self, sid, row, ans, ok, words):
            row.set_sensitive(True)
            ans.set_label(("VECTOR: " + words) if ok else "▲ " + words)
            if ok and self.voice and self.step == sid:
                self.voice.say(words)           # aloud only through his running voice: no clip says this
            return False

        def show_step(self, sid):
            if hasattr(self, "stop_pairing"):
                self.stop_pairing()          # the phone step's watching ends with it
            self.step = sid
            here = self.steps.index(sid)
            self.guide = glass.guide(guide.line(f"tour.{sid}") if guide else "", "speaking", still=bool(self.render) or reduced(),
                                     size=(100, 150) if self.screen_h() < 760 else (120, 178))
            glass.rail(self.rail, self.steps, here, STEP, self.c, self.guide, title="WELCOME")
            tight = self.screen_h() < 760     # 1024×600 and the like: less air, the same content
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10 if tight else 14, margin_top=14 if tight else 28,
                           margin_bottom=14 if tight else 28, margin_start=24, margin_end=24)
            _, _, head, intro = STEP[sid]
            page.append(lab(head.upper(), "bw-heading"))
            page.append(lab(intro, "bw-intro"))
            getattr(self, f"build_{sid}")(page)
            page.append(self.ask_box(sid))
            if self.render and self.brain and sid == "lab":      # the pictures: a question asked, as it looks
                self.asks[sid].entry.set_text(SAMPLE_ASK[0])
                self.asks[sid].answer.set_label("VECTOR: " + SAMPLE_ASK[1])
            self.clamp.set_child(page)
            self.msg.set_label("")
            self.back.set_visible(here > 0)
            self.skip.set_visible(sid != "done")
            self.next.set_label("Finish" if sid == "done" else "Continue")
            self.speak()
            self.voice_shown()

        def still(self):
            """No motion: the renders, and reduced motion."""
            return bool(self.render) or reduced()

        def group(self, page, title, desc=None):
            g = Adw.PreferencesGroup(title=GLib.markup_escape_text(title.upper()))
            if desc:
                g.set_description(GLib.markup_escape_text(desc))
            page.append(g)
            return g

        def later(self, fn, *a):
            threading.Thread(target=lambda: GLib.idle_add(*fn(*a)), daemon=True).start()

        # ── the steps ──────────────────────────────────────────────────────────────
        def build_network(self, page):
            head = Gtk.Box(spacing=14)
            self.wifi_sweep = glass.MiniSweep(self.c, 46, still=self.still())
            hint(self.wifi_sweep, "The Sweep: it turns while it looks for networks")
            head.append(self.wifi_sweep)
            self.wifi_state = lab("Looking for networks…", "bw-status", wrap=False)
            self.wifi_state.set_valign(Gtk.Align.CENTER)
            head.append(self.wifi_state)
            page.append(head)
            g = self.group(page, "Wi-Fi networks")
            self.wifi_group = g
            self.wifi_pw = Adw.PasswordEntryRow(title="Password for the network chosen")
            self.wifi_pw.add_prefix(glass.icon("dialog-password-symbolic", 18, "dg-row-icon"))
            hint(self.wifi_pw, "The Wi-Fi password, if the network has one")
            self.wifi_choice = None
            spinner = Adw.ActionRow(title="Looking for networks…")
            g.add(spinner)

            def found():
                nets = SAMPLE_WIFI if self.render else wifi_list()
                return (self._wifi_rows, nets, spinner)
            self.later(found)
            self.wifi_pw_group = self.group(page, "Its password")
            self.wifi_pw_group.add(self.wifi_pw)


        def _wifi_rows(self, nets, spinner):
            self.wifi_group.remove(spinner)
            self.wifi_sweep.stop()
            self.wifi_state.set_label(f"{len(nets)} network{'s' if len(nets) != 1 else ''} in range" if nets
                                      else "No Wi-Fi networks in range")
            first = None
            if not nets:
                r = Adw.ActionRow(title="No Wi-Fi networks found", subtitle="Plug in a network cable, or skip this step.")
                r.add_prefix(glass.icon("network-offline-symbolic", 20, "dg-row-icon"))
                hint(r, "No wireless networks are in range, or this computer has no Wi-Fi")
                self.wifi_group.add(r)
                self.wifi_pw_group.set_visible(False)
            secure = {}
            for n in nets[:12]:
                r = Adw.ActionRow(title=GLib.markup_escape_text(n["ssid"]),
                                  subtitle=f"Signal {n['signal']} %" + (" · needs a password" if n["secure"] else " · open"))
                chk = Gtk.CheckButton(valign=Gtk.Align.CENTER, active=n["connected"])
                if first:
                    chk.set_group(first)
                first = first or chk
                secure[n["ssid"]] = n["secure"]

                def chose(b, s=n["ssid"]):
                    if b.get_active():
                        self.wifi_choice = s
                        self.wifi_pw_group.set_visible(secure.get(s, True))
                chk.connect("toggled", chose)
                if n["connected"]:
                    self.wifi_choice = n["ssid"]
                r.add_prefix(chk)
                r.add_prefix(glass.SignalBars(self.c, n["signal"]))
                if n["connected"]:
                    chip = Gtk.Label(label="● CONNECTED", valign=Gtk.Align.CENTER)
                    chip.add_css_class("dg-chip")
                    hint(chip, "This computer is on this network now")
                    r.add_suffix(chip)
                if n["secure"]:
                    lock = glass.icon("network-wireless-encrypted-symbolic", 16, "dg-row-icon")
                    hint(lock, "Needs a password")
                    r.add_suffix(lock)
                r.set_activatable_widget(chk)
                hint(r, f"Join {n['ssid']}")
                self.wifi_group.add(r)
            return False


        def build_screens(self, page):
            mons = [] if self.render else monitors()
            if self.render:
                mons = [{"name": "DP-1", "desc": "Dell U2723QE", "size": "3840×2160", "focused": True},
                        {"name": "HDMI-A-1", "desc": "LG 24MP59G", "size": "1920×1080", "focused": False}]
            self.primary = None
            self.mon_checks = {}
            if mons:
                box = Gtk.Box()
                box.add_css_class("dg-panel")
                self.smap = glass.ScreensMap(self.c, mons, 150 if self.screen_h() < 760 else 190)
                self.smap.set_margin_top(10)
                self.smap.set_margin_bottom(4)
                self.smap.set_margin_start(10)
                self.smap.set_margin_end(10)
                hint(self.smap, "Your screens, side by side: click one to make it the main screen (the lit one)")
                self.smap.on_pick = lambda name: self.mon_checks[name].set_active(True)
                box.append(self.smap)
                page.append(box)
            g = self.group(page, "Main screen")
            first = None
            if not mons:
                r = Adw.ActionRow(title="This computer's screen",
                                  subtitle="The panels and the live background are on it. Arrange and sizes… sets its size.")
                r.add_prefix(glass.icon("video-display-symbolic", 20, "dg-row-icon"))
                g.add(r)
            for m in mons:
                r = Adw.ActionRow(title=GLib.markup_escape_text(m["desc"]), subtitle=f"{m['name']} · {m['size']}")
                chk = Gtk.CheckButton(valign=Gtk.Align.CENTER, active=m["focused"])
                if m["focused"]:
                    self.primary = m["name"]
                if first:
                    chk.set_group(first)
                first = first or chk

                def chose(b, n=m["name"]):
                    if b.get_active():
                        self.primary = n
                        if getattr(self, "smap", None):
                            self.smap.pick(n)
                chk.connect("toggled", chose)
                r.add_prefix(chk)
                r.add_prefix(glass.icon("video-display-symbolic", 20, "dg-row-icon"))
                r.set_activatable_widget(chk)
                hint(r, f"Make {m['desc']} the main screen")
                g.add(r)
                self.mon_checks[m["name"]] = chk
            more = hint(Gtk.Button(label="Arrange and sizes…", halign=Gtk.Align.START), "Open Settings › Displays")
            more.connect("clicked", lambda *_: subprocess.Popen(["bromigos", "settings", "displays"], start_new_session=True))
            page.append(more)


        def build_world(self, page):
            import bromigos_themecards as TC
            kit = TC.CardKit(Gtk, Pango, still=self.still(), verb="Click")
            tight = self.screen_h() < 760
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE, homogeneous=True, max_children_per_line=4,
                               min_children_per_line=2, row_spacing=12, column_spacing=12)
            self.world = None
            try:
                entries = TC.installed()
            except Exception:
                entries = []
            css = Gtk.CssProvider()
            c = TC.WICK
            css.load_from_string(TC.card_css(c))
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            # the Hero: the world chosen (or the one under the pointer) large, its name over it
            hero = None
            if not tight and entries:
                hero = Gtk.Overlay()
                hero.add_css_class("dg-hero")
                pic = Gtk.Picture()
                pic.set_content_fit(Gtk.ContentFit.COVER)
                pic.set_can_shrink(True)
                pic.set_size_request(-1, 250)
                hero.set_child(pic)
                cap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.END, halign=Gtk.Align.START)
                cap.add_css_class("dg-hero-cap")
                hname = lab("", "dg-hero-name", wrap=False)
                htag = lab("", "dg-hero-tag", wrap=False)
                cap.append(hname)
                cap.append(htag)
                hero.add_overlay(cap)
                page.append(hero)

                def show(e):
                    if e is None:
                        return
                    if e.preview and os.path.exists(e.preview):
                        pic.set_filename(e.preview)
                    else:
                        pic.set_paintable(None)
                    hname.set_label(e.display.upper() + ("  ·  IN USE" if e.current else ""))
                    htag.set_label(e.desc or e.tagline())
                    hint(hero, f"{e.display}: {e.desc}" if e.desc else e.display)
                self.world_show = show
            chosen = lambda: next((ch.entry for ch in flow.get_selected_children()), None)  # noqa: E731
            w, h = (200, 112) if not tight else (190, 104)
            for e in entries:
                card = kit.card(e, w, h, on_hover=(lambda e_: self.world_show(e_)) if hero else None,
                                on_leave=(lambda: self.world_show(chosen())) if hero else None)
                flow.append(card)
                if e.current:
                    flow.select_child(card)
            missing = [e.name for e in entries if not getattr(e, "fresh", True)]
            if missing and not self.render:
                TC.render_background(missing)          # drawn offscreen, as the theme switcher does
            flow.connect("child-activated", lambda f, ch: setattr(self, "world", ch.entry.name))

            def picked(f):
                e = chosen()
                self.world = e.name if e else None
                if hero:
                    self.world_show(e)
            flow.connect("selected-children-changed", picked)
            if hero:
                self.world_show(chosen() or entries[0])
            if not entries:
                page.append(lab("No themes found. bromigos-core brings them; Settings › Theme lists them once they're in.", "bw-intro"))
            hint(flow, "The themes: click one to wear it; the picture above shows the one under the pointer")
            page.append(flow)
            if self.render:                            # the renders: the top of the page, where the Hero is
                GLib.idle_add(lambda: (self.scroll.get_vadjustment().set_value(0), False)[1])


        # ── long steps: their lines shown on the page as they come ─────────────────
        def progress(self, page):
            self.prog = lab("", "bw-intro")
            self.prog.set_selectable(True)
            page.append(self.prog)

        def say(self, line):
            GLib.idle_add(lambda: (getattr(self, "prog", None) and self.prog.set_label(line[-220:]), False)[1])

        def build_vector(self, page):
            hw = {} if self.render else F.hardware()
            vram = 12.0 if self.render else F.gpu_vram_gib(hw)
            self.model = None if self.render else F.local_model(vram)
            if self.render:
                self.model = {"name": "Qwen3.6-35B-A3B", "disk_gib": 20.6, "pull": "hf.co/…", "speed": "~34 tok/s"}
            have_lab = [] if self.render else F.lab_brains()
            self.brains = [("lab", "Your lab", (f"Already connected: {have_lab[0]['name']}" if have_lab else
                                                 "Found and connected on the next step"))]
            if self.model:
                self.brains.append(("local", "This computer",
                                    f"{self.model['name']}, {self.model['disk_gib']:.0f} GB to download "
                                    f"({self.model.get('speed') or ''}). Your lab, when you have one, is the better place."))
            self.brains += [("service", "A service", "Any OpenAI-compatible server you name, with its key in a file."),
                            ("none", "Not now", "VECTOR waits for a brain. Settings › VECTOR gives him one later.")]
            tight = self.screen_h() < 760
            page.append(lab("HIS BRAIN", "bw-group-title", wrap=False))
            page.append(lab("Where VECTOR thinks. Nothing leaves this computer unless you choose a service.", "bw-intro"))
            self.brain_pick = getattr(self, "brain_pick", self.brains[0][0])
            look = {"lab": ("rack", "network-workgroup-symbolic"), "local": ("tower", "computer-symbolic"),
                    "service": ("cloud", "network-server-symbolic"), "none": ("pause", "media-playback-pause-symbolic")}
            wide = (self.get_width() or 1280) - 232 - 48 >= 820
            grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
            grid.update_property([Gtk.AccessibleProperty.LABEL], ["Where VECTOR's brain runs"])
            first = None
            for i, (key, title, sub) in enumerate(self.brains):
                kind, ic = look[key]
                card = glass.glyph_card(kind, self.c, ic, title, [sub], key == self.brain_pick, first,
                                        still=self.still(), size=64 if tight else 84)
                first = first or card
                card.connect("toggled", lambda b, k=key: b.get_active() and self._brain(k))
                hint(card, f"{title}: {sub}")
                cols = len(self.brains) if wide else 2
                grid.attach(card, i % cols, i // cols, 1, 1)
            page.append(grid)
            self.svc = self.group(page, "The service")
            self.base = Adw.EntryRow(title="Its address (…/v1)")
            self.model_row = Adw.EntryRow(title="Model (blank: VECTOR's default)")
            self.keyfile = Adw.EntryRow(title="A file holding its API key (blank: none)")
            for w, t in ((self.base, "The server's OpenAI-compatible address, ending in /v1"),
                         (self.model_row, "Which model he uses"), (self.keyfile, "The key stays in that file; it's never copied")):
                hint(w, t)
                self.svc.add(w)
            self._brain(self.brain_pick)
            page.append(lab("HIS VOICE", "bw-group-title", wrap=False))
            page.append(lab("A voice is downloaded once, then works without the internet.", "bw-intro"))
            self.voice_pick = getattr(self, "voice_pick", 0)
            voices = Gtk.Box(spacing=12, homogeneous=True)
            voices.update_property([Gtk.AccessibleProperty.LABEL], ["VECTOR's voice"])
            first = None
            for i, (ic, title, sub, tip) in enumerate((
                    ("audio-volume-muted-symbolic", "Off", "He writes, he doesn't speak.", "Off needs nothing"),
                    ("audio-speakers-symbolic", "Kokoro", "On the processor. Downloads its model.", "Kokoro runs on any computer"),
                    ("audio-card-symbolic", "The designed voice", "On the graphics card. Downloads its model.",
                     "The designed voice needs an NVIDIA or AMD card"))):
                card = glass.holo_card(None, ic, title, [sub], i == self.voice_pick, first)
                first = first or card
                card.connect("toggled", lambda b, n=i: b.get_active() and setattr(self, "voice_pick", n))
                hint(card, f"{title}: {sub} {tip}.")
                voices.append(card)
            page.append(voices)
            self.hello_card = lab("", "bw-key")
            page.append(self.hello_card)
            self.progress(page)


        def _brain(self, key):
            self.brain_pick = key
            self.svc.set_visible(key == "service")

        def build_lab(self, page):
            tight = self.screen_h() < 760
            top = Gtk.Box(spacing=22)
            self.radar = glass.LabRadar(self.c, 200 if tight else 260, still=self.still())
            self.radar.set_valign(Gtk.Align.START)
            hint(self.radar, "The lab radar: it sweeps while it looks; each dot is a machine found. Click one to see it.")
            self.radar.on_pick = lambda i: self.lab_checks[i].set_active(True) if i < len(self.lab_checks) else None
            top.append(self.radar)
            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, hexpand=True)
            g = Adw.PreferencesGroup(title="FIND YOUR LAB")
            g.set_description("It reads what this computer already knows of your network (it never scans), checks those "
                              "devices, and changes nothing until you press Connect.")
            right.append(g)
            self.lab_list = g
            self.lab_rows, self.lab_checks = [], []
            b = hint(Gtk.Button(label="Look for it", halign=Gtk.Align.START), "Find the lab's machines and what they offer")
            b.connect("clicked", lambda *_: self.find_lab())
            right.append(b)
            top.append(right)
            page.append(top)
            g2 = self.group(page, "Other ways")
            fr = Adw.ActionRow(title="I have a lab connection file",
                               subtitle="A homelab.toml, or the lab connection on a Field Kit USB stick.")
            fr.add_prefix(glass.icon("document-open-symbolic", 20, "dg-row-icon"))
            fb = hint(Gtk.Button(label="Choose…", valign=Gtk.Align.CENTER), "Pick the file")
            fb.connect("clicked", lambda *_: self.pick_lab_file())
            fr.add_suffix(fb)
            hint(fr, "bromigos setup homelab --homelab FILE")
            g2.add(fr)
            if self.render or F.gpu_vram_gib() >= 8:
                mr = Adw.ActionRow(title="Make this computer my lab",
                                   subtitle="Its graphics card runs models for your other devices. Shows bromigos-lab's "
                                            "reviewed plan first; nothing changes until you agree.")
                mr.set_subtitle_lines(0)
                mr.add_prefix(glass.icon("computer-symbolic", 20, "dg-row-icon"))
                mb = hint(Gtk.Button(label="Show the plan", valign=Gtk.Align.CENTER), "bromigos lab provision plan: read-only")
                mb.connect("clicked", lambda *_: self.lab_plan())
                mr.add_suffix(mb)
                hint(mr, "Turn this computer into the lab: bromigos-lab's provisioning, reviewed first")
                g2.add(mr)
            self.progress(page)
            if self.render:
                self._lab_found({"hosts": [{"name": "gpu-box", "address": "192.0.2.24",
                                            "offers": ["Ollama", "LiteLLM", "Prometheus"]},
                                           {"name": "nas", "address": "192.0.2.10", "offers": ["Docker", "Jellyfin"]},
                                           {"name": "pi-hole", "address": "192.0.2.53", "offers": ["DNS"]}],
                                 "brains": [{"name": "litellm", "url": "http://192.0.2.24:4000/v1"}], "error": None, "new": 6})


        def find_lab(self):
            self.say("Looking at the devices this computer already knows…")
            self.radar.set_searching(True)
            self.later(lambda: (self._lab_found, F.find_lab()))


        def _lab_found(self, r):
            self.radar.set_searching(False)
            if r.get("error"):
                self.say(r["error"])
                return False
            if not r["hosts"]:
                self.say("No lab found. If you have one, use its connection file, or connect it later in Settings › Lab.")
                return False
            for row in self.lab_rows:                   # looked again: the new answer replaces the old
                self.lab_list.remove(row)
            self.lab_rows, self.lab_checks = [], []
            self.radar.set_hosts(r["hosts"])
            first = None
            for i, h in enumerate(r["hosts"]):
                row = Adw.ActionRow(title=GLib.markup_escape_text(h["name"] or "?"),
                                    subtitle=GLib.markup_escape_text(", ".join(h["offers"])))
                chk = Gtk.CheckButton(valign=Gtk.Align.CENTER, active=i == 0)
                if first:
                    chk.set_group(first)
                first = first or chk
                chk.connect("toggled", lambda b, n=i: b.get_active() and self.radar.pick(n))
                row.add_prefix(chk)
                row.add_prefix(glass.icon("network-server-symbolic", 18, "dg-row-icon"))
                row.set_activatable_widget(chk)
                hint(row, f"{h['name']}: what it offers. Picking it marks it on the radar.")
                self.lab_list.add(row)
                self.lab_rows.append(row)
                self.lab_checks.append(chk)
            c = Adw.ActionRow(title=f"Connect it ({r.get('new', 0)} services)",
                              subtitle="Adds them to your homelab settings. Your own edits there are never rewritten.")
            c.set_subtitle_lines(0)
            cb = hint(Gtk.Button(label="Connect", valign=Gtk.Align.CENTER), "Connect this lab to this computer")
            cb.add_css_class("suggested-action")
            cb.connect("clicked", lambda *_: self.connect_lab(r))
            c.add_suffix(cb)
            self.lab_list.add(c)
            self.lab_rows.append(c)
            self.say(f"Found {len(r['hosts'])} machine{'s' if len(r['hosts']) != 1 else ''} offering services.")
            return False


        def connect_lab(self, r):
            def work():
                ok, why = (True, "") if self.render else F.connect_lab()
                if ok:
                    self.done_steps["lab"] = "Your lab is connected"
                    brains = r.get("brains") or ([] if self.render else F.lab_brains())
                    if self.brain_pick == "lab" and brains:
                        code, out, err = F.set_brain("lab", url=brains[0]["url"])
                        if code == 0:
                            ok2, words = F.hello()
                            return (self.say, ("VECTOR: " + words) if ok2 else words)
                return (self.say, "Connected." if ok else why)
            self.say("Connecting…")
            self.later(work)

        def pick_lab_file(self):
            dlg = Gtk.FileDialog(title="Your lab connection")

            def done(d, res):
                try:
                    f = d.open_finish(res)
                except GLib.Error:
                    return
                ok, why = F.use_lab_file(f.get_path())
                self.say("Your lab is connected." if ok else why)
                if ok:
                    self.done_steps["lab"] = "Your lab is connected (from a file)"
            dlg.open(self, None, done)

        def lab_plan(self):
            self.say("Asking bromigos-lab for its plan…")

            def work():
                ok, text = F.provision_plan()
                return (self.say, ("The plan (nothing has changed):\n" + text[-1800:]) if ok else
                        "The plan couldn't be made: " + F.plain_error(text) + ". Settings › Lab can do it later.")
            self.later(work)

        def build_phone(self, page):
            # laid out so the pairing QR, its code and the live status are all on screen without
            # scrolling, down to 1024×600: the store as one compact row, the QR beside its steps
            gp = Adw.ActionRow(title="Get BRODEC on your phone: Google Play",
                               subtitle="Scan this with your phone's camera. iPhone: coming soon.")
            gp.set_subtitle_lines(0)
            short = self.screen_h() < 760
            pic = self.qr_picture(F.PLAY_STORE, 52 if short else 72)
            if pic:
                gp.add_suffix(pic)
            hint(gp, "Scan with your phone's camera to open BRODEC on Google Play (" + F.PLAY_STORE + ")")
            store = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            store.add_css_class("boxed-list")
            store.append(gp)
            page.append(store)
            self.pair_view = self.pair_card(page, "Pair this computer")
            v = self.pair_view
            if self.render:
                self.start_pairing()
            elif not F.machine_installed():
                v.status.set_label("Pairing needs BRODEC's helper (brodec-machine). It runs only what your phone signs, "
                                   "and STOP ALL halts it.")
                self.action(v, "Install it", "Install BRODEC's helper, the usual package way (asks for your password)",
                            self.install_machine)
            elif not F.machine_config_ready():
                v.status.set_label("BRODEC's helper starts once this computer allows it (a settings file only the "
                                   "system can write).")
                self.action(v, "Allow pairing", "Let BRODEC's helper run here (asks for your password)", self.allow_machine)
            else:
                self.start_pairing()
            if not self.render and F.lab_bridge_available():
                self.bridge_view = self.pair_card(page, "Your lab's VECTOR bridge")
                self.bridge_view.status.set_label("This computer runs your lab's bridge to VECTOR. Pair it too and your "
                                                  "phone talks to the lab's VECTOR.")
                self.action(self.bridge_view, "Pair it", "Show the lab bridge's pairing code (asks for your password)",
                            self.start_bridge)
            if not short:                    # on a short screen the intro above says it
                page.append(lab("Then your phone can: " + "; ".join(c[0].lower() + c[1:] if not c.startswith("VECTOR")
                                                                    else c for c in F.PHONE_CAN) + ".", "bw-intro"))
            self.progress(page)

        def screen_h(self):
            """The window's height, or (before it has one) its monitor's: how much fits."""
            h = self.get_height()
            if h:
                return h
            try:
                mons = Gdk.Display.get_default().get_monitors()
                return min(mons.get_item(i).get_geometry().height for i in range(mons.get_n_items())) or 800
            except Exception:
                return 800

        def pair_card(self, page, title):
            """A pairing, as one card: the QR on the left; on the right the steps, the code to type,
            the live status and its buttons."""
            from types import SimpleNamespace
            size = 210 if self.screen_h() >= 760 else 165
            page.append(lab(title.upper(), "bw-group-title", wrap=False))
            card = Gtk.Box(spacing=22)
            card.add_css_class("bw-card")
            qr = glass.PhoneFrame(self.c, int(size * 0.92), still=bool(self.render) or reduced())
            qr.set_valign(Gtk.Align.START)
            qr.add_css_class("bw-qr-slot")
            card.append(qr)
            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, hexpand=True)
            steps = [lab("1. In BRODEC: LAB › MACHINES › ADD MACHINE", "bw-intro"), lab("2. Scan the code, or type it:", "bw-intro")]
            for w in steps:
                right.append(w)
            code = lab("—", "bw-code", wrap=False)
            hint(code, "The pairing code to type in BRODEC, if you'd rather not scan")
            right.append(code)
            status = lab("Waiting for the pairing code…", "bw-status")
            hint(status, "What the pairing is doing now. It ticks when your phone confirms.")
            right.append(status)
            actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            right.append(actions)
            card.append(right)
            page.append(card)
            return SimpleNamespace(qr=qr, size=size, code=code, status=status, actions=actions, steps=steps)

        def action(self, view, label, tip, fn):
            self._clear(view.actions)
            b = hint(Gtk.Button(label=label, halign=Gtk.Align.START), tip)
            b.connect("clicked", lambda *_: fn())
            view.actions.append(b)
            return b

        def qr_file(self, text, svg=None):
            """The QR as a file: the agent's own SVG, else qrencode's PNG."""
            import tempfile
            d = tempfile.mkdtemp(prefix="bw-qr-")
            if svg:
                path = os.path.join(d, "qr.svg")
                with open(path, "w") as f:
                    f.write(svg)
                return path
            path = os.path.join(d, "qr.png")
            return path if F.qr_png(text, path) else None

        def qr_picture(self, text, size, svg=None):
            """The QR at exactly `size` pixels (a Gtk.Image keeps to its pixel size, a Picture
            grows to its file's)."""
            path = self.qr_file(text, svg)
            if not path:
                return None
            im = Gtk.Image.new_from_file(path)
            im.set_pixel_size(size)
            im.add_css_class("bw-qr")
            return im

        def install_machine(self):
            def work():
                ok, why = F.machine_install(self.say)
                if ok:
                    return (lambda: (self.show_step("phone"), False)[1],)
                return (self.say, why)
            self.say("Installing BRODEC's helper (a password window opens)…")
            self.later(work)

        def allow_machine(self):
            def work():
                ok, why = F.machine_config(self.say)
                if ok:
                    return (lambda: (self.show_step("phone"), False)[1],)
                return (self.say, why)
            self.say("Allowing pairing (a password window opens)…")
            self.later(work)

        def stop_pairing(self):
            for k in ("pairing", "bridge_pairing"):
                if getattr(self, k, None):
                    getattr(self, k).cancel()
                    setattr(self, k, None)

        def _clear(self, box):
            while (ch := box.get_first_child()):
                box.remove(ch)

        def start_pairing(self):
            v = self.pair_view
            v.qr.set_qr(None)
            self._clear(v.actions)
            v.code.set_label("—")
            v.status.set_label("Waiting for the pairing code…")
            if self.render:
                self._show_code({"event": "code", "qr": "https://accounts.bromigos.org/device#machine=k1.example&n=desk",
                                 "user_code_display": "KPGG-ZFVT"}, v)
                v.status.set_label("● Waiting for your phone to confirm…")
                return False
            self.pairing = F.Pairing(F.machine_pair_argv(), lambda ev: GLib.idle_add(self._pair_event, ev, v, False))
            return False

        def start_bridge(self):
            v = self.bridge_view
            self._clear(v.actions)
            v.status.set_label("Waiting for the bridge's code (a password window opens)…")
            self.bridge_pairing = F.Pairing(F.lab_pair_argv(gui=True), lambda ev: GLib.idle_add(self._pair_event, ev, v, True))

        def _show_code(self, ev, v):
            v.qr.set_qr(self.qr_file(ev.get("qr", ""), ev.get("qr_svg")))
            hint(v.qr, "Scan this in BRODEC: LAB › MACHINES › ADD MACHINE")
            v.code.set_label(ev.get("user_code_display") or ev.get("user_code", ""))

        def _pair_event(self, ev, v, bridge):
            e = ev.get("event")
            if e == "code":
                self._show_code(ev, v)
                v.status.set_label("● Waiting for your phone to confirm…")
            elif e == "paired":
                v.qr.set_state("paired")
                v.code.set_label("Paired")
                for w in v.steps:                  # done with: room for what comes next
                    w.set_visible(False)
                who = ev.get("owner") or "your phone"
                v.status.set_label(f"✓ {'The bridge is paired' if bridge else 'This computer is paired'} with {who}")
                if bridge:
                    self.done_steps["bridge"] = "Your lab's bridge is paired"
                else:
                    self.done_steps["phone"] = "Your phone is paired"
                    self.offer_enroll()
            else:
                v.status.set_label(F.pairing_words(ev) or v.status.get_label())
                if e in ("failed", "cancelled") and self.step == "phone":
                    if not bridge and ev.get("code") == "no_capability_file":
                        self.action(v, "Allow pairing", "Let BRODEC's helper run here (asks for your password)",
                                    self.allow_machine)
                    else:
                        self.action(v, "Try again", "Show a pairing code again",
                                    self.start_bridge if bridge else self.start_pairing)
            return False

        def offer_enroll(self):
            """After pairing: the phone may also run jobs and controls here, once the owner allows
            it at this computer (brodec-machine enroll, through root)."""
            v = self.pair_view
            self._clear(v.actions)
            v.actions.append(lab("To restart, update and open terminals from your phone too: in BRODEC, LAB › MACHINES › "
                                 "this computer › ALLOW THIS PHONE, then Allow here. It shows the phone's key to compare.",
                                 "bw-intro"))
            self.enroll_button = self.action_append(v, "Allow…", "Allow the phone that asked (asks for your password)",
                                                    self.enroll)
            self.enroll_note = lab("", "bw-intro")
            v.actions.append(self.enroll_note)

        def action_append(self, view, label, tip, fn):
            b = hint(Gtk.Button(label=label, halign=Gtk.Align.START), tip)
            b.connect("clicked", lambda *_: fn())
            view.actions.append(b)
            return b

        def enroll(self):
            import threading

            def ask(text):
                answer = {}
                ev = threading.Event()

                def dialog():
                    d = Adw.AlertDialog(heading="Allow this phone?", body=text)
                    d.add_response("no", "Not now")
                    d.add_response("yes", "Allow")
                    d.set_response_appearance("yes", Adw.ResponseAppearance.SUGGESTED)
                    d.set_default_response("no")
                    d.connect("response", lambda _d, r: (answer.update(yes=(r == "yes")), ev.set()))
                    d.present(self)
                    return False
                GLib.idle_add(dialog)
                ev.wait()
                return answer.get("yes", False)

            def done(ok, words):
                GLib.idle_add(lambda: (self.enroll_note.set_label(("✓ " if ok and "now send" in words else "") + words), False)[1])
                if ok and "now send" in words:
                    self.done_steps["enroll"] = "Your phone may run things here"
            self.enroll_note.set_label("A password window opens…")
            F.Enroll(ask, done, user=os.environ.get("USER"))

        def build_keys(self, page):
            grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3, min_children_per_line=2,
                               homogeneous=True, row_spacing=12, column_spacing=12)
            self.cards = []
            for keys, what, cls in KEY_TOUR:
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
                box.add_css_class("dg-keycard")
                top = Gtk.Box(spacing=10)
                top.append(glass.keycaps(keys))
                sp = Gtk.Box(hexpand=True)
                top.append(sp)
                top.append(glass.icon(KEY_ICONS.get(keys, "input-keyboard-symbolic"), 22, "dg-keycard-icon"))
                box.append(top)
                box.append(lab(what, "bw-intro"))
                state = lab("Try it" if cls else "", "dg-keycard-state")
                box.append(state)
                hint(box, f"{keys}: {what}")
                grid.append(box)
                ch = box.get_parent()
                if ch:
                    ch.set_focusable(False)
                self.cards.append((box, state, cls))
            page.append(grid)
            page.append(lab("Every shortcut is in Settings › Shortcuts, and Super + K shows them on the desktop.", "bw-intro"))
            if self.render:                            # the renders: one tried, as it looks when it works
                self.cards[0][0].add_css_class("lit")
                self.cards[0][1].set_label("✓ That's it")
            else:
                self.seen = {c["class"] for c in self.clients()}
                GLib.timeout_add(500, self.watch_keys)


        def clients(self):
            code, out, _ = run(["hyprctl", "clients", "-j"], timeout=3)
            try:
                return json.loads(out)
            except ValueError:
                return []

        def watch_keys(self):
            if self.step != "keys":
                return False
            now = {c["class"] for c in self.clients()}
            code, out, _ = run(["hyprctl", "layers", "-j"], timeout=3)
            if "rofi" in out.lower():
                now.add("Rofi")
            for box, state, cls in self.cards:
                if cls and cls in now and not box.has_css_class("lit"):
                    box.add_css_class("lit")
                    state.set_label("✓ That's it")
            return True

        def build_done(self, page):
            head = page.get_first_child()
            intro = head.get_next_sibling()
            page.remove(head)
            page.remove(intro)
            hero = Gtk.Box(spacing=24)
            burn = glass.BurnIn(self.c, 120 if self.screen_h() < 760 else 150, still=self.still())
            hint(burn, "bromigOS's emblem")
            burn.set_valign(Gtk.Align.CENTER)
            hero.append(burn)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, valign=Gtk.Align.CENTER, hexpand=True)
            col.append(head)
            col.append(intro)
            hero.append(col)
            page.append(hero)
            chose = dict(self.done_steps)
            if self.render and not chose:
                chose = SAMPLE_CHOSE
            rows = []
            for k, v in chose.items():
                st = STEP[k if k in STEP else "phone"]          # the bridge and allowing: the phone step's
                rows.append((glass.STEP_ICONS.get(st[0], "object-select-symbolic"), st[1], v,
                             st[0] if st[0] in self.steps else None, False))
            if rows:
                page.append(glass.briefing("What you chose", rows, self.show_step,
                                           lambda k, t: f"Go back to {k} to change it"))
            else:
                g = self.group(page, "What you chose")
                g.add(Adw.ActionRow(title="Nothing changed: everything stays as it was installed"))


        # ── moving on ──────────────────────────────────────────────────────────────
        def go(self, d):
            if d < 0 and self.voice:
                self.voice.stop()               # back quiets him: the step before isn't read again
                self.spoken = self.steps[max(0, self.steps.index(self.step) + d)]
            i = self.steps.index(self.step) + d
            if i >= len(self.steps):
                return self.finish()
            self.show_step(self.steps[max(0, i)])

        def apply_and_go(self):
            s = self.step
            if s == "done":
                return self.finish()
            self.next.set_sensitive(False)
            self.msg.set_label("Setting it up…")

            def work():
                ok, said = self.apply(s)
                return (self._applied, s, ok, said)
            self.later(work)

        def _applied(self, s, ok, said):
            self.next.set_sensitive(True)
            if ok == "stay":                       # VECTOR said hello: read it, then Continue
                threading.Thread(target=self.find_brain, daemon=True).start()
                self.msg.set_label(said)
                return False
            if ok:
                if said:
                    self.done_steps[s] = said
                if s == "vector" and not self.render:     # a brain chosen: look for it again (Ask VECTOR, his hello)
                    threading.Thread(target=self.find_brain, daemon=True).start()
                self.go(1)
            else:
                self.msg.set_label("▲ " + said)
            return False

        def apply(self, s):
            if self.render:
                return True, "rendered"
            if s == "network":
                if not getattr(self, "wifi_choice", None):
                    return True, None
                pw = self.wifi_pw.get_text()
                argv = ["nmcli", "dev", "wifi", "connect", self.wifi_choice] + (["password", pw] if pw else [])
                code, out, err = run(argv, timeout=60)
                return (True, f"Connected to {self.wifi_choice}") if code == 0 else \
                    (False, f"Couldn't join {self.wifi_choice}: " + ("check the password." if "password" in (err + out).lower() else (err or out).strip()[-160:]))
            if s == "screens":
                if not self.primary:
                    return True, None
                code, out, err = setup("monitors", "--monitors", "auto", "--primary", self.primary)
                return (code == 0, f"Main screen: {self.primary}" if code == 0 else "The screens couldn't be set: " + (err or out).strip()[-200:])
            if s == "world":
                if not self.world:
                    return True, None
                code, out, err = setup("theme", "--theme", self.world)
                return (code == 0, f"World: {self.world}" if code == 0 else "The world couldn't be put on: " + (err or out).strip()[-200:])
            if s == "vector":
                if getattr(self, "hello_done", False):
                    return True, self.done_steps.get("vector")
                pick, said = self.brain_pick, ""
                if pick == "local":
                    ok, why = F.install_local_brain(self.model, self.say)
                    if not ok:
                        return False, why
                    said = f"Brain: this computer ({self.model['name']})"
                elif pick == "service":
                    if not self.base.get_text().strip():
                        return False, "Type the service's address, or choose another place for his brain."
                    code, out, err = F.set_brain("service", url=self.base.get_text().strip(),
                                                 key_file=self.keyfile.get_text().strip() or None,
                                                 model=self.model_row.get_text().strip() or None)
                    if code != 0:
                        return False, "VECTOR's brain couldn't be set: " + F.plain_error(err or out)
                    said = "Brain: " + self.base.get_text().strip()
                elif pick == "none":
                    F.set_brain("none")
                    said = "No brain yet"
                else:
                    said = "Brain: your lab (connected on the next step)"
                v = ["off", "cpu", "gpu"][getattr(self, "voice_pick", 0)]
                ok, why = F.voice(v, self.say)
                if not ok:
                    return False, why
                said += ", " + {"off": "voice off", "cpu": "voice: Kokoro", "gpu": "the designed voice"}[v]
                if pick in ("local", "service"):
                    ok, words = F.hello()
                    if not ok:
                        return False, words
                    self.hello_done = True
                    self.done_steps["vector"] = said
                    GLib.idle_add(lambda: (self.hello_card.set_label("VECTOR: " + words), False)[1])
                    return "stay", "VECTOR says hello. Continue when you're ready."
                return True, said
            return True, None

        def finish(self):
            self.stop_pairing()
            if self.voice:
                self.voice.stop()
            os.makedirs(STATE, exist_ok=True)
            try:
                os.unlink(PENDING)
            except OSError:
                pass
            json.dump({"done": True, "chose": self.done_steps}, open(DONE, "w"))
            self.get_application().quit()

    class App(Adw.Application):
        def __init__(self, start, render):
            super().__init__(application_id="org.bromigos.Welcome")
            self.start, self.render = start, render

        def do_activate(self):
            w = self.get_active_window() or Win(self, self.start, self.render)
            if self.render:
                GLib.timeout_add(800, render_all, w, self.render)
            else:
                w.fullscreen()
                # tests: BROMIGOS_WELCOME_SNAPS="SECONDS:PATH,…" draws the live window to each PATH
                for item in filter(None, os.environ.get("BROMIGOS_WELCOME_SNAPS", "").split(",")):
                    secs, _, path = item.partition(":")
                    GLib.timeout_add(int(float(secs) * 1000), lambda p=path: (snap(w, p), False)[1])
            w.present()

    def snap(win, path):
        paint = Gtk.WidgetPaintable.new(win)
        sn = Gtk.Snapshot()
        paint.snapshot(sn, win.get_width(), win.get_height())
        node = sn.to_node()
        if node:
            win.get_renderer().render_texture(node, None).save_to_png(path)
            print("rendered", path, flush=True)

    def render_all(w, out):
        os.makedirs(out, exist_ok=True)
        todo = list(w.steps)

        if "lab" in todo and w.brain:          # the lab step again, scrolled to its Ask VECTOR box
            todo.insert(todo.index("lab") + 1, "lab-ask")

        def one():
            if not todo:
                w.get_application().quit()
                return False
            s = todo.pop(0)
            if s == "lab-ask":
                w.show_step("lab")
                GLib.timeout_add(300, lambda: (w.scroll.get_vadjustment().set_value(w.scroll.get_vadjustment().get_upper()),
                                               False)[1])
            else:
                w.show_step(s)
            GLib.timeout_add(700, lambda: (snap(w, os.path.join(out, f"welcome-{s}.png")), False)[1])
            return True

        GLib.timeout_add(1200, one)
        return False

    start = argv[argv.index("--step") + 1] if "--step" in argv else "network"
    return App(start, render_dir).run([])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
