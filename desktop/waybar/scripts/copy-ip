#!/bin/sh
# Copy the default route's IPv4 address to the clipboard (the bar never shows it).
ifc=$(ip route show default | awk '{print $5; exit}')
ip=$(ip -4 -o addr show dev "$ifc" | awk '{print $4}' | cut -d/ -f1 | head -1)
[ -n "$ip" ] || { notify-send -a NETWORK -u normal "No address" "No IPv4 on the default route."; exit 1; }
printf '%s' "$ip" | wl-copy
notify-send -a NETWORK "Address copied" "$ifc address is on the clipboard."
