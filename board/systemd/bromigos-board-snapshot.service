# The Lab board's reader (docs/board.md): runs the commands that already say the server's state
# with --json (bromigos server status, storage health, lab backups status, activity list, alerts,
# lab apps list) as root, and writes what they said to /run/bromigos-board/board.json for the
# board's group. Started by bromigos-board-snapshot.path; it ends itself when nobody looks.
[Unit]
Description=bromigOS Lab board: read the server
Documentation=file:///usr/share/doc/bromigos-board/board.md

[Service]
Type=simple
ExecStart=/usr/lib/bromigos/board/bromigos-board snapshot
Nice=10
IOSchedulingClass=idle
UMask=0027
# it is root, to read what those commands read, and no more than they need: /usr, /boot and /etc
# read-only, the home folders read-only, a /tmp of its own, no new privileges. Its commands
# write under /run and /var/lib (the apps' measured sizes, podman's own state), so those stay.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
