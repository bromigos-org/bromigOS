# The Lab board's API (docs/board.md): Starlette on uvicorn, on the socket systemd hands it, as
# its own unprivileged user. It reads the snapshot root writes, keeps sessions, and never runs a
# command itself.
[Unit]
Description=bromigOS Lab board API
Documentation=file:///usr/share/doc/bromigos-board/board.md
Requires=bromigos-board.socket
After=bromigos-board.socket

[Service]
Type=simple
ExecStart=/usr/lib/bromigos/board/bromigos-board serve
User=bromigos-board
Group=bromigos-board
Restart=on-failure
RestartSec=5
UMask=0077
# what it may use of the machine: a household's page needs little
MemoryMax=256M
TasksMax=128
# read-only everything, but what it writes: its own sessions and codes, and the two files it
# marks to ask root's reader for a reading (tmpfiles made them; the folder they're in is root's)
ProtectSystem=strict
# /run too, said outright: on some systemd versions (seen on 255) ProtectSystem=strict leaves
# /run writable once ProtectProc= or ProtectKernelTunables= is set
ReadOnlyPaths=/run
ReadWritePaths=/var/lib/bromigos-board /run/bromigos-board/wanted /run/bromigos-board/door
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
# other users' processes, root's reader among them, aren't there for it to look at.
# (ProcSubset=pid is left out: the activity records it lists read /proc/sys for the boot's id)
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# the socket comes from systemd; it opens none of its own
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
