# The Lab board (docs/board.md). Two users work here, and root never writes where the board's
# user can:
#
# /run/bromigos-board is root's; the board's user (the API) only reads it. Root's reader writes
# board.json there (group bromigos-board, 0640). `wanted` and `door` are made here, by root: the
# API marks them (it can't make a file in this folder) to ask the reader for readings.
d /run/bromigos-board 0750 root bromigos-board -
f /run/bromigos-board/wanted 0660 root bromigos-board -
f /run/bromigos-board/door 0660 root bromigos-board -
# Actions: the API puts a request in `requests`, its own folder; root's helper takes it out and
# leaves its answer in `results`, root's. Each side writes one folder and only reads the other.
d /run/bromigos-board/requests 0750 bromigos-board bromigos-board -
d /run/bromigos-board/results 0750 root bromigos-board -
# /var/lib/bromigos-board is the board's user's own: sessions and sign-in codes. Root works in
# it only after it has become that user (bromigos server board code, sessions).
d /var/lib/bromigos-board 0700 bromigos-board bromigos-board -
d /var/lib/bromigos-board/sessions 0700 bromigos-board bromigos-board -
d /var/lib/bromigos-board/codes 0700 bromigos-board bromigos-board -
# Root's own note of each sign-in code it made, which the board's user can't read or write:
# only a code noted here can approve deleting an app's data.
d /var/lib/bromigos-board-root 0700 root root -
d /var/lib/bromigos-board-root/codes 0700 root root -
